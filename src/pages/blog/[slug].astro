---
import Layout from "../../layouts/Layout.astro";
import ReadingProgress from "../../components/blog/ReadingProgress.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import RelatedPosts from "../../components/blog/RelatedPosts.astro";
import PostNavigation from "../../components/blog/PostNavigation.astro";
import {
  getPublishedPosts,
  getPostReadingTime,
  getPostReadingTimeMinutes,
  getWordCount,
  getRelatedPosts,
  getAdjacentPosts,
  formatDate,
  formatDateISO,
  slugify,
} from "../../lib/blog";
import { getSiteUrl } from "../../lib/site";
import {
  AUTHOR_NAME,
  DEFAULT_OG_IMAGE,
  absoluteImageUrl,
  buildBlogPostingSchema,
  buildBreadcrumbSchema,
} from "../../lib/seo";
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings: rawHeadings } = await render(post);
const headings = rawHeadings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ id: h.slug, text: h.text, level: h.depth }));

const allPosts = await getPublishedPosts();
const readTime = getPostReadingTime(post);
const readingMinutes = getPostReadingTimeMinutes(post);
const relatedPosts = getRelatedPosts(post, allPosts, 3);
const { prev, next } = getAdjacentPosts(post, allPosts);

const siteUrl = getSiteUrl(Astro.site);
const canonical = `${siteUrl}/blog/${post.id}`;
const ogImageUrl =
  typeof post.data.image === "string"
    ? post.data.image
    : post.data.image?.src
      ? new URL(post.data.image.src, siteUrl).toString()
      : absoluteImageUrl(DEFAULT_OG_IMAGE, siteUrl);

const pageTitle = `${post.data.title} | ${AUTHOR_NAME}`;
const published = formatDateISO(post.data.publishDate);
const modified = formatDateISO(post.data.updatedDate || post.data.publishDate);

const articleSchema = buildBlogPostingSchema({
  siteUrl,
  url: canonical,
  headline: post.data.title,
  description: post.data.description,
  image: ogImageUrl,
  datePublished: published,
  dateModified: modified,
  keywords: post.data.tags,
  articleSection: post.data.category,
  wordCount: getWordCount(post.body ?? post.data.description),
  readingTimeMinutes: readingMinutes,
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: siteUrl },
  { name: "Blog", url: `${siteUrl}/blog` },
  { name: post.data.category, url: `${siteUrl}/blog/category/${slugify(post.data.category)}` },
  { name: post.data.title, url: canonical },
]);

// Determine contextual call to action matching topic
const catLower = (post.data.category || "").toLowerCase();
const tagsStr = (post.data.tags || []).join(" ").toLowerCase();
const titleLower = post.data.title.toLowerCase();

let contextualService = {
  title: "Hire a Senior Next.js & React Engineer",
  desc: "Looking to ship scalable React/Next.js architectures, real-time dashboards, or resolve technical debt with zero bloat?",
  ctaText: "Discuss Next.js Project",
  ctaHref: "/hire-nextjs-developer",
  caseStudyTitle: "Explore Urban Nursery Case Study",
  caseStudyHref: "/work/urban-nursery",
};

if (catLower.includes("astro") || tagsStr.includes("astro") || titleLower.includes("astro") || titleLower.includes("wordpress")) {
  contextualService = {
    title: "Hire a Senior Astro.js Developer",
    desc: "Planning a WordPress-to-Astro migration or need a sub-second, SEO-dominant content site with Sanity CMS?",
    ctaText: "Hire Astro Developer",
    ctaHref: "/hire-astro-developer",
    caseStudyTitle: "Explore Boutee Case Study (99/100 CWV)",
    caseStudyHref: "/work/boutee",
  };
} else if (catLower.includes("commerce") || tagsStr.includes("commerce") || tagsStr.includes("marketplace") || titleLower.includes("vendor") || titleLower.includes("cart")) {
  contextualService = {
    title: "Custom E-Commerce & Marketplace Architecture",
    desc: "Building a high-concurrency multi-vendor marketplace, spatial delivery platform, or Stripe/Razorpay payment engine?",
    ctaText: "Discuss Custom E-Commerce",
    ctaHref: "/custom-ecommerce-developer",
    caseStudyTitle: "Explore Urban Nursery Case Study",
    caseStudyHref: "/work/urban-nursery",
  };
} else if (tagsStr.includes("performance") || catLower.includes("performance") || tagsStr.includes("vitals")) {
  contextualService = {
    title: "Core Web Vitals & Performance Audits",
    desc: "Struggling with failing mobile CWV, sluggish LCP, or layout shifts on high-intent conversion routes?",
    ctaText: "Request Performance Audit",
    ctaHref: "/website-performance-optimization",
    caseStudyTitle: "Explore Performance Work",
    caseStudyHref: "/work",
  };
}
---

<Layout
  title={pageTitle}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImageUrl}
  publishedTime={published}
  modifiedTime={modified}
  tags={post.data.tags}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <ReadingProgress />

  <div id="main-content" class="relative z-10 pt-32 pb-24 sm:pt-40 sm:pb-32">
    <!-- Ambient Glow Behind Hero -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-gradient-to-tr from-emerald-500/10 via-blue-500/10 to-purple-500/0 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- ════════════ 1. BREADCRUMBS & ARTICLE HEADER ════════════ -->
      <header class="max-w-4xl mx-auto mb-12 sm:mb-16">
        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs font-mono text-zinc-500">
          <a href="/" class="hover:text-zinc-300 transition-colors">Home</a>
          <span>/</span>
          <a href="/blog" class="hover:text-zinc-300 transition-colors">Blog</a>
          <span>/</span>
          <a href={`/blog/category/${slugify(post.data.category)}`} class="hover:text-zinc-300 transition-colors capitalize">
            {post.data.category}
          </a>
        </nav>

        <!-- Category & Reading Metadata Pill -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a
            href={`/blog/category/${slugify(post.data.category)}`}
            class="text-xs font-mono font-medium px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 no-underline hover:bg-emerald-500/20 transition-colors"
          >
            {post.data.category}
          </a>
          <span class="text-xs font-mono text-zinc-500">{readTime}</span>
          <span class="text-zinc-600">·</span>
          <time datetime={post.data.publishDate.toISOString()} class="text-xs font-mono text-zinc-400">
            {formatDate(post.data.publishDate)}
          </time>
          {post.data.updatedDate && (
            <>
              <span class="text-zinc-600">·</span>
              <span class="text-xs font-mono text-zinc-500">
                Updated {formatDate(post.data.updatedDate)}
              </span>
            </>
          )}
        </div>

        <!-- Article H1 -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-[-0.03em] leading-[1.12] mb-6">
          {post.data.title}
        </h1>

        <!-- Executive TL;DR Box -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#111114]/90 border border-white/[0.08] relative overflow-hidden mb-8">
          <div class="flex items-center gap-2 mb-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Executive Takeaway</span>
          </div>
          <p class="text-sm text-zinc-300 leading-relaxed font-sans">
            {post.data.description}
          </p>
        </div>

        <!-- Author Byline -->
        <div class="flex items-center justify-between flex-wrap gap-4 pt-4 border-t border-white/[0.06] text-xs">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center font-bold text-emerald-400 text-xs">
              OP
            </div>
            <div>
              <div class="font-bold text-white">{AUTHOR_NAME}</div>
              <div class="text-zinc-500 text-[11px]">Senior Frontend & Full-Stack Engineer · Top Rated Upwork</div>
            </div>
          </div>

          <div class="flex items-center gap-2 text-zinc-400 font-mono text-[11px]">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Indore, India (Full UK/EU/US Overlap)</span>
          </div>
        </div>

        <!-- Optional Hero Cover Image -->
        {
          post.data.image && (
            <div class="mt-8 rounded-2xl overflow-hidden border border-white/[0.08] shadow-2xl">
              <Image
                src={post.data.image}
                alt={post.data.imageAlt || post.data.title}
                width={1200}
                height={630}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto max-h-[480px] object-cover"
              />
            </div>
          )
        }
      </header>

      <!-- ════════════ 2. TWO-COLUMN LAYOUT: EDITORIAL PROSE + STICKY SIDEBAR ════════════ -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start max-w-6xl mx-auto">
        
        <!-- Left / Main Column: Editorial Prose (8 cols) -->
        <article class="lg:col-span-8 min-w-0" data-article-content>
          <div class="blog-prose" id="post-content">
            <Content />
          </div>

          <!-- Dynamic Contextual CTA Banner -->
          <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-[#111114] to-zinc-950 border border-white/[0.08] shadow-2xl relative overflow-hidden">
            <div class="absolute -right-16 -bottom-16 w-60 h-60 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400 mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Implementation & Consulting
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-2">
              {contextualService.title}
            </h3>

            <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-6">
              {contextualService.desc}
            </p>

            <div class="flex flex-wrap items-center gap-4">
              <a
                href={contextualService.ctaHref}
                class="px-5 py-2.5 rounded-xl font-semibold text-xs text-zinc-950 bg-white hover:bg-zinc-200 transition-all flex items-center gap-2 shadow-[0_0_15px_rgba(255,255,255,0.15)]"
              >
                <span>{contextualService.ctaText}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a
                href={contextualService.caseStudyHref}
                class="text-xs font-mono text-zinc-400 hover:text-white transition-colors"
              >
                {contextualService.caseStudyTitle} →
              </a>
            </div>
          </div>

          <!-- Author Credibility Card -->
          <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-[#111114]/90 border border-white/[0.08] flex flex-col sm:flex-row items-start gap-6">
            <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center font-extrabold text-emerald-400 text-xl flex-shrink-0">
              OP
            </div>

            <div class="flex-1">
              <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
                <h4 class="text-base font-bold text-white">Written by {AUTHOR_NAME}</h4>
                <span class="text-xs font-mono text-emerald-400 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">
                  Top Rated on Upwork (100% JSS)
                </span>
              </div>

              <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-4">
                Senior Frontend & Full-Stack Engineer with 3+ years delivering production Astro, Next.js, and custom e-commerce systems for founders across the UK, Switzerland, Germany, and the US. MCA graduate, focused on sub-second Core Web Vitals, clean architecture, and async delivery.
              </p>

              <div class="flex items-center gap-4 text-xs font-mono text-zinc-400">
                <a href="https://www.upwork.com/freelancers/~013f75d3791e17fa5d" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">
                  Upwork Profile ↗
                </a>
                <span>·</span>
                <a href="https://github.com/optanwar" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                  GitHub ↗
                </a>
                <span>·</span>
                <a href="https://www.linkedin.com/in/optanwar/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                  LinkedIn ↗
                </a>
              </div>
            </div>
          </div>

          <!-- Post Navigation (Prev / Next) -->
          <PostNavigation prev={prev} next={next} />

          <!-- Related Posts -->
          <RelatedPosts posts={relatedPosts} allPosts={allPosts} />
        </article>

        <!-- Right / Sticky Sidebar (4 cols) -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6" aria-label="Article navigation and consultation">
          
          <!-- Table of Contents Card -->
          {headings.length > 0 && (
            <div class="p-5 rounded-2xl bg-[#111114]/90 border border-white/[0.08] shadow-xl">
              <TableOfContents headings={headings} />
            </div>
          )}

          <!-- Work With Me Sticky Card -->
          <div class="p-6 rounded-2xl bg-[#111114]/90 border border-white/[0.08] shadow-xl relative overflow-hidden group">
            <div class="flex items-center gap-2 mb-3">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-mono font-medium text-emerald-400">Available for Sprints</span>
            </div>

            <h4 class="text-base font-bold text-white mb-2 leading-snug">
              Building with Astro, Next.js, or launching a marketplace?
            </h4>

            <p class="text-xs text-zinc-400 leading-relaxed mb-5">
              Direct principal engineer. 40 hrs/week dedicated availability with full UK, European (CET/GMT), and US East Coast (EST) working overlap.
            </p>

            <a
              href="/#contact"
              class="w-full py-2.5 px-4 rounded-xl font-semibold text-xs text-zinc-950 bg-white hover:bg-zinc-200 transition-all flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(255,255,255,0.15)] no-underline"
            >
              <span>Book a Discovery Call</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <div class="pt-4 mt-4 border-t border-white/[0.06] flex items-center justify-between text-[11px] font-mono text-zinc-500">
              <span>&lt;0.8s LCP Guarantee</span>
              <span>NDA Ready</span>
            </div>
          </div>

        </aside>

      </div>

    </div>
  </div>
</Layout>

<script>
  function enhanceCodeBlocks() {
    const container = document.getElementById("post-content");
    if (!container) return;

    container.querySelectorAll("pre").forEach((pre) => {
      if (pre.querySelector(".code-header")) return;

      const code = pre.querySelector("code");
      const langClass = code?.className.match(/language-(\w+)/);
      const lang = langClass ? langClass[1] : "code";

      const header = document.createElement("div");
      header.className = "code-header";

      const langSpan = document.createElement("span");
      langSpan.className = "code-lang";
      langSpan.textContent = lang;

      const copyBtn = document.createElement("button");
      copyBtn.className = "code-copy";
      copyBtn.type = "button";
      copyBtn.textContent = "Copy";
      copyBtn.setAttribute("aria-label", "Copy code to clipboard");

      copyBtn.addEventListener("click", async () => {
        const text = code?.textContent || pre.textContent || "";
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.textContent = "Copied!";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            copyBtn.textContent = "Copy";
            copyBtn.classList.remove("copied");
          }, 2000);
        } catch {
          copyBtn.textContent = "Failed";
        }
      });

      header.appendChild(langSpan);
      header.appendChild(copyBtn);
      pre.insertBefore(header, pre.firstChild);
    });
  }

  enhanceCodeBlocks();
  document.addEventListener("astro:page-load", enhanceCodeBlocks);
</script>
