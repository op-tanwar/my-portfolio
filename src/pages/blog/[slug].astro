---
import Layout from "../../layouts/Layout.astro";
import CyberSection from "../../components/blog/CyberSection.astro";
import ReadingProgress from "../../components/blog/ReadingProgress.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import RelatedPosts from "../../components/blog/RelatedPosts.astro";
import {
  getPublishedPosts,
  getPostReadingTime,
  getPostReadingTimeMinutes,
  getWordCount,
  getRelatedPosts,
  getAdjacentPosts,
  getPostAccent,
  formatDate,
  formatDateISO,
  slugify,
} from "../../lib/blog";
import { getSiteUrl } from "../../lib/site";
import {
  AUTHOR_NAME,
  DEFAULT_OG_IMAGE,
  absoluteImageUrl,
  buildBlogPostingSchema,
  buildBreadcrumbSchema,
} from "../../lib/seo";
import PostNavigation from "../../components/blog/PostNavigation.astro";
import { render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings: rawHeadings } = await render(post);
const headings = rawHeadings
  .filter((h) => h.depth >= 2 && h.depth <= 3)
  .map((h) => ({ id: h.slug, text: h.text, level: h.depth }));
const allPosts = await getPublishedPosts();
const postIndex = allPosts.indexOf(post);
const accent = getPostAccent(post, postIndex >= 0 ? postIndex : 0);
const readTime = getPostReadingTime(post);
const readingMinutes = getPostReadingTimeMinutes(post);
const relatedPosts = getRelatedPosts(post, allPosts, 3);
const { prev, next } = getAdjacentPosts(post, allPosts);

const siteUrl = getSiteUrl(Astro.site);
const canonical = `${siteUrl}/blog/${post.id}`;
const ogImageUrl =
  typeof post.data.image === "string"
    ? post.data.image
    : post.data.image?.src
      ? new URL(post.data.image.src, siteUrl).toString()
      : absoluteImageUrl(DEFAULT_OG_IMAGE, siteUrl);

const pageTitle = `${post.data.title} | ${AUTHOR_NAME}`;
const published = formatDateISO(post.data.publishDate);
const modified = formatDateISO(post.data.updatedDate || post.data.publishDate);

const articleSchema = buildBlogPostingSchema({
  siteUrl,
  url: canonical,
  headline: post.data.title,
  description: post.data.description,
  image: ogImageUrl,
  datePublished: published,
  dateModified: modified,
  keywords: post.data.tags,
  articleSection: post.data.category,
  wordCount: getWordCount(post.body ?? post.data.description),
  readingTimeMinutes: readingMinutes,
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: siteUrl },
  { name: "Blog", url: `${siteUrl}/blog` },
  { name: post.data.category, url: `${siteUrl}/blog/category/${slugify(post.data.category)}` },
  { name: post.data.title, url: canonical },
]);
---

<Layout
  title={pageTitle}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  ogImage={ogImageUrl}
  publishedTime={published}
  modifiedTime={modified}
  tags={post.data.tags}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <ReadingProgress />

  <div id="main-content">
    <CyberSection paddingTop={true}>
      <article data-article-content>
        <header class="post-header mb-8 sm:mb-12">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <a
              href={`/blog/category/${slugify(post.data.category)}`}
              class="text-[8px] font-mono font-bold tracking-widest uppercase px-2 py-0.5 no-underline transition-colors duration-200"
              style={`color:${accent}88;border:1px solid ${accent}1a;background:${accent}08;`}
            >
              {post.data.category}
            </a>
            <span
              class="text-[8px] sm:text-[9px] font-mono px-2 py-0.5"
              style={`color:${accent};background:${accent}0f;border:1px solid ${accent}22;clip-path:polygon(0 0,calc(100% - 3px) 0,100% 3px,100% 100%,3px 100%,0 calc(100% - 3px));`}
            >
              {readTime}
            </span>
          </div>

          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight mb-4"
            style="font-family:'Courier New',monospace;color:rgba(255,255,255,0.92);"
          >
            {post.data.title}
          </h1>

          <p
            class="text-sm sm:text-base font-mono leading-relaxed mb-6"
            style="color:rgba(255,255,255,0.4);"
          >
            {post.data.description}
          </p>

          <div
            class="flex flex-wrap items-center gap-4 text-[9px] sm:text-[10px] font-mono"
            style="color:rgba(255,255,255,0.25);"
          >
            <time datetime={post.data.publishDate.toISOString()}>
              Published {formatDate(post.data.publishDate)}
            </time>
            {
              post.data.updatedDate && (
                <>
                  <span aria-hidden="true">·</span>
                  <time datetime={post.data.updatedDate.toISOString()}>
                    Updated {formatDate(post.data.updatedDate)}
                  </time>
                </>
              )
            }
            <span aria-hidden="true">·</span>
            <span>{`By ${AUTHOR_NAME}`}</span>
          </div>

          <div class="flex flex-wrap gap-1.5 mt-4">
            {
              post.data.tags.map((tag) => (
                <a
                  href={`/blog/tag/${slugify(tag)}`}
                  class="text-[7px] sm:text-[8px] font-mono font-bold tracking-widest uppercase px-1.5 py-0.5 no-underline transition-all duration-200 hover:-translate-y-0.5"
                  style={`color:${accent}88;border:1px solid ${accent}1a;background:${accent}08;`}
                >
                  #{tag}
                </a>
              ))
            }
          </div>

          <div
            class="mt-6 sm:mt-8 h-px w-full"
            style="background:linear-gradient(90deg,rgba(0,255,247,0.25),rgba(191,0,255,0.15),transparent);"
          >
          </div>
        </header>

        {
          post.data.image && (
            <div
              class="relative mb-10 sm:mb-14 overflow-hidden"
              style="clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));border:1px solid rgba(255,255,255,0.08);"
            >
              <Image
                src={post.data.image}
                alt={post.data.imageAlt || post.data.title}
                width={1200}
                height={630}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full h-48 sm:h-64 lg:h-80 object-cover"
              />
              <div
                class="absolute inset-0 pointer-events-none"
                style="background:linear-gradient(180deg,transparent 60%,rgba(2,2,4,0.4) 100%);"
                aria-hidden="true"
              />
            </div>
          )
        }

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-10 lg:gap-14">
          <div class="blog-prose min-w-0" id="post-content" data-code-blocks>
            <Content />
          </div>

          {
            headings.length > 0 && (
              <aside class="hidden lg:block" aria-label="Table of contents">
                <div
                  class="sticky top-28 p-4"
                  style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));"
                >
                  <TableOfContents headings={headings} accent={accent} />
                </div>
              </aside>
            )
          }
        </div>

        {
          headings.length > 0 && (
            <details class="lg:hidden mt-8">
              <summary
                class="text-[10px] font-mono font-bold tracking-[0.2em] uppercase cursor-pointer py-3 px-4"
                style="color:#00fff7;border:1px solid rgba(0,255,247,0.2);background:rgba(0,255,247,0.04);clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));"
              >
                Table of Contents
              </summary>
              <div
                class="mt-3 p-4"
                style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);"
              >
                <TableOfContents headings={headings} accent={accent} />
              </div>
            </details>
          )
        }

        <PostNavigation prev={prev} next={next} accent={accent} />

        <div
          class="mt-12 sm:mt-16 h-px w-full"
          style="background:linear-gradient(90deg,transparent,rgba(0,255,247,0.15),rgba(191,0,255,0.1),transparent);"
        >
        </div>

        <div class="flex flex-wrap gap-4 mt-8">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-[10px] font-mono font-bold tracking-[0.15em] uppercase transition-all duration-200 hover:-translate-y-0.5 no-underline"
            style="color:#00fff7;border:1px solid rgba(0,255,247,0.25);background:rgba(0,255,247,0.04);clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));"
          >
            <svg
              class="w-3 h-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
            </svg>
            All Articles
          </a>
          <a
            href="/#contact"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-[10px] font-black tracking-[0.15em] uppercase font-mono transition-all duration-200 hover:-translate-y-0.5 no-underline"
            style="color:#020204;background:#00fff7;clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));"
          >
            Hire Me
          </a>
        </div>

        <RelatedPosts posts={relatedPosts} allPosts={allPosts} />
      </article>
    </CyberSection>
  </div>
</Layout>

<script>
  function enhanceCodeBlocks() {
    const container = document.getElementById("post-content");
    if (!container) return;

    container.querySelectorAll("pre").forEach((pre) => {
      if (pre.querySelector(".code-header")) return;

      const code = pre.querySelector("code");
      const langClass = code?.className.match(/language-(\w+)/);
      const lang = langClass ? langClass[1] : "code";

      const header = document.createElement("div");
      header.className = "code-header";

      const langSpan = document.createElement("span");
      langSpan.className = "code-lang";
      langSpan.textContent = lang;

      const copyBtn = document.createElement("button");
      copyBtn.className = "code-copy";
      copyBtn.type = "button";
      copyBtn.textContent = "Copy";
      copyBtn.setAttribute("aria-label", "Copy code to clipboard");

      copyBtn.addEventListener("click", async () => {
        const text = code?.textContent || pre.textContent || "";
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.textContent = "Copied!";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            copyBtn.textContent = "Copy";
            copyBtn.classList.remove("copied");
          }, 2000);
        } catch {
          copyBtn.textContent = "Failed";
        }
      });

      header.appendChild(langSpan);
      header.appendChild(copyBtn);
      pre.insertBefore(header, pre.firstChild);
    });
  }

  enhanceCodeBlocks();
  document.addEventListener("astro:page-load", enhanceCodeBlocks);
</script>

<style>
  .post-header {
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
