---
import Layout from "../../../layouts/Layout.astro";
import BlogListing from "../../../components/blog/BlogListing.astro";
import {
  getPublishedPosts,
  getFeaturedPosts,
  getCategories,
  getTags,
  filterByCategory,
  paginatePosts,
  POSTS_PER_PAGE,
  slugify,
} from "../../../lib/blog";
import { getSiteUrl } from "../../../lib/site";
import {
  buildBreadcrumbSchema,
  buildCollectionPageSchema,
  getCategorySeo,
} from "../../../lib/seo";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = getCategories(posts);

  return categories.map((category) => ({
    params: { category: slugify(category) },
    props: { categoryName: category },
  }));
}

const { categoryName } = Astro.props;
const { category } = Astro.params;

const allPosts = await getPublishedPosts();
const filtered = filterByCategory(allPosts, category!);
const pagination = paginatePosts(filtered, 1, POSTS_PER_PAGE);
const featuredPosts = getFeaturedPosts(allPosts);
const categories = getCategories(allPosts);
const tags = getTags(allPosts);

const siteUrl = getSiteUrl(Astro.site);
const basePath = `/blog/category/${category}`;
const canonical = `${siteUrl}${basePath}`;
const { title, description } = getCategorySeo(categoryName!);
const nextUrl =
  pagination.hasNext && pagination.nextPage
    ? `${siteUrl}${basePath}/page/${pagination.nextPage}`
    : undefined;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  tags={[categoryName!, "Frontend", "Blog", "Omprakash Tanwar"]}
  nextUrl={nextUrl}
  jsonLd={[
    buildCollectionPageSchema({
      siteUrl,
      url: canonical,
      name: title,
      description,
      itemUrls: pagination.items.map((post) => `${siteUrl}/blog/${post.id}`),
    }),
    buildBreadcrumbSchema([
      { name: "Home", url: siteUrl },
      { name: "Blog", url: `${siteUrl}/blog` },
      { name: categoryName!, url: canonical },
    ]),
  ]}
>
  <div id="main-content">
    <BlogListing
      allPosts={allPosts}
      listingPosts={pagination.items}
      featuredPosts={featuredPosts}
      categories={categories}
      tags={tags}
      currentPage={pagination.currentPage}
      totalPages={pagination.totalPages}
      hasPrev={pagination.hasPrev}
      hasNext={pagination.hasNext}
      prevPage={pagination.prevPage}
      nextPage={pagination.nextPage}
      basePath={basePath}
      activeCategory={category}
      headerLabel={`// blog.category("${categoryName}")`}
      titleWhite={categoryName!}
      titleGradient="Articles_"
      subtitle={`${filtered.length} article${filtered.length === 1 ? "" : "s"}`}
      showSearch={true}
    />
  </div>
</Layout>
