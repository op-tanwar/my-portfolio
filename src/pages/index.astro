---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/home/Welcome.astro";
import ProjectsSection from "../components/home/ProjectsSection.astro";
import ServicesSection from "../components/home/ServicesSection.astro";
import TestimonialsSection from "../components/home/TestimonialsSection.astro";
import TechAndProcessSection from "../components/home/TechAndProcessSection.astro";
import FaqSection, { faqs } from "../components/home/FaqSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import { getSiteUrl } from "../lib/site";
import {
  buildBreadcrumbSchema,
  buildProfessionalServiceSchema,
  buildWebPageSchema,
} from "../lib/seo";

const siteUrl = getSiteUrl(Astro.site);
const title =
  "Senior Frontend & Full-Stack Engineer | Hire Astro.js, Next.js & Custom E-Commerce Expert | Omprakash Tanwar";
const description =
  "Hire Omprakash Tanwar — Senior Frontend & Full-Stack Engineer specializing in Astro v5, Next.js 15, React, TypeScript, and Custom Multi-Vendor E-Commerce marketplaces. Serving European, UK & US tech founders with 98–100 Lighthouse speed and seamless CET/GMT overlap.";
const canonical = `${siteUrl}/`;

// FAQPage JSON-LD Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

// Detailed Professional Person Schema
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Omprakash Tanwar",
  jobTitle: "Senior Frontend & Full-Stack Engineer",
  url: siteUrl,
  sameAs: [
    "https://github.com/optanwar",
    "https://www.linkedin.com/in/optanwar/",
    "https://www.upwork.com/freelancers/~013f75d3791e17fa5d",
  ],
  knowsAbout: [
    "Astro.js",
    "Next.js App Router",
    "React.js",
    "TypeScript",
    "Tailwind CSS",
    "Custom E-Commerce",
    "Multi-Vendor Marketplaces",
    "Core Web Vitals Optimization",
    "Technical SEO",
    "Sanity.io CMS",
    "MongoDB Geospatial 2dsphere",
    "Redis Caching",
    "Stripe API",
  ],
  areaServed: ["United Kingdom", "Switzerland", "Germany", "Netherlands", "European Union", "United States", "Worldwide"],
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  tags={[
    "Astro Developer",
    "Hire Astro Developer",
    "Next.js Developer",
    "React Frontend Engineer",
    "Custom E-Commerce Developer",
    "Multi-Vendor Marketplace Developer",
    "Core Web Vitals Consultant",
    "Figma to Code Specialist",
    "UK and European Timezone",
  ]}
  jsonLd={[
    personSchema,
    buildProfessionalServiceSchema(siteUrl),
    faqSchema,
    buildWebPageSchema({
      siteUrl,
      url: canonical,
      name: title,
      description,
      type: "WebPage",
    }),
    buildBreadcrumbSchema([{ name: "Home", url: canonical }]),
  ]}
>
  <div id="main-content" class="relative">
    
    <!-- 1. HERO SECTION + EUROPEAN / GLOBAL TRUST STRIP -->
    <section id="hire-frontend-developer">
      <HeroSection projectsUrl="/#projects" contactUrl="/#contact" />
    </section>

    <!-- 2. SELECTED WORK (FLAGSHIP CASE STUDIES) -->
    <section id="frontend-developer-projects">
      <ProjectsSection />
    </section>

    <!-- 3. CORE SERVICES (4-PILLAR BENTO GRID ALIGNED WITH HIGH-INTENT KEYWORDS) -->
    <section id="frontend-development-services">
      <ServicesSection />
    </section>

    <!-- 4. VERIFIED CLIENT REVIEWS (2x2 UPWORK UK, SWISS & US REVIEWS) -->
    <section id="client-testimonials">
      <TestimonialsSection />
    </section>

    <!-- 5. TECH ARSENAL & 4-STEP ENGINEERING WORKFLOW (SPLIT BENTO) -->
    <section id="engineering-process">
      <TechAndProcessSection />
    </section>

    <!-- 6. HIGH-INTENT TECHNICAL FAQ (SEO FAQP奋GE) -->
    <section id="technical-faq">
      <FaqSection />
    </section>

    <!-- 7. CONVERSION CONTACT SECTION -->
    <section id="contact-frontend-developer">
      <ContactSection />
    </section>

  </div>
</Layout>
