---
// Navbar.astro — Minimal Executive Sticky Glassmorphic Navbar

const links = [
  { name: "Work", href: "/#projects", title: "Selected Case Studies & Engineering Work" },
  { name: "Services", href: "/#services", title: "Frontend & Full-Stack Services" },
  { name: "Process", href: "/#process", title: "4-Step Engineering Delivery Process" },
  { name: "Reviews", href: "/#testimonials", title: "Verified Upwork Client Reviews" },
  { name: "Blog", href: "/blog", title: "Engineering Blog" },
];
---

<header class="fixed top-0 left-0 w-full z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-3 sm:pt-4">
    <nav
      aria-label="Primary Navigation"
      class="flex items-center justify-between px-4 sm:px-6 py-2.5 rounded-full bg-[#111114]/80 backdrop-blur-md border border-white/[0.08] shadow-[0_8px_30px_rgb(0,0,0,0.4)] transition-all duration-300"
    >
      <!-- BRAND LOGO -->
      <a
        href="/"
        class="flex items-center gap-2 group transition-opacity hover:opacity-90"
        aria-label="OP.dev Home"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 group-hover:scale-125 transition-transform duration-300 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
        <span class="font-sans font-bold text-sm tracking-tight text-white flex items-center">
          OP<span class="text-zinc-500 font-mono">.dev</span>
        </span>
      </a>

      <!-- DESKTOP NAV LINKS -->
      <ul class="hidden md:flex items-center gap-1 lg:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                title={link.title}
                class="px-3 py-1.5 rounded-full text-xs font-medium text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all duration-200"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- CTA BUTTON & MOBILE TOGGLE -->
      <div class="flex items-center gap-3">
        <a
          href="/#contact"
          class="hidden sm:inline-flex items-center justify-center px-4 py-1.5 rounded-full text-xs font-semibold text-zinc-950 bg-white hover:bg-zinc-200 active:scale-95 transition-all duration-200 shadow-[0_0_20px_rgba(255,255,255,0.15)]"
        >
          Book a Discovery Call
        </a>

        <!-- MOBILE MENU BUTTON -->
        <button
          id="menu-btn"
          type="button"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          class="md:hidden flex items-center justify-center w-8 h-8 rounded-full text-zinc-300 hover:text-white bg-white/[0.04] border border-white/[0.08] transition-colors focus:outline-none"
        >
          <svg class="w-4 h-4 menu-open-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
          <svg class="w-4 h-4 menu-close-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- MOBILE MENU DRAWER -->
    <div
      id="mobile-menu"
      class="hidden md:hidden mt-2 p-4 rounded-2xl bg-[#111114]/95 backdrop-blur-xl border border-white/[0.08] shadow-2xl flex flex-col gap-2 transition-all duration-300"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link px-3 py-2 rounded-xl text-sm font-medium text-zinc-300 hover:text-white hover:bg-white/[0.05] transition-colors"
          >
            {link.name}
          </a>
        ))
      }
      <div class="pt-2 mt-1 border-t border-white/[0.06]">
        <a
          href="/#contact"
          class="mobile-nav-link flex items-center justify-center w-full py-2.5 rounded-xl text-xs font-semibold text-zinc-950 bg-white hover:bg-zinc-200 transition-colors"
        >
          Book a Discovery Call
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const openIcon = btn?.querySelector(".menu-open-icon");
    const closeIcon = btn?.querySelector(".menu-close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    const toggleMenu = () => {
      const isHidden = menu?.classList.toggle("hidden");
      const expanded = !isHidden;
      btn?.setAttribute("aria-expanded", String(expanded));
      openIcon?.classList.toggle("hidden", expanded);
      closeIcon?.classList.toggle("hidden", !expanded);
    };

    btn?.addEventListener("click", toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (!menu?.classList.contains("hidden")) {
          toggleMenu();
        }
      });
    });
  })();
</script>
