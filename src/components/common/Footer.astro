---
// Footer.astro — Minimal Executive Dark Footer

interface Props {
  name?: string;
  year?: string;
}

const {
  name = "Omprakash Tanwar",
  year = String(new Date().getFullYear()),
} = Astro.props;

const navLinks = [
  { label: "Work", href: "/#projects" },
  { label: "Services", href: "/#services" },
  { label: "Process", href: "/#process" },
  { label: "Reviews", href: "/#testimonials" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/#contact" },
];
const serviceLinks = [
  { label: "Hire Astro Developer", href: "/hire-astro-developer" },
  { label: "Hire Next.js Developer", href: "/hire-nextjs-developer" },
  { label: "Hire React Developer", href: "/hire-react-developer" },
  { label: "Custom E-Commerce Developer", href: "/custom-ecommerce-developer" },
  { label: "Figma to Code", href: "/figma-to-code-developer" },
];
---

<footer id="footer" class="border-t border-white/[0.08] bg-[#09090b] py-14 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- TOP ROW: BRAND & NAVIGATION -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/[0.06]">
      
      <!-- BRAND LOGO & TAGLINE -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <span class="w-2 h-2 rounded-full bg-emerald-400 group-hover:scale-125 transition-transform duration-300 shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
          <span class="font-sans font-bold text-sm tracking-tight text-white flex items-center">
            OP<span class="text-zinc-500 font-mono">.dev</span>
          </span>
        </a>
        <span class="text-zinc-600">/</span>
        <span class="text-xs text-zinc-400">Senior Frontend & Full-Stack Engineer</span>
      </div>

      <!-- NAV LINKS -->
      <nav class="flex flex-wrap items-center justify-center gap-6" aria-label="Footer navigation">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-xs font-medium text-zinc-400 hover:text-white transition-colors"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

    </div>

    <!-- MIDDLE ROW: SPECIALIZED SERVICE PATHS (SEO BUYER INTENT) -->
    <div class="py-6 border-b border-white/[0.06] flex flex-wrap items-center justify-between gap-4 text-xs">
      <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-500">
        Direct Engineering Services:
      </span>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          serviceLinks.map((s) => (
            <a
              href={s.href}
              class="text-zinc-400 hover:text-emerald-400 transition-colors font-medium text-xs"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <!-- BOTTOM ROW: COPYRIGHT & METRICS -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
      <div>
        © {year} {name}. Engineered with Astro v5 & Tailwind CSS v4.
      </div>

      <div class="flex items-center gap-4">
        <a
          href="/rss.xml"
          class="font-mono text-xs text-zinc-400 hover:text-zinc-200 transition-colors"
        >
          RSS Feed
        </a>
        <span class="text-zinc-700">·</span>
        <div class="flex items-center gap-1.5 font-mono text-zinc-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>100% Upwork JSS · EU / UK / US Friendly</span>
        </div>
      </div>
    </div>

  </div>
</footer>
