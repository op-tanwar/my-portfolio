---
import Layout from "../../layouts/Layout.astro";
import CyberSection from "../blog/CyberSection.astro";
import ContactSection from "../home/ContactSection.astro";
import { getSiteUrl } from "../../lib/site";
import type { ServiceLandingConfig } from "../../lib/landing";
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
  buildWebPageSchema,
} from "../../lib/seo";

interface Props {
  config: ServiceLandingConfig;
}

const { config } = Astro.props;
const siteUrl = getSiteUrl(Astro.site);
const canonical = `${siteUrl}/${config.slug}`;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: siteUrl },
  { name: config.keyword, url: canonical },
]);

const serviceSchema = buildServiceSchema({
  siteUrl,
  url: canonical,
  name: config.keyword,
  description: config.description,
  serviceType: config.keyword,
});

const faqSchema = buildFaqSchema(config.faqs);

const webPageSchema = buildWebPageSchema({
  siteUrl,
  url: canonical,
  name: config.title,
  description: config.description,
  type: "WebPage",
});
---

<Layout
  title={config.title}
  description={config.description}
  canonical={canonical}
  tags={config.tags}
  jsonLd={[serviceSchema, faqSchema, webPageSchema, breadcrumbSchema]}
>
  <div id="main-content">
    <!-- Landing HERO section -->
    <CyberSection paddingTop={true} id="hero">
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <p
          class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase"
          style={`color:${config.accent}73;`}
        >
          {config.eyebrow}
        </p>
        <span
          class="text-[8px] font-mono px-2 py-0.5 tracking-widest uppercase"
          style={`color:${config.accent};background:${config.accent}12;border:1px solid ${config.accent}28;clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));`}
        >
          Available for hire
        </span>
      </div>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-black leading-none tracking-tight max-w-4xl"
        style="font-family:'Courier New',monospace;"
      >
        <span style="color:rgba(255,255,255,0.9);">{config.h1Before}</span>
        <span
          class="block mt-1"
          style={`background:linear-gradient(90deg,${config.accent},${config.accentSecondary});-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;`}
        >
          {config.h1Accent}
        </span>
      </h1>

      <p
        class="mt-5 sm:mt-6 text-sm sm:text-base font-mono leading-relaxed max-w-2xl"
        style="color:rgba(255,255,255,0.4);"
      >
        {config.lead}
      </p>

      <ul class="mt-6 flex flex-col gap-2.5 max-w-xl">
        {
          config.heroPoints.map((point) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0"
                style={`background:${config.accent};box-shadow:0 0 8px ${config.accent};`}
              />
              <span
                class="text-[11px] sm:text-xs font-mono leading-relaxed"
                style="color:rgba(255,255,255,0.45);"
              >
                {point}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#contact"
          class="group inline-flex items-center gap-2.5 px-7 py-3.5 text-xs font-black tracking-[0.15em] uppercase font-mono transition-all duration-200 hover:-translate-y-0.5 no-underline"
          style={`color:#020204;background:${config.accent};clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));`}
        >
          {config.primaryCta}
          <svg
            class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="3"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 px-6 py-3.5 text-xs font-bold tracking-[0.15em] uppercase font-mono transition-all duration-200 hover:-translate-y-0.5 no-underline"
          style={`color:${config.accent};border:1px solid ${config.accent}40;background:${config.accent}0a;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));`}
        >
          {config.secondaryCta}
        </a>
      </div>

      <div class="mt-10 flex flex-wrap gap-2">
        {
          config.badges.map((b) => (
            <div
              class="flex flex-col items-center px-3 py-2"
              style={`background:${b.color}08;border:1px solid ${b.color}20;clip-path:polygon(0 0,calc(100% - 5px) 0,100% 5px,100% 100%,5px 100%,0 calc(100% - 5px));`}
            >
              <span
                class="text-[11px] sm:text-xs font-black font-mono"
                style={`color:${b.color};`}
              >
                {b.label}
              </span>
              <span
                class="text-[8px] font-mono tracking-widest uppercase"
                style="color:rgba(255,255,255,0.2);"
              >
                {b.sub}
              </span>
            </div>
          ))
        }
      </div>
    </CyberSection>

    <!-- CAPABILITIES -->
    <CyberSection id="capabilities">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style={`color:${config.accent}73;`}
      >
        // services.capabilities()
      </p>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-black leading-none tracking-tight"
        style="font-family:'Courier New',monospace;"
      >
        <span style="color:rgba(255,255,255,0.9);"
          >{config.capabilitiesTitle}</span
        >
        <span
          class="block"
          style={`background:linear-gradient(90deg,${config.accent},${config.accentSecondary});-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;`}
        >
          {config.capabilitiesAccent}
        </span>
      </h2>
      <p
        class="mt-3 text-xs sm:text-sm font-mono max-w-2xl"
        style="color:rgba(255,255,255,0.3);"
      >
        {config.capabilitiesIntro}
      </p>
      <div
        class="mt-6 sm:mt-8 h-px w-full mb-8 sm:mb-10"
        style={`background:linear-gradient(90deg,${config.accent}40,${config.accentSecondary}25,transparent);`}
      >
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
        {
          config.capabilities.map((cap) => (
            <article
              class="group relative flex flex-col gap-3 p-5 sm:p-6 transition-all duration-300 hover:-translate-y-1"
              style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));"
            >
              <div
                class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity"
                style={`background:linear-gradient(90deg,transparent,${cap.accent},transparent);`}
                aria-hidden="true"
              />
              <div class="flex items-center justify-between gap-2">
                <span
                  class="text-[9px] font-mono"
                  style={`color:${cap.accent};opacity:0.5;`}
                >
                  {cap.id}
                </span>
              </div>
              <h3
                class="text-sm sm:text-base font-black font-mono"
                style={`color:${cap.accent};`}
              >
                {cap.title}
              </h3>
              <p
                class="text-[10px] sm:text-[11px] font-mono leading-relaxed flex-1"
                style="color:rgba(255,255,255,0.35);"
              >
                {cap.desc}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-1">
                {cap.tags.map((tag) => (
                  <span
                    class="text-[8px] font-mono px-2 py-0.5 tracking-wider uppercase"
                    style={`color:${cap.accent}99;border:1px solid ${cap.accent}22;background:${cap.accent}08;`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </CyberSection>

    <!-- PROBLEMS -->
    <CyberSection id="problems">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style={`color:${config.accentSecondary}80;`}
      >
        // problems.solve()
      </p>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-black leading-none tracking-tight mb-3"
        style="font-family:'Courier New',monospace;color:rgba(255,255,255,0.9);"
      >
        {config.problemsHeading}
      </h2>
      <p
        class="text-xs sm:text-sm font-mono max-w-2xl mb-8 sm:mb-10"
        style="color:rgba(255,255,255,0.3);"
      >
        {config.problemsIntro}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
        {
          config.problems.map((p, i) => (
            <div
              class="flex gap-4 p-4 sm:p-5"
              style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));"
            >
              <span
                class="text-[10px] font-mono font-black flex-shrink-0"
                style={`color:${config.accent};opacity:0.45;`}
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3
                  class="text-xs sm:text-sm font-black font-mono mb-1.5"
                  style="color:rgba(255,255,255,0.78);"
                >
                  {p.title}
                </h3>
                <p
                  class="text-[10px] sm:text-[11px] font-mono leading-relaxed"
                  style="color:rgba(255,255,255,0.32);"
                >
                  {p.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </CyberSection>

    <!-- PROCESS   -->
    <CyberSection id="process">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style={`color:${config.accent}73;`}
      >
        // process.run()
      </p>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-black leading-none tracking-tight"
        style="font-family:'Courier New',monospace;color:rgba(255,255,255,0.9);"
      >
        {config.processHeading}
      </h2>
      <p
        class="mt-3 text-xs sm:text-sm font-mono max-w-2xl mb-8 sm:mb-10"
        style="color:rgba(255,255,255,0.3);"
      >
        {config.processIntro}
      </p>

      <div class="relative flex flex-col gap-3 sm:gap-4">
        <div
          class="absolute left-5 sm:left-[22px] top-10 bottom-10 w-px hidden sm:block pointer-events-none"
          style={`background:linear-gradient(180deg,${config.accent}50,${config.accentSecondary}30,transparent);`}
          aria-hidden="true"
        >
        </div>
        {
          config.process.map((step) => (
            <div class="group relative flex gap-3 sm:gap-4">
              <div class="flex-shrink-0 relative z-10">
                <div
                  class="w-9 h-9 sm:w-11 sm:h-11 flex items-center justify-center"
                  style={`background:${step.color}12;border:1px solid ${step.color}35;clip-path:polygon(0 0,calc(100% - 5px) 0,100% 5px,100% 100%,5px 100%,0 calc(100% - 5px));`}
                >
                  <span
                    class="text-[10px] font-black font-mono"
                    style={`color:${step.color};`}
                  >
                    {step.num}
                  </span>
                </div>
              </div>
              <div
                class="flex-1 relative p-3.5 sm:p-5"
                style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));"
              >
                <div class="flex items-center gap-2 sm:gap-3 mb-1.5">
                  <span
                    class="text-[8px] sm:text-[9px] font-mono tracking-[0.2em] uppercase"
                    style="color:rgba(255,255,255,0.22);"
                  >
                    {step.label}
                  </span>
                </div>
                <h3
                  class="text-sm sm:text-base font-black font-mono mb-1.5"
                  style={`color:${step.color};`}
                >
                  {step.title}
                </h3>
                <p
                  class="text-[10px] sm:text-[11px] font-mono leading-relaxed"
                  style="color:rgba(255,255,255,0.35);"
                >
                  {step.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </CyberSection>

    <!-- MID CTA -->
    <CyberSection id="engage">
      <div
        class="relative overflow-hidden p-6 sm:p-8 lg:p-10"
        style={`background:rgba(255,255,255,0.02);border:1px solid ${config.accent}22;clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px));`}
      >
        <div
          class="absolute top-0 left-0 right-0 h-px"
          style={`background:linear-gradient(90deg,transparent,${config.accent},transparent);opacity:0.6;`}
          aria-hidden="true"
        >
        </div>
        <p
          class="text-[9px] font-mono tracking-[0.3em] uppercase mb-3"
          style={`color:${config.accent}99;`}
        >
          // hire.now()
        </p>
        <h2
          class="text-2xl sm:text-3xl font-black font-mono leading-tight mb-3"
          style="color:rgba(255,255,255,0.88);"
        >
          {config.midCtaHeading}
        </h2>
        <p
          class="text-xs sm:text-sm font-mono max-w-2xl mb-6"
          style="color:rgba(255,255,255,0.35);"
        >
          {config.midCtaBody}
        </p>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-xs font-black tracking-[0.15em] uppercase font-mono no-underline transition-all hover:-translate-y-0.5"
          style={`color:#020204;background:linear-gradient(90deg,${config.accent},${config.accentSecondary});clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));`}
        >
          Start a Project
        </a>
      </div>
    </CyberSection>

    <!-- TECH -->
    <CyberSection id="stack">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style={`color:${config.accent}73;`}
      >
        // stack.list()
      </p>
      <h2
        class="text-3xl sm:text-4xl font-black leading-none tracking-tight mb-3"
        style="font-family:'Courier New',monospace;color:rgba(255,255,255,0.9);"
      >
        {config.techHeading}
      </h2>
      <p
        class="text-xs sm:text-sm font-mono max-w-2xl mb-8"
        style="color:rgba(255,255,255,0.3);"
      >
        {config.techIntro}
      </p>
      <div class="flex flex-wrap gap-2 sm:gap-3">
        {
          config.tech.map((t) => (
            <span
              class="text-[10px] sm:text-xs font-mono font-bold px-3 py-2 tracking-wide"
              style={`color:${t.color};background:${t.color}10;border:1px solid ${t.color}28;clip-path:polygon(0 0,calc(100% - 6px) 0,100% 6px,100% 100%,6px 100%,0 calc(100% - 6px));`}
            >
              {t.name}
            </span>
          ))
        }
      </div>
    </CyberSection>

    <!-- REASONS -->
    <CyberSection id="why">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style="color:rgba(255,0,110,0.5);"
      >
        // why.hire()
      </p>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-black leading-none tracking-tight mb-8 sm:mb-10"
        style="font-family:'Courier New',monospace;color:rgba(255,255,255,0.9);"
      >
        {config.reasonsHeading}
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {
          config.reasons.map((reason, i) => (
            <li
              class="flex items-start gap-3 p-4"
              style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));"
            >
              <span
                class="mt-1 w-1.5 h-1.5 rounded-full flex-shrink-0"
                style={`background:${i % 2 === 0 ? config.accent : config.accentSecondary};box-shadow:0 0 6px ${i % 2 === 0 ? config.accent : config.accentSecondary};`}
              />
              <span
                class="text-[10px] sm:text-xs font-mono leading-relaxed"
                style="color:rgba(255,255,255,0.4);"
              >
                {reason}
              </span>
            </li>
          ))
        }
      </ul>
    </CyberSection>

    <!-- PROOF -->
    <CyberSection id="proof">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style={`color:${config.accent}73;`}
      >
        // work.relevant()
      </p>
      <h2
        class="text-3xl sm:text-4xl font-black leading-none tracking-tight mb-3"
        style="font-family:'Courier New',monospace;color:rgba(255,255,255,0.9);"
      >
        {config.proofHeading}
      </h2>
      <p
        class="text-xs sm:text-sm font-mono max-w-2xl mb-8"
        style="color:rgba(255,255,255,0.3);"
      >
        {config.proofIntro}
      </p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5">
        {
          config.proof.map((item) => (
            <article
              class="relative flex flex-col gap-3 p-5 sm:p-6"
              style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));"
            >
              <div class="flex items-center justify-between gap-2">
                <span
                  class="text-[8px] font-mono tracking-widest uppercase"
                  style={`color:${item.accent};opacity:0.7;`}
                >
                  {item.type}
                </span>
                {item.metric && (
                  <span
                    class="text-[9px] font-mono font-bold"
                    style={`color:${item.accent};`}
                  >
                    {item.metric}
                  </span>
                )}
              </div>
              <h3
                class="text-sm sm:text-base font-black font-mono"
                style="color:rgba(255,255,255,0.85);"
              >
                {item.title}
              </h3>
              <p
                class="text-[10px] sm:text-[11px] font-mono leading-relaxed"
                style="color:rgba(255,255,255,0.35);"
              >
                {item.desc}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {item.tags.map((tag) => (
                  <span
                    class="text-[8px] font-mono px-2 py-0.5"
                    style={`color:${item.accent}99;border:1px solid ${item.accent}22;`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
              {item.href && item.href !== "#" && (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[10px] font-mono font-bold mt-1 no-underline"
                  style={`color:${item.accent};`}
                >
                  View project →
                </a>
              )}
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-[10px] font-mono">
        <a
          href="/#projects"
          class="no-underline"
          style={`color:${config.accent};`}
          >See all projects on the homepage →</a
        >
      </p>
    </CyberSection>

    <!-- FAQ -->
    <CyberSection id="faq">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style={`color:${config.accent}73;`}
      >
        // faq.open()
      </p>
      <h2
        class="text-3xl sm:text-4xl font-black leading-none tracking-tight mb-8 sm:mb-10"
        style="font-family:'Courier New',monospace;color:rgba(255,255,255,0.9);"
      >
        Frequently Asked Questions
      </h2>
      <div class="flex flex-col gap-3">
        {
          config.faqs.map((faq) => (
            <details
              class="landing-faq group"
              style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));"
            >
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 p-4 sm:p-5 text-left">
                <h3
                  class="text-xs sm:text-sm font-black font-mono pr-2"
                  style="color:rgba(255,255,255,0.8);"
                >
                  {faq.question}
                </h3>
                <span
                  class="text-sm font-mono flex-shrink-0 transition-transform group-open:rotate-45"
                  style={`color:${config.accent};`}
                >
                  +
                </span>
              </summary>
              <div class="px-4 sm:px-5 pb-4 sm:pb-5">
                <p
                  class="text-[10px] sm:text-[11px] font-mono leading-relaxed"
                  style="color:rgba(255,255,255,0.38);"
                >
                  {faq.answer}
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </CyberSection>

    <!-- RELATED -->
    <CyberSection id="related">
      <p
        class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3"
        style={`color:${config.accent}73;`}
      >
        // related.links()
      </p>
      <h2
        class="text-2xl sm:text-3xl font-black font-mono mb-6"
        style="color:rgba(255,255,255,0.88);"
      >
        Related Services & Reading
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
        {
          config.relatedServices.map((link) => (
            <a
              href={link.href}
              class="block p-4 no-underline transition-all hover:-translate-y-0.5"
              style={`background:rgba(255,255,255,0.02);border:1px solid ${config.accent}18;clip-path:polygon(0 0,calc(100% - 8px) 0,100% 8px,100% 100%,8px 100%,0 calc(100% - 8px));`}
            >
              <span
                class="text-xs font-black font-mono block mb-1"
                style={`color:${config.accent};`}
              >
                {link.label}
              </span>
              {link.desc && (
                <span
                  class="text-[10px] font-mono"
                  style="color:rgba(255,255,255,0.3);"
                >
                  {link.desc}
                </span>
              )}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-2">
        {
          config.relatedReads.map((link) => (
            <a
              href={link.href}
              class="text-[10px] sm:text-[11px] font-mono no-underline hover:underline"
              style="color:rgba(255,255,255,0.4);"
            >
              → {link.label}
            </a>
          ))
        }
      </div>
    </CyberSection>

    <ContactSection />
  </div>
</Layout>

<style>
  .landing-faq summary::-webkit-details-marker {
    display: none;
  }
