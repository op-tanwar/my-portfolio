<!-- ════════════ BLIEX SCROLL ANIMATION & TOGGLE SCRIPT ════════════ -->
<script is:inline>
  (function () {
    // 1. Entrance reveal for Heading [data-scroll-01] and Toggle [data-scroll-02]
    const scroll01 = document.querySelector('[data-scroll-01]');
    const scroll02 = document.querySelector('[data-scroll-02]');

    if (scroll01) {
      scroll01.style.opacity = '0';
      scroll01.style.transform = 'translateY(48px)';
      scroll01.style.transition = 'opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1)';
    }
    if (scroll02) {
      scroll02.style.opacity = '0';
      scroll02.style.transform = 'translateY(48px)';
      scroll02.style.transition = 'opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.15s';
    }

    const headerObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (scroll01) {
            scroll01.style.opacity = '1';
            scroll01.style.transform = 'translateY(0px)';
          }
          if (scroll02) {
            scroll02.style.opacity = '1';
            scroll02.style.transform = 'translateY(0px)';
          }
          headerObserver.disconnect();
        }
      });
    }, { threshold: 0.15 });

    const headerWrapper = document.querySelector('.common-heading-main-wrapper');
    if (headerWrapper) headerObserver.observe(headerWrapper);

    // 2. Interactive Toggle Switcher (Stack vs 4-Step Process)
    const btnStack = document.getElementById('btn-tech-stack');
    const btnProcess = document.getElementById('btn-delivery-process');
    const gridStack = document.getElementById('grid-tech-stack');
    const gridProcess = document.getElementById('grid-delivery-process');

    function setActiveTab(tab) {
      if (tab === 'stack') {
        btnStack.classList.add('bg-white', 'text-zinc-950', 'shadow-md', 'active');
        btnStack.classList.remove('text-white/60', 'bg-transparent');
        btnStack.setAttribute('aria-pressed', 'true');

        btnProcess.classList.remove('bg-white', 'text-zinc-950', 'shadow-md', 'active');
        btnProcess.classList.add('text-white/60', 'bg-transparent');
        btnProcess.setAttribute('aria-pressed', 'false');

        if (gridStack && gridProcess) {
          gridProcess.classList.add('hidden');
          gridStack.classList.remove('hidden');
          gridStack.style.opacity = '0';
          setTimeout(() => {
            gridStack.style.opacity = '1';
          }, 20);
        }
      } else {
        btnProcess.classList.add('bg-white', 'text-zinc-950', 'shadow-md', 'active');
        btnProcess.classList.remove('text-white/60', 'bg-transparent');
        btnProcess.setAttribute('aria-pressed', 'true');

        btnStack.classList.remove('bg-white', 'text-zinc-950', 'shadow-md', 'active');
        btnStack.classList.add('text-white/60', 'bg-transparent');
        btnStack.setAttribute('aria-pressed', 'false');

        if (gridStack && gridProcess) {
          gridStack.classList.add('hidden');
          gridProcess.classList.remove('hidden');
          gridProcess.style.opacity = '0';
          setTimeout(() => {
            gridProcess.style.opacity = '1';
          }, 20);
        }
      }
      applyScrollScrub();
    }

    if (btnStack && btnProcess) {
      btnStack.addEventListener('click', () => setActiveTab('stack'));
      btnProcess.addEventListener('click', () => setActiveTab('process'));
    }

    // 3. Signature Bliex Scrub Scroll Animation on Desktop (width >= 992px)
    // Left card: x 250px -> 0px, scale 0.9 -> 1, opacity 0.5 -> 1
    // Center card: scale 1.1 -> 1.0
    // Right card: x -250px -> 0px, scale 0.9 -> 1, opacity 0.5 -> 1
    function applyScrollScrub() {
      const activeGrid = document.querySelector('.pricing-grid:not(.hidden)');
      if (!activeGrid) return;

      const cardOne = activeGrid.querySelector('[data-pricing-div="one"]');
      const cardTwo = activeGrid.querySelector('[data-pricing-div="two"]');
      const cardThree = activeGrid.querySelector('[data-pricing-div="three"]');

      if (window.innerWidth < 992) {
        // Reset transforms on tablet/mobile for standard responsive layout
        if (cardOne) { cardOne.style.transform = ''; cardOne.style.opacity = ''; }
        if (cardTwo) { cardTwo.style.transform = ''; }
        if (cardThree) { cardThree.style.transform = ''; cardThree.style.opacity = ''; }
        return;
      }

      const rect = activeGrid.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const startTrigger = windowHeight * 0.85; // when top reaches 85% of viewport
      const endTrigger = windowHeight * 0.35;   // when top reaches 35% of viewport

      // Normalized progress clamped [0, 1]
      let progress = (startTrigger - rect.top) / (startTrigger - endTrigger);
      progress = Math.max(0, Math.min(1, progress));

      // Ease out cubic progress for smooth feel
      const eased = 1 - Math.pow(1 - progress, 3);

      const xOne = 250 * (1 - eased);
      const scaleOne = 0.9 + 0.1 * eased;
      const opacityOne = 0.5 + 0.5 * eased;

      const scaleTwo = 1.1 - 0.1 * eased;

      const xThree = -250 * (1 - eased);
      const scaleThree = 0.9 + 0.1 * eased;
      const opacityThree = 0.5 + 0.5 * eased;

      if (cardOne) {
        cardOne.style.transform = `translate3d(${xOne.toFixed(2)}px, 0px, 0px) scale(${scaleOne.toFixed(4)})`;
        cardOne.style.opacity = opacityOne.toFixed(3);
      }
      if (cardTwo) {
        cardTwo.style.transform = `scale(${scaleTwo.toFixed(4)})`;
      }
      if (cardThree) {
        cardThree.style.transform = `translate3d(${xThree.toFixed(2)}px, 0px, 0px) scale(${scaleThree.toFixed(4)})`;
        cardThree.style.opacity = opacityThree.toFixed(3);
      }
    }

    let ticking = false;
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          applyScrollScrub();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', applyScrollScrub, { passive: true });
    
    // Initial run
    applyScrollScrub();
  })();
</script>

<style>
  /* Hairline and backdrop treatments matching Bliex */
  .pricing-toggle-wrapper {
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08);
  }
  .pricing-card {
    will-change: transform, opacity;
  }
</style>
