---
// TechAndProcessSection.astro — Bliex-Grade Interactive Engineering Stack & 4-Step Delivery Framework
// Replicating Bliex's "Get started for free and see the possibilities" section animation and card design

import { Image } from "astro:assets";
import reactIcon from "../../assets/icons/react-developer.svg";
import nextIcon from "../../assets/icons/next.js-developer.svg";
import astroIcon from "../../assets/icons/AstroJs-developer.svg";
import tsIcon from "../../assets/icons/typescript-developer.svg";
import jsIcon from "../../assets/icons/javaScript-developer.svg";
import tailwindIcon from "../../assets/icons/tailwind-expret.svg";
import reduxIcon from "../../assets/icons/Redux.svg";
import sanityIcon from "../../assets/icons/Sanity.svg";
import nodeIcon from "../../assets/icons/node.svg";
import expressIcon from "../../assets/icons/express.svg";
import mongoIcon from "../../assets/icons/mongodb.svg";
import jwtIcon from "../../assets/icons/jwt.svg";
import apiIcon from "../../assets/icons/rest-api.svg";
import figmaIcon from "../../assets/icons/figma-to-code.svg";

// Technical Arsenal Categories (All 100% Preserved)
const techStackCards = [
  {
    divId: "one",
    badge: "Islands & Components",
    title: "Frontend & Islands",
    metric: "Sub-Second LCP",
    subMetric: "Zero-JS Defaults",
    ctaText: "Explore Frontend Work",
    ctaLink: "#work",
    ctaSubtext: "Astro v5 & Next.js 15",
    skills: [
      { name: "Astro v5 (Islands Architecture)", icon: astroIcon },
      { name: "Next.js 15 (App Router & Actions)", icon: nextIcon },
      { name: "React 19 & TypeScript Strict", icon: reactIcon },
      { name: "Tailwind CSS v4 & Figma Tokens", icon: tailwindIcon },
      { name: "JavaScript (Modern ES6+ Standards)", icon: jsIcon },
    ],
  },
  {
    divId: "two",
    badge: "Enterprise Ledgers & APIs",
    title: "Full-Stack & E-Commerce",
    metric: "High Concurrency",
    subMetric: "Stripe & Razorpay Webhooks",
    ctaText: "Book Architecture Call",
    ctaLink: "#contact",
    ctaSubtext: "Production-Tested Backends",
    skills: [
      { name: "Node.js & Express RESTful APIs", icon: nodeIcon },
      { name: "MongoDB (2dsphere geospatial)", icon: mongoIcon },
      { name: "Redis In-Memory Caching & Streams", icon: apiIcon },
      { name: "Stripe Connect & Razorpay APIs", icon: jwtIcon },
      { name: "TanStack Query & Data Streaming", icon: reactIcon },
      { name: "Redux Toolkit & Real-Time Sockets", icon: reduxIcon },
    ],
  },
  {
    divId: "three",
    badge: "Edge Delivery & Privacy",
    title: "Cloud, CMS & Performance",
    metric: "100/100 Lighthouse",
    subMetric: "GDPR & WCAG 2.1 AA",
    ctaText: "Inquire Architecture",
    ctaLink: "#contact",
    ctaSubtext: "Global Edge Infrastructure",
    skills: [
      { name: "Sanity.io Headless CMS Architecture", icon: sanityIcon },
      { name: "Technical & Programmatic SEO", icon: astroIcon },
      { name: "Vercel Edge Networks Global CDN", icon: nextIcon },
      { name: "Automated CI/CD Pipelines & Git", icon: tsIcon },
      { name: "Figma Design Tokens to Code", icon: figmaIcon },
      { name: "Zero Cookie Bloat & GDPR Analytics", icon: apiIcon },
    ],
  },
];

// 4-Step Engineering Workflow (All 100% Preserved)
const workflowCards = [
  {
    divId: "one",
    stepBadge: "Step 01",
    title: "Scope & Architecture",
    metric: "Phase 01",
    subMetric: "Pre-Sprint Blueprint",
    ctaText: "Scope Your Architecture",
    ctaLink: "#contact",
    ctaSubtext: "Zero Surprises Guarantee",
    deliverables: [
      "Unpack business requirements & user stories",
      "Model relational & MongoDB database schemas",
      "Define sub-1s performance & bundle budgets",
      "Establish strict TypeScript interface contracts",
      "Wireframe interactive state architectures",
    ],
  },
  {
    divId: "two",
    stepBadge: "Steps 02-03",
    title: "Sprints & QA Staging",
    metric: "Phases 02 & 03",
    subMetric: "Transparent Execution",
    ctaText: "Start a Project Sprint",
    ctaLink: "#contact",
    ctaSubtext: "Daily Automated Previews",
    deliverables: [
      "Rapid iterative development in modular TypeScript",
      "Async updates via Linear, GitHub PRs & Slack",
      "Automated preview URLs deployed on every branch",
      "Rigorous cross-device testing (Mobile, Tablet, 4K)",
      "Continuous milestone reviews & client verification",
    ],
  },
  {
    divId: "three",
    stepBadge: "Step 04",
    title: "Handoff & Support",
    metric: "Phase 04",
    subMetric: "14-Day Post-Launch Warranty",
    ctaText: "Check Availability",
    ctaLink: "#contact",
    ctaSubtext: "40 hrs/wk CET / GMT / EST",
    deliverables: [
      "Zero-downtime production deployment to Vercel/Edge",
      "Core Web Vitals audit verification (100/100)",
      "Clean TypeScript handoff & recorded walkthroughs",
      "14 days of dedicated post-launch bug warranty",
      "GDPR & WCAG 2.1 AA compliance sign-off",
    ],
  },
];
---

<section id="process" class="py-24 sm:py-32 relative scroll-mt-20 overflow-hidden">
  <!-- Anchor aliases for skills and about -->
  <div id="about" class="sr-only">About</div>
  <div id="skills" class="sr-only">Skills</div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- ════════════ BLIEX HEADING WRAPPER ════════════ -->
    <div class="common-heading-main-wrapper text-center mb-12 sm:mb-16">
      
      <!-- Eyebrow & Title (data-scroll-01) -->
      <div data-scroll-01 class="pricing-heading-div mx-auto max-w-3xl transition-all duration-700 ease-out">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-xs font-mono text-zinc-300 mb-5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF3700] animate-pulse"></span>
          Engineering Stack & 4-Step Delivery Framework
        </div>
        
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-[-0.03em] leading-[1.1] mb-5">
          Modern stack. <span class="text-white/50">Disciplined execution.</span>
        </h2>
        
        <p class="text-sm sm:text-base text-zinc-400 max-w-xl mx-auto leading-relaxed">
          From architectural blueprint to production deployment. No bloat, no percentage gimmicks—only battle-tested tools and dependable delivery.
        </p>
      </div>

      <!-- Toggle Wrapper (data-scroll-02) -->
      <div data-scroll-02 class="pricing-toggle-wrapper mt-8 sm:mt-10 inline-flex items-center p-1.5 rounded-full bg-white/[0.06] border border-white/[0.1] backdrop-blur-md transition-all duration-700 ease-out">
        <button
          id="btn-tech-stack"
          type="button"
          class="pricing-toggle-div monthly-toggle active px-6 sm:px-8 py-3 rounded-full text-xs sm:text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer select-none bg-white text-zinc-950 shadow-md"
          aria-pressed="true"
        >
          Engineering Stack
        </button>
        <button
          id="btn-delivery-process"
          type="button"
          class="pricing-toggle-div yearly-toggle px-6 sm:px-8 py-3 rounded-full text-xs sm:text-sm font-semibold tracking-wide transition-all duration-300 cursor-pointer select-none text-white/60 hover:text-white bg-transparent"
          aria-pressed="false"
        >
          4-Step Delivery Process
        </button>
      </div>

    </div>

    <!-- ════════════ BLIEX PRICING GRID (3 CARDS WITH SCRUB ANIMATION) ════════════ -->
    <div data-scroll-03 class="pricing-grid-container relative">
      
      <!-- ─── TAB 1: TECH STACK GRID ─── -->
      <div id="grid-tech-stack" class="pricing-grid grid grid-cols-1 lg:grid-cols-3 gap-3 lg:gap-3.5 items-stretch transition-opacity duration-300">
        
        <!-- CARD 1 (LEFT: FRONTEND & ISLANDS) -->
        <div data-pricing-div="one" class="pricing-div w-full will-change-transform">
          <div class="pricing-card h-full p-8 sm:p-10 lg:p-11 rounded-[32px] sm:rounded-[40px] bg-[#181818] border border-white/[0.08] hover:border-white/[0.16] transition-all duration-300 flex flex-col justify-between gap-8 group">
            
            <div class="common-heading-wrapper space-y-6">
              <!-- Geometric Bliex Wave SVG Icon -->
              <div class="pricing-icon w-14 h-14 sm:w-16 sm:h-16 text-white/50 group-hover:text-white transition-colors">
                <svg viewBox="0 0 64 64" fill="none" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                  <path d="M55.54 38.3151C55.8789 38.7216 56.0429 39.2459 55.9961 39.773C55.9492 40.3002 55.6953 40.7873 55.29 41.1276C50.95 44.7226 47.075 46.0001 43.54 46.0001C38.895 46.0001 34.835 43.7976 31.0575 41.7501C24.72 38.3126 19.2475 35.3426 11.29 41.9351C11.0894 42.1129 10.8552 42.2486 10.6011 42.3341C10.3471 42.4195 10.0785 42.4531 9.81124 42.4327C9.54399 42.4123 9.28356 42.3384 9.04543 42.2154C8.8073 42.0924 8.59632 41.9228 8.42503 41.7166C8.25374 41.5105 8.12564 41.272 8.04833 41.0154C7.97101 40.7587 7.94608 40.4892 7.97499 40.2227C8.0039 39.9563 8.08608 39.6983 8.21664 39.4643C8.3472 39.2302 8.52347 39.0247 8.73499 38.8601C18.7775 30.5426 26.315 34.6301 32.9675 38.2401C39.305 41.6776 44.7775 44.6451 52.735 38.0526C53.1426 37.7175 53.6662 37.557 54.1916 37.6062C54.717 37.6553 55.2016 37.9102 55.54 38.3151ZM11.29 25.9501C19.2475 19.3576 24.72 22.3251 31.0575 25.7626C34.835 27.8126 38.895 30.0126 43.54 30.0126C47.075 30.0126 50.95 28.7351 55.29 25.1401C55.5015 24.9755 55.6778 24.7701 55.8083 24.536C55.9389 24.3019 56.0211 24.044 56.05 23.7775C56.0789 23.5111 56.054 23.2415 55.9767 22.9849C55.8994 22.7282 55.7712 22.4898 55.6 22.2836C55.4287 22.0775 55.2177 21.9078 54.9796 21.7848C54.7414 21.6618 54.481 21.5879 54.2138 21.5676C53.9465 21.5472 53.6779 21.5807 53.4239 21.6662C53.1698 21.7517 52.9356 21.8873 52.735 22.0651C44.7775 28.6576 39.305 25.6876 32.9675 22.2501C26.315 18.6426 18.7775 14.5526 8.73499 22.8701C8.35942 23.217 8.13091 23.6944 8.09641 24.2045C8.06191 24.7145 8.22403 25.2184 8.54947 25.6127C8.87492 26.0069 9.33897 26.2616 9.84632 26.3243C10.3537 26.3871 10.8658 26.2532 11.2775 25.9501H11.29Z" fill="currentColor"></path>
                </svg>
              </div>

              <!-- Headings -->
              <div class="common-heading-div">
                <div class="text-xs font-mono uppercase tracking-wider text-white/50 mb-1">
                  {techStackCards[0].badge}
                </div>
                <div class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                  {techStackCards[0].title}
                </div>
                <div class="text-sm font-mono text-zinc-300 mt-2">
                  <span class="text-white font-semibold">{techStackCards[0].metric}</span>
                  <span class="text-white/40"> · {techStackCards[0].subMetric}</span>
                </div>
              </div>

              <!-- Button CTA -->
              <div class="pricing-button-div flex flex-col gap-2 pt-2">
                <a
                  href={techStackCards[0].ctaLink}
                  class="w-full py-3 px-6 rounded-full bg-white text-zinc-950 font-semibold text-xs sm:text-sm hover:bg-zinc-200 transition-all text-center flex items-center justify-center gap-2 group-hover:scale-[1.01]"
                >
                  {techStackCards[0].ctaText} →
                </a>
                <div class="text-xs text-white/50 text-center font-mono">
                  {techStackCards[0].ctaSubtext}
                </div>
              </div>
            </div>

            <!-- Skills List with Bliex Orange Dots -->
            <div class="pricing-list-wrapper space-y-3 pt-6 border-t border-white/[0.08]">
              {techStackCards[0].skills.map((skill) => (
                <div class="pricing-list-div flex items-center gap-2.5">
                  <div class="w-2 flex items-center justify-center flex-shrink-0">
                    <svg width="6" height="6" viewBox="0 0 6 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="3" cy="3" r="3" fill="#FF3700"></circle>
                    </svg>
                  </div>
                  <div class="w-4 h-4 flex items-center justify-center flex-shrink-0">
                    <Image
                      src={skill.icon}
                      alt={`${skill.name} icon`}
                      width={16}
                      height={16}
                      class="w-3.5 h-3.5 object-contain opacity-80"
                      loading="lazy"
                    />
                  </div>
                  <div class="text-xs sm:text-sm text-zinc-200 font-medium">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>

        <!-- CARD 2 (CENTER / FEATURED / ACTIVE: FULL-STACK & E-COMMERCE) -->
        <div data-pricing-div="two" class="pricing-div position-relative w-full z-10 will-change-transform">
          <div class="pricing-card active h-full p-8 sm:p-10 lg:p-11 rounded-[32px] sm:rounded-[40px] bg-white text-zinc-950 shadow-[0_25px_60px_-15px_rgba(255,255,255,0.2)] transition-all duration-300 flex flex-col justify-between gap-8 group">
            
            <div class="common-heading-wrapper space-y-6">
              <!-- Geometric Bliex Pro Orange SVG Icon -->
              <div class="pricing-icon w-14 h-14 sm:w-16 sm:h-16">
                <svg viewBox="0 0 64 64" fill="none" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                  <path d="M42 24V36C42 36.5304 41.7893 37.0391 41.4142 37.4142C41.0392 37.7893 40.5304 38 40 38C39.4696 38 38.9609 37.7893 38.5858 37.4142C38.2107 37.0391 38 36.5304 38 36V28.8275L25.415 41.415C25.2292 41.6008 25.0086 41.7482 24.7658 41.8488C24.523 41.9494 24.2628 42.0011 24 42.0011C23.7372 42.0011 23.477 41.9494 23.2342 41.8488C22.9914 41.7482 22.7708 41.6008 22.585 41.415C22.3992 41.2292 22.2518 41.0086 22.1512 40.7658C22.0507 40.523 21.9989 40.2628 21.9989 40C21.9989 39.7372 22.0507 39.477 22.1512 39.2342C22.2518 38.9914 22.3992 38.7708 22.585 38.585L35.1725 26H28C27.4696 26 26.9609 25.7893 26.5858 25.4142C26.2107 25.0391 26 24.5304 26 24C26 23.4696 26.2107 22.9609 26.5858 22.5858C26.9609 22.2107 27.4696 22 28 22H40C40.5304 22 41.0392 22.2107 41.4142 22.5858C41.7893 22.9609 42 23.4696 42 24ZM58 32C58 37.1423 56.4751 42.1691 53.6182 46.4448C50.7613 50.7205 46.7007 54.053 41.9498 56.0209C37.1989 57.9887 31.9712 58.5036 26.9277 57.5004C21.8842 56.4972 17.2514 54.0209 13.6152 50.3848C9.97907 46.7486 7.50281 42.1159 6.49959 37.0723C5.49638 32.0288 6.01127 26.8011 7.97914 22.0502C9.94702 17.2994 13.2795 13.2387 17.5552 10.3818C21.8309 7.52487 26.8577 6 32 6C38.8934 6.00728 45.5024 8.74889 50.3767 13.6233C55.2511 18.4976 57.9927 25.1066 58 32ZM54 32C54 27.6488 52.7097 23.3953 50.2923 19.7775C47.875 16.1596 44.439 13.3398 40.419 11.6747C36.3991 10.0095 31.9756 9.57385 27.708 10.4227C23.4404 11.2716 19.5204 13.3669 16.4437 16.4437C13.3669 19.5204 11.2716 23.4404 10.4227 27.708C9.57386 31.9756 10.0095 36.3991 11.6747 40.419C13.3398 44.439 16.1596 47.8749 19.7775 50.2923C23.3953 52.7097 27.6488 54 32 54C37.8327 53.9934 43.4247 51.6734 47.5491 47.549C51.6734 43.4247 53.9934 37.8327 54 32Z" fill="#FF3700"></path>
                </svg>
              </div>

              <!-- Headings -->
              <div class="common-heading-div">
                <div class="text-xs font-mono uppercase tracking-wider text-zinc-500 mb-1 font-semibold">
                  {techStackCards[1].badge}
                </div>
                <div class="text-2xl sm:text-3xl font-extrabold text-zinc-950 tracking-tight">
                  {techStackCards[1].title}
                </div>
                <div class="text-sm font-mono text-zinc-700 mt-2">
                  <span class="text-zinc-950 font-bold">{techStackCards[1].metric}</span>
                  <span class="text-zinc-500"> · {techStackCards[1].subMetric}</span>
                </div>
              </div>

              <!-- Button CTA -->
              <div class="pricing-button-div flex flex-col gap-2 pt-2">
                <a
                  href={techStackCards[1].ctaLink}
                  class="w-full py-3 px-6 rounded-full bg-zinc-950 text-white font-semibold text-xs sm:text-sm hover:bg-zinc-800 transition-all text-center flex items-center justify-center gap-2 shadow-lg group-hover:scale-[1.01]"
                >
                  {techStackCards[1].ctaText} →
                </a>
                <div class="text-xs text-zinc-500 text-center font-mono">
                  {techStackCards[1].ctaSubtext}
                </div>
              </div>
            </div>

            <!-- Skills List with Bliex Orange Dots -->
            <div class="pricing-list-wrapper space-y-3 pt-6 border-t border-zinc-200">
              {techStackCards[1].skills.map((skill) => (
                <div class="pricing-list-div flex items-center gap-2.5">
                  <div class="w-2 flex items-center justify-center flex-shrink-0">
                    <svg width="6" height="6" viewBox="0 0 6 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="3" cy="3" r="3" fill="#FF3700"></circle>
                    </svg>
                  </div>
                  <div class="w-4 h-4 flex items-center justify-center flex-shrink-0">
                    <Image
                      src={skill.icon}
                      alt={`${skill.name} icon`}
                      width={16}
                      height={16}
                      class="w-3.5 h-3.5 object-contain"
                      loading="lazy"
                    />
                  </div>
                  <div class="text-xs sm:text-sm text-zinc-900 font-semibold">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>

        <!-- CARD 3 (RIGHT: CLOUD, CMS & SEO) -->
        <div data-pricing-div="three" class="pricing-div w-full will-change-transform">
          <div class="pricing-card h-full p-8 sm:p-10 lg:p-11 rounded-[32px] sm:rounded-[40px] bg-[#181818] border border-white/[0.08] hover:border-white/[0.16] transition-all duration-300 flex flex-col justify-between gap-8 group">
            
            <div class="common-heading-wrapper space-y-6">
              <!-- Geometric Bliex Star SVG Icon -->
              <div class="pricing-icon w-14 h-14 sm:w-16 sm:h-16 text-white/50 group-hover:text-white transition-colors">
                <svg viewBox="0 0 64 64" fill="none" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                  <path d="M53.7149 45.03C53.5797 45.2559 53.4012 45.453 53.1897 45.6097C52.9781 45.7665 52.7377 45.88 52.4822 45.9436C52.2267 46.0073 51.9612 46.0199 51.7008 45.9806C51.4404 45.9414 51.1903 45.8511 50.9649 45.715L33.9999 35.5325V54C33.9999 54.5304 33.7892 55.0391 33.4142 55.4142C33.0391 55.7893 32.5304 56 31.9999 56C31.4695 56 30.9608 55.7893 30.5857 55.4142C30.2107 55.0391 29.9999 54.5304 29.9999 54V35.5325L13.0299 45.715C12.8046 45.8534 12.5541 45.9458 12.2929 45.9867C12.0317 46.0277 11.7649 46.0165 11.508 45.9537C11.2512 45.8909 11.0093 45.7778 10.7965 45.6209C10.5836 45.464 10.404 45.2665 10.2679 45.0397C10.1319 44.8129 10.0422 44.5615 10.004 44.2998C9.96581 44.0382 9.97988 43.7715 10.0454 43.5154C10.1109 43.2592 10.2266 43.0185 10.3857 42.8073C10.5448 42.5961 10.7443 42.4186 10.9724 42.285L28.1124 32L10.9724 21.715C10.7443 21.5814 10.5448 21.4039 10.3857 21.1927C10.2266 20.9815 10.1109 20.7408 10.0454 20.4847C9.97988 20.2285 9.96581 19.9618 10.004 19.7002C10.0422 19.4385 10.1319 19.1871 10.2679 18.9603C10.404 18.7335 10.5836 18.536 10.7965 18.3791C11.0093 18.2222 11.2512 18.1091 11.508 18.0463C11.7649 17.9835 12.0317 17.9723 12.2929 18.0133C12.5541 18.0542 12.8046 18.1466 13.0299 18.285L29.9999 28.4675V10C29.9999 9.46957 30.2107 8.96086 30.5857 8.58579C30.9608 8.21071 31.4695 8 31.9999 8C32.5304 8 33.0391 8.21071 33.4142 8.58579C33.7892 8.96086 33.9999 9.46957 33.9999 10V28.4675L50.9699 18.285C51.1952 18.1466 51.4458 18.0542 51.707 18.0133C51.9682 17.9723 52.235 17.9835 52.4919 18.0463C52.7487 18.1091 52.9906 18.2222 53.2034 18.3791C53.4163 18.536 53.5959 18.7335 53.7319 18.9603C53.868 19.1871 53.9577 19.4385 53.9959 19.7002C54.0341 19.9618 54.02 20.2285 53.9545 20.4847C53.889 20.7408 53.7733 20.9815 53.6142 21.1927C53.4551 21.4039 53.2556 21.5814 53.0274 21.715L35.8874 32L53.0274 42.285C53.2529 42.42 53.4496 42.5981 53.6062 42.8092C53.7628 43.0202 53.8762 43.2601 53.9401 43.515C54.0039 43.77 54.0169 44.035 53.9783 44.2949C53.9397 44.5549 53.8502 44.8047 53.7149 45.03Z" fill="currentColor"></path>
                </svg>
              </div>

              <!-- Headings -->
              <div class="common-heading-div">
                <div class="text-xs font-mono uppercase tracking-wider text-white/50 mb-1">
                  {techStackCards[2].badge}
                </div>
                <div class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                  {techStackCards[2].title}
                </div>
                <div class="text-sm font-mono text-zinc-300 mt-2">
                  <span class="text-white font-semibold">{techStackCards[2].metric}</span>
                  <span class="text-white/40"> · {techStackCards[2].subMetric}</span>
                </div>
              </div>

              <!-- Button CTA -->
              <div class="pricing-button-div flex flex-col gap-2 pt-2">
                <a
                  href={techStackCards[2].ctaLink}
