---
// ContactSection.astro — High-Converting 2-Column Inquiry Form & Direct Channels

interface Props {
  email?: string;
  number?: number;
  upworkUrl?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  location?: string;
  web3formsKey?: string;
  defaultService?: string;
}

const {
  email = "optanwar10@gmail.com",
  number = 7440262928,
  upworkUrl = "https://www.upwork.com/freelancers/~013f75d3791e17fa5d",
  githubUrl = "https://github.com/optanwar",
  linkedinUrl = "https://www.linkedin.com/in/optanwar/",
  location = "Indore, India · Full CET / GMT / EST Working Overlap",
  web3formsKey = "38c0c762-35eb-4b81-8ff2-0ea707ccf88a",
  defaultService = "",
} = Astro.props;

const projectServices = [
  "Astro Website",
  "Next.js / React App",
  "Custom / Multi-Vendor E-Commerce",
  "Figma to Code / Audit",
];

const budgetRanges = [
  { label: "$1k - $3k", value: "$1,000 - $3,000" },
  { label: "$3k - $5k", value: "$3,000 - $5,000" },
  { label: "$5k - $10k", value: "$5,000 - $10,000" },
  { label: "$10k+", value: "$10,000+" },
];
---

<section id="contact" class="py-24 sm:py-32 relative scroll-mt-20">
  <!-- Hidden Access Key meta -->
  <meta id="w3f-key" data-key={web3formsKey} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- SECTION HEADER -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Direct Inquiry & Technical Consultation
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-[-0.03em]">
          Let's build something remarkable.
        </h2>
      </div>
      <p class="text-sm sm:text-base text-zinc-400 max-w-md leading-relaxed">
        Planning an upcoming launch or need a senior frontend engineer for your EU/UK team? Share your project requirements below.
      </p>
    </div>

    <!-- 2-COLUMN LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- ════════════ LEFT COLUMN: DIRECT CONTACT DETAILS ════════════ -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- AVAILABILITY & TIMEZONE CARD -->
        <div class="rounded-2xl bg-[#111114]/90 border border-white/[0.08] p-6 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
          <div class="flex items-center gap-2.5 mb-3">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
            </span>
            <span class="text-sm font-bold text-white">European & Global Working Hours</span>
          </div>

          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed mb-4">
            Available 40 hrs/week for contracts and retainers. Smooth overlap with London (GMT), Central Europe (CET/CEST), and US East Coast (EST). Async-first communication via Slack, Linear, and GitHub.
          </p>

          <div class="pt-3 border-t border-white/[0.06] text-xs font-mono text-zinc-400 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{location}</span>
          </div>
        </div>

        <!-- DIRECT EMAIL CLICK-TO-COPY -->
        <div class="rounded-2xl bg-[#111114]/90 border border-white/[0.08] p-6 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
          <div class="text-xs font-mono uppercase tracking-wider text-zinc-400 mb-2">Direct Email</div>
          <div class="flex items-center justify-between gap-3">
            <a
              href={`mailto:${email}`}
              class="text-sm sm:text-base font-bold font-mono text-white hover:text-emerald-400 transition-colors truncate"
            >
              {email}
            </a>

            <button
              id="copy-email-btn"
              type="button"
              data-email={email}
              class="px-3 py-1.5 rounded-lg bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-xs font-medium text-zinc-300 hover:text-white transition-all flex items-center gap-1.5 flex-shrink-0"
              aria-label="Copy email address"
            >
              <svg class="w-3.5 h-3.5 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <span id="copy-btn-label">Copy</span>
            </button>
          </div>
        </div>

        <!-- WHATSAPP FAST CHAT -->
        <a
          href={`https://wa.me/91${number}?text=${encodeURIComponent("Hi Omprakash, I reviewed your portfolio and would like to discuss a frontend project.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between p-5 rounded-2xl bg-[#111114]/90 border border-white/[0.08] hover:border-emerald-500/30 transition-all group shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]"
        >
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.52 3.48A11.82 11.82 0 0012.05 0C5.4 0 .01 5.39 0 12.05c0 2.12.55 4.2 1.6 6.04L0 24l6.1-1.6a11.96 11.96 0 005.95 1.53h.01c6.66 0 12.05-5.39 12.05-12.05 0-3.22-1.26-6.25-3.59-8.4zM12.06 21.3a9.2 9.2 0 01-4.68-1.28l-.33-.2-3.62.95.97-3.53-.21-.36a9.2 9.2 0 01-1.4-4.9c0-5.1 4.16-9.26 9.27-9.26 2.47 0 4.8.96 6.55 2.7a9.2 9.2 0 012.7 6.55c0 5.11-4.16 9.27-9.25 9.27zm5.2-6.94c-.28-.14-1.66-.82-1.92-.91-.26-.1-.45-.14-.64.14-.19.28-.73.91-.9 1.1-.17.19-.33.21-.61.07-.28-.14-1.2-.44-2.29-1.4-.85-.75-1.43-1.67-1.6-1.95-.17-.28-.02-.43.12-.57.13-.13.28-.33.42-.5.14-.17.19-.28.28-.47.1-.19.05-.36-.02-.5-.07-.14-.64-1.54-.88-2.11-.23-.55-.47-.47-.64-.48h-.55c-.19 0-.5.07-.76.36-.26.28-1 1-.98 2.43.02 1.43 1.03 2.81 1.18 3 .14.19 2.04 3.11 4.95 4.36.69.3 1.23.48 1.65.61.69.22 1.31.19 1.8.12.55-.08 1.66-.68 1.9-1.34.24-.66.24-1.22.17-1.34-.07-.12-.26-.19-.55-.33z"/>
              </svg>
            </div>
            <div>
              <div class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">Chat on WhatsApp</div>
              <div class="text-xs text-zinc-400">Direct message · Typical reply &lt; 2 hrs</div>
            </div>
          </div>
          <svg class="w-4 h-4 text-zinc-500 group-hover:text-emerald-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- VERIFIED PROFILE TILES -->
        <div class="grid grid-cols-3 gap-3">
          <a
            href={upworkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center justify-center p-4 rounded-xl bg-[#111114]/90 border border-white/[0.08] hover:border-emerald-500/30 transition-all text-center group"
          >
            <span class="text-xs font-bold text-zinc-200 group-hover:text-emerald-400 transition-colors">Upwork</span>
            <span class="text-[10px] font-mono text-emerald-400/90 mt-0.5">Top Rated</span>
          </a>

          <a
            href={linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center justify-center p-4 rounded-xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all text-center group"
          >
            <span class="text-xs font-bold text-zinc-200 group-hover:text-white transition-colors">LinkedIn</span>
            <span class="text-[10px] font-mono text-zinc-400 mt-0.5">Profile</span>
          </a>

          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center justify-center p-4 rounded-xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all text-center group"
          >
            <span class="text-xs font-bold text-zinc-200 group-hover:text-white transition-colors">GitHub</span>
            <span class="text-[10px] font-mono text-zinc-400 mt-0.5">Repositories</span>
          </a>
        </div>

      </div>

      <!-- ════════════ RIGHT COLUMN: VALIDATED INQUIRY FORM ════════════ -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl bg-[#111114]/90 border border-white/[0.08] p-6 sm:p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
          
          <div class="pb-4 mb-6 border-b border-white/[0.06] flex items-center justify-between">
            <h3 class="text-lg font-bold text-white tracking-tight">
              Project Inquiry Brief
            </h3>
            <span class="text-xs font-mono text-zinc-400">Fixed-price or dedicated sprint</span>
          </div>

          <!-- SUCCESS STATE -->
          <div id="form-success" class="hidden flex-col items-center justify-center py-12 text-center">
            <div class="w-14 h-14 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h4 class="text-xl font-bold text-white mb-2">Message Received</h4>
            <p class="text-sm text-zinc-400 max-w-sm">
              Thank you! I have received your project details and will review and reply within 24 hours.
            </p>
          </div>

          <!-- ERROR STATE -->
          <div id="form-error" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-medium mb-6">
            <span id="error-msg">Something went wrong. Please try again or reach out via email.</span>
          </div>

          <!-- FORM FIELDS -->
          <form id="contact-form" class="space-y-6">
            
            <!-- NAME & EMAIL -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="cf-name" class="block text-xs font-medium text-zinc-300 mb-1.5">
                  Your Name <span class="text-emerald-400">*</span>
                </label>
                <input
                  id="cf-name"
                  name="name"
                  type="text"
                  required
                  placeholder="e.g. Alex Mercer"
                  class="w-full px-4 py-3 rounded-xl bg-zinc-950/80 border border-white/[0.08] focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 text-sm text-white placeholder-zinc-500 outline-none transition-all"
                />
              </div>

              <div>
                <label for="cf-email" class="block text-xs font-medium text-zinc-300 mb-1.5">
                  Work Email <span class="text-emerald-400">*</span>
                </label>
                <input
                  id="cf-email"
                  name="email"
                  type="email"
                  required
                  placeholder="alex@company.com"
                  class="w-full px-4 py-3 rounded-xl bg-zinc-950/80 border border-white/[0.08] focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 text-sm text-white placeholder-zinc-500 outline-none transition-all"
                />
              </div>
            </div>

            <!-- SERVICE / PROJECT TYPE PILLS -->
            <div>
              <label class="block text-xs font-medium text-zinc-300 mb-2">
                Project Service Needed
              </label>
              <div class="flex flex-wrap gap-2">
                {
                  projectServices.map((service) => {
                    const isSelected =
                      defaultService &&
                      (defaultService.toLowerCase() === service.toLowerCase() ||
                        service.toLowerCase().includes(defaultService.toLowerCase()) ||
                        defaultService.toLowerCase().includes(service.toLowerCase()));
                    return (
                      <button
                        type="button"
                        class={`project-type-pill px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
                          isSelected
                            ? "bg-emerald-500/10 border border-emerald-500/30 text-emerald-400"
                            : "bg-white/[0.03] text-zinc-400 border border-white/[0.06] hover:text-white hover:border-white/[0.14]"
                        }`}
                        data-value={service}
                      >
                        {service}
                      </button>
                    );
                  })
                }
              </div>
              <input
                type="hidden"
                id="cf-type"
                name="project_type"
                value={
                  projectServices.find(
                    (s) =>
                      defaultService &&
                      (defaultService.toLowerCase() === s.toLowerCase() ||
                        s.toLowerCase().includes(defaultService.toLowerCase()) ||
                        defaultService.toLowerCase().includes(s.toLowerCase()))
                  ) || defaultService || ""
                }
              />
            </div>

            <!-- BUDGET PILLS -->
            <div>
              <label class="block text-xs font-medium text-zinc-300 mb-2">
                Expected Budget Range
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                {
                  budgetRanges.map((budget) => (
                    <button
                      type="button"
                      class="budget-pill py-2 px-3 rounded-lg text-xs font-mono font-medium text-center bg-white/[0.03] text-zinc-400 border border-white/[0.06] hover:text-white hover:border-white/[0.14] transition-all"
                      data-value={budget.value}
                    >
                      {budget.label}
                    </button>
                  ))
                }
              </div>
              <input type="hidden" id="cf-budget" name="budget" value="" />
            </div>

            <!-- MESSAGE -->
            <div>
              <label for="cf-message" class="block text-xs font-medium text-zinc-300 mb-1.5">
                Project Scope & Requirements <span class="text-emerald-400">*</span>
              </label>
              <textarea
                id="cf-message"
                name="message"
                required
                rows="4"
                placeholder="Briefly describe what you're building, target launch timeline, technical requirements, or Figma links..."
                class="w-full px-4 py-3 rounded-xl bg-zinc-950/80 border border-white/[0.08] focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 text-sm text-white placeholder-zinc-500 outline-none transition-all resize-none"
              ></textarea>
              <div class="flex justify-end mt-1">
                <span id="char-count" class="text-[11px] font-mono text-zinc-500">0 / 600</span>
              </div>
            </div>

            <!-- SUBMIT BUTTON -->
            <button
              id="submit-btn"
              type="button"
              class="w-full py-3.5 px-6 rounded-xl font-semibold text-sm text-zinc-950 bg-white hover:bg-zinc-200 active:scale-[0.99] transition-all flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(255,255,255,0.15)] disabled:opacity-50 cursor-pointer"
            >
              <span id="btn-text">Submit Project Brief</span>
              <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
            </button>

            <p class="text-center text-[11px] text-zinc-400">
              Direct & confidential · NDA available upon request · Zero marketing spam
            </p>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  (function () {
    // ── Get Web3Forms access key ──
    const keyMeta = document.getElementById("w3f-key") as HTMLMetaElement | null;
    const ACCESS_KEY = keyMeta?.dataset.key ?? "";

    // ── DOM refs ──
    const copyEmailBtn = document.getElementById("copy-email-btn");
    const copyBtnLabel = document.getElementById("copy-btn-label");
    const typePills = document.querySelectorAll<HTMLButtonElement>(".project-type-pill");
    const typeInput = document.getElementById("cf-type") as HTMLInputElement | null;
    const budgetPills = document.querySelectorAll<HTMLButtonElement>(".budget-pill");
    const budgetInput = document.getElementById("cf-budget") as HTMLInputElement | null;
    const msgArea = document.getElementById("cf-message") as HTMLTextAreaElement | null;
    const charCount = document.getElementById("char-count");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const btnText = document.getElementById("btn-text");
    const btnIcon = document.getElementById("btn-icon");
    const btnSpinner = document.getElementById("btn-spinner");
    const formEl = document.getElementById("contact-form");
    const formSuccess = document.getElementById("form-success");
    const formError = document.getElementById("form-error");
    const errorMsg = document.getElementById("error-msg");

    // ── Click to copy email ──
    copyEmailBtn?.addEventListener("click", async () => {
      const email = copyEmailBtn.dataset.email;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        if (copyBtnLabel) copyBtnLabel.textContent = "Copied!";
        copyEmailBtn.classList.add("bg-emerald-500/20", "text-emerald-300");
        setTimeout(() => {
          if (copyBtnLabel) copyBtnLabel.textContent = "Copy";
          copyEmailBtn.classList.remove("bg-emerald-500/20", "text-emerald-300");
        }, 2000);
      } catch (e) {
        if (copyBtnLabel) copyBtnLabel.textContent = "Failed";
      }
    });

    // ── Project type pills ──
    typePills.forEach((pill) => {
      pill.addEventListener("click", () => {
        typePills.forEach((p) => {
          p.classList.remove("bg-emerald-500/10", "border-emerald-500/30", "text-emerald-400");
        });
        pill.classList.add("bg-emerald-500/10", "border-emerald-500/30", "text-emerald-400");
        if (typeInput) typeInput.value = pill.dataset.value ?? "";
      });
    });

    // ── Budget pills ──
    budgetPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        budgetPills.forEach((p) => {
          p.classList.remove("bg-emerald-500/10", "border-emerald-500/30", "text-emerald-400");
        });
        pill.classList.add("bg-emerald-500/10", "border-emerald-500/30", "text-emerald-400");
        if (budgetInput) budgetInput.value = pill.dataset.value ?? "";
      });
    });

    // ── Char count ──
    msgArea?.addEventListener("input", () => {
      const len = msgArea.value.length;
      if (charCount) charCount.textContent = `${len} / 600`;
      if (len > 600) msgArea.value = msgArea.value.slice(0, 600);
    });

    // ── Form submission ──
    submitBtn?.addEventListener("click", async () => {
      if (formError) formError.classList.add("hidden");

      const nameVal = (document.getElementById("cf-name") as HTMLInputElement)?.value.trim();
      const emailVal = (document.getElementById("cf-email") as HTMLInputElement)?.value.trim();
      const messageVal = msgArea?.value.trim();

      if (!nameVal || !emailVal || !messageVal) {
        if (formError && errorMsg) {
          formError.classList.remove("hidden");
          errorMsg.textContent = "Please fill in all required fields (Name, Email, Message).";
        }
        return;
      }

      // Loading state
      submitBtn.setAttribute("disabled", "true");
      if (btnText) btnText.textContent = "Sending Brief...";
      btnIcon?.classList.add("hidden");
      btnSpinner?.classList.remove("hidden");

      try {
        const payload = {
          access_key: ACCESS_KEY,
          subject: `Portfolio Project Inquiry from ${nameVal}`,
          from_name: nameVal,
          name: nameVal,
          email: emailVal,
          message: messageVal,
          project_type: typeInput?.value || "Not specified",
          budget: budgetInput?.value || "Not specified",
        };

        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          formEl?.classList.add("hidden");
          formSuccess?.classList.remove("hidden");
          formSuccess?.classList.add("flex");
        } else {
          submitBtn.removeAttribute("disabled");
          if (btnText) btnText.textContent = "Submit Project Brief";
          btnIcon?.classList.remove("hidden");
          btnSpinner?.classList.add("hidden");

          if (formError && errorMsg) {
            formError.classList.remove("hidden");
            errorMsg.textContent = data.message || "Submission failed. Please email directly at optanwar10@gmail.com";
          }
        }
      } catch (err) {
        submitBtn.removeAttribute("disabled");
        if (btnText) btnText.textContent = "Submit Project Brief";
        btnIcon?.classList.remove("hidden");
        btnSpinner?.classList.add("hidden");

        if (formError && errorMsg) {
          formError.classList.remove("hidden");
          errorMsg.textContent = "Network error. Please try again or reach out directly at optanwar10@gmail.com";
        }
      }
    });
  })();
</script>
