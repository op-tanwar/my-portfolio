---
import BlogCard from "../blog/BlogCard.astro";
import { getPublishedPosts, getPostAccent } from "../../lib/blog";

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
---

<section id="blog" class="blog-section relative py-20 sm:py-28 overflow-hidden" style="background:#020204;">

  <div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,255,247,0.005) 3px,rgba(0,255,247,0.005) 4px);" aria-hidden="true"></div>

  <div class="absolute top-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,rgba(0,255,247,0.2),rgba(191,0,255,0.15),transparent);" aria-hidden="true"></div>

  <div class="absolute top-8 left-4 sm:left-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px" style="background:linear-gradient(90deg,#00fff7,transparent);"></div>
    <div class="w-px h-10 sm:h-12" style="background:linear-gradient(180deg,#00fff7,transparent);"></div>
    <div class="absolute top-0 left-0 w-1.5 h-1.5 rounded-full" style="background:#00fff7;box-shadow:0 0 8px #00fff7;"></div>
  </div>
  <div class="absolute bottom-8 right-4 sm:right-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px ml-auto" style="background:linear-gradient(270deg,#bf00ff,transparent);"></div>
    <div class="w-px h-10 sm:h-12 ml-auto" style="background:linear-gradient(0deg,#bf00ff,transparent);"></div>
    <div class="absolute bottom-0 right-0 w-1.5 h-1.5 rounded-full" style="background:#bf00ff;box-shadow:0 0 8px #bf00ff;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-16">

    <div class="blog-header mb-10 sm:mb-16">
      <p class="text-[9px] sm:text-[10px] font-mono tracking-[0.35em] uppercase mb-2 sm:mb-3" style="color:rgba(0,255,247,0.45);">// blog.latest()</p>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-4">
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-none tracking-tight" style="font-family:'Courier New',monospace;">
          <span style="color:rgba(255,255,255,0.9);">Writing</span>
          <span class="block" style="background:linear-gradient(90deg,#00fff7,#bf00ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">& Thoughts_</span>
        </h2>
        <a href="/blog"
          class="view-all group inline-flex items-center gap-2 text-[10px] sm:text-xs font-bold font-mono tracking-[0.2em] uppercase transition-all duration-200 hover:-translate-y-0.5 sm:pb-2 w-fit"
          style="color:#00fff7;">
          View all posts
          <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
      <div class="mt-6 sm:mt-8 h-px w-full" style="background:linear-gradient(90deg,rgba(0,255,247,0.25),rgba(191,0,255,0.15),transparent);"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 mb-10 sm:mb-12" data-blog-grid>
      {posts.map((post, i) => (
        <BlogCard
          post={post}
          index={i}
          accent={getPostAccent(post, allPosts.indexOf(post))}
        />
      ))}
    </div>

    <div class="flex justify-center">
      <a href="/blog"
        class="blog-cta group inline-flex items-center gap-2.5 px-7 py-3.5 text-xs font-black tracking-[0.15em] uppercase font-mono transition-all duration-200 hover:-translate-y-0.5 no-underline"
        style="color:#00fff7;border:1px solid rgba(0,255,247,0.25);background:rgba(0,255,247,0.04);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));">
        All Articles
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>

  <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,rgba(191,0,255,0.2),rgba(0,255,247,0.15),transparent);" aria-hidden="true"></div>
</section>

<style>
.blog-header { animation:slideUp .6s cubic-bezier(.16,1,.3,1) both; animation-delay:.05s; }
@keyframes slideUp    { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
.blog-cta:hover  { border-color:rgba(0,255,247,0.4)!important; box-shadow:0 0 24px rgba(0,255,247,.15); }
</style>

<script>
(function(){
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      e.target.querySelectorAll<HTMLElement>('[data-blog-card]').forEach(card => {
        card.style.animationPlayState = 'running';
      });
      obs.unobserve(e.target);
    });
  }, { threshold: 0.08 });
  const grid = document.querySelector('[data-blog-grid]');
  if (grid) obs.observe(grid);
})();
</script>
