---
// ServicesSection.astro — 4-Card Bento Grid aligned with European & Global Search Intent

interface ServicePillar {
  id: string;
  title: string;
  tagline: string;
  metricBadge: string;
  description: string;
  deliverables: string[];
  techTags: string[];
  icon: string;
  landingUrl: string;
}

const services: ServicePillar[] = [
  {
    id: "01",
    title: "Astro.js & High-Converting Marketing Sites",
    tagline: "Instant page loads, maximum organic SEO conversion",
    metricBadge: "98–100 Lighthouse",
    landingUrl: "/hire-astro-developer",
    description:
      "Engineered for high-growth SaaS, European agencies, and startups that cannot afford slow page loads. WordPress-to-Astro migrations, zero-JS island architecture, and Sanity CMS setup for sub-second LCP and GDPR-compliant server analytics.",
    deliverables: [
      "WordPress to Astro v5 migrations with zero SEO rank loss",
      "Headless CMS integration (Sanity.io / Contentful / Strapi)",
      "Sub-0.8s LCP with zero client-side JavaScript baseline",
      "European GDPR-ready privacy architecture (zero cookie bloat)",
    ],
    techTags: ["Astro v5", "Sanity CMS", "Tailwind CSS v4", "Technical SEO", "TypeScript"],
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  },
  {
    id: "02",
    title: "React & Next.js Web Applications",
    tagline: "Scalable frontend architectures built without tech debt",
    metricBadge: "100% Type-Safe",
    landingUrl: "/hire-nextjs-developer",
    description:
      "Full-stack React and Next.js applications engineered with strict TypeScript patterns, clean state machines, and resilient architectures. Built for venture-backed founders needing rapid SaaS MVP launches and enterprise frontend refactors.",
    deliverables: [
      "Next.js App Router (Server Actions, SSR, ISR, Edge caching)",
      "Scalable state management (Redux Toolkit, Zustand, TanStack Query)",
      "Real-time WebSocket feeds & dynamic dashboard streaming",
      "Type-safe end-to-end API integrations & testing setup",
    ],
    techTags: ["Next.js 15", "React 19", "TypeScript", "Redux Toolkit", "WebSockets"],
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
  },
  {
    id: "03",
    title: "Custom E-Commerce & Multi-Vendor Marketplaces",
    tagline: "Full-stack storefronts with spatial discovery & payment ledger",
    metricBadge: "Zero Math Drift",
    landingUrl: "/custom-ecommerce-developer",
    description:
      "Bespoke e-commerce architectures and multi-vendor platforms. Complete implementation of geospatial store discovery (MongoDB 2dsphere), split multi-vendor cart sessions, Stripe & Razorpay payouts, and paise-safe double-entry ledger bookkeeping.",
    deliverables: [
      "Multi-vendor store architecture with split cart fulfillment",
      "MongoDB 2dsphere 12km geospatial radius filtering",
      "Stripe Connect & Razorpay webhook integration with HMAC validation",
      "Vendor sales portals, commission tracking & automated payouts",
    ],
    techTags: ["Next.js", "Node.js", "MongoDB 2dsphere", "Redis", "Stripe API", "Razorpay"],
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>`,
  },
  {
    id: "04",
    title: "Figma-to-Code & Core Web Vitals Audits",
    tagline: "Pixel-perfect implementation paired with deep performance recovery",
    metricBadge: "100/100 CWV Pass",
    landingUrl: "/figma-to-code-developer",
    description:
      "Bridging design fidelity and runtime performance for European agencies. 1:1 pixel-accurate Figma translation preserving design tokens, coupled with rigorous audits that rescue failing Core Web Vitals and reverse Google rank penalties.",
    deliverables: [
      "1:1 pixel-accurate Figma component translation across all devices",
      "Core Web Vitals deep-dive audit & code remediation roadmap",
      "Elimination of Cumulative Layout Shift (CLS = 0.00)",
      "WCAG 2.1 AA accessibility standards & fluid typography tokens",
    ],
    techTags: ["Figma Tokens", "Core Web Vitals", "Lighthouse 100", "Responsive QA", "WCAG AA"],
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
];
---

<section id="services" class="py-24 sm:py-32 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- SECTION HEADER -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-xs font-mono text-zinc-300 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Consulting & Engineering Pillars
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-[-0.03em]">
          Core services that drive tangible ROI.
        </h2>
      </div>
      <p class="text-sm sm:text-base text-zinc-400 max-w-md leading-relaxed">
        High-impact engineering solutions for European and US tech founders. Sub-second speed, clean TypeScript code, and dependable delivery.
      </p>
    </div>

    <!-- 4-PILLAR BENTO GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {
        services.map((service) => (
          <div class="flex flex-col justify-between rounded-2xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 p-6 sm:p-8 group shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
            
            <div>
              <!-- TOP ICON & METRIC BADGE -->
              <div class="flex items-center justify-between mb-6">
                <div class="w-12 h-12 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center group-hover:scale-110 group-hover:bg-emerald-500/10 group-hover:border-emerald-500/20 transition-all duration-300">
                  <div set:html={service.icon} />
                </div>
                <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400 font-medium">
                  {service.metricBadge}
                </span>
              </div>

              <!-- TITLE & SUBTITLE -->
              <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-2 group-hover:text-emerald-300 transition-colors">
                {service.title}
              </h3>
              <p class="text-xs font-mono text-emerald-400/80 mb-4">
                {service.tagline}
              </p>

              <!-- DESCRIPTION -->
              <p class="text-sm text-zinc-400 leading-relaxed mb-6">
                {service.description}
              </p>

              <!-- DELIVERABLES LIST -->
              <div class="space-y-2.5 mb-8">
                <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300 block mb-3 font-mono">
                  Deliverables & Technical Scope
                </span>
                {service.deliverables.map((item) => (
                  <div class="flex items-start gap-2.5 text-xs text-zinc-400">
                    <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- TECH CHIPS & CTA -->
            <div>
              <div class="pt-5 border-t border-white/[0.06] flex flex-wrap gap-1.5 mb-6">
                {service.techTags.map((tech) => (
                  <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-white/[0.03] text-zinc-300 border border-white/[0.06]">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-3">
                <a
                  href={service.landingUrl}
                  class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-white/[0.16] text-xs font-semibold text-zinc-200 hover:text-white transition-all group/btn flex-1 justify-center"
                >
                  <span>Explore Service</span>
                  <svg class="w-3.5 h-3.5 text-zinc-400 group-hover/btn:text-emerald-400 group-hover/btn:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <a
                  href="/#contact"
                  class="px-4 py-2.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-all text-center"
                >
                  Inquire
                </a>
              </div>
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>
