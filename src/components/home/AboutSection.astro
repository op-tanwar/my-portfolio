---
// AboutMe.astro — CYBERPUNK v3 · PERFECT RESPONSIVE
// Place after HeroSection or ProjectsSection

const features = [
  {
    id: "01",
    title: "Performance First",
    desc: "Sub-1s LCP, optimized Core Web Vitals, lazy loading, and efficient rendering strategies. Lighthouse 100 is the baseline, not the goal.",
    color: "#00fff7",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
  },
  {
    id: "02",
    title: "Clean Architecture",
    desc: "Scalable folder structure, reusable components, separation of concerns. Code written for the next developer, not just the compiler.",
    color: "#bf00ff",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
  },
  {
    id: "03",
    title: "Modern Stack",
    desc: "React, Next.js, Astro, TypeScript, Tailwind — chosen for speed, DX, and long-term maintainability. Zero bloat, full control.",
    color: "#ff006e",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>`,
  },
  {
    id: "04",
    title: "Pixel Perfect UI",
    desc: "Exact Figma-to-code with attention to every micro detail — spacing, easing, hover states. Designs that feel alive, not just static.",
    color: "#f7df1e",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`,
  },
];

const codeLines = [
  { indent: 0, content: `<span style="color:#bf00ff;">const</span> <span style="color:#00fff7;">developer</span> = {` },
  { indent: 1, content: `name: <span style="color:#f7df1e;">"Omprakash"</span>,` },
  { indent: 1, content: `role: <span style="color:#f7df1e;">"Frontend Dev"</span>,` },
  { indent: 1, content: `exp: <span style="color:#ff006e;">3</span>, <span style="color:rgba(255,255,255,0.25);">// years</span>` },
  { indent: 1, content: `stack: [<span style="color:#f7df1e;">"React"</span>, <span style="color:#f7df1e;">"Next"</span>, <span style="color:#f7df1e;">"Astro"</span>],` },
  { indent: 1, content: `jss: <span style="color:#ff006e;">100</span>, <span style="color:rgba(255,255,255,0.25);">// Upwork JSS %</span>` },
  { indent: 1, content: `available: <span style="color:#00fff7;">true</span>,` },
  { indent: 1, content: `remote: <span style="color:#00fff7;">true</span>,` },
  { indent: 0, content: `}` },
  { indent: 0, content: `` },
  { indent: 0, content: `<span style="color:#bf00ff;">export default</span> developer;` },
];
---

<section id="about" class="about-me-section relative py-20 sm:py-28 overflow-hidden" style="background:#020204;">

  <!-- Scanlines -->
  <div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,255,247,0.005) 3px,rgba(0,255,247,0.005) 4px);" aria-hidden="true"></div>

  <!-- Grid overlay -->
  <!-- <div class="absolute inset-0 opacity-[0.025] pointer-events-none" style="background-image:linear-gradient(rgba(0,255,247,1) 1px,transparent 1px),linear-gradient(90deg,rgba(0,255,247,1) 1px,transparent 1px);background-size:48px 48px;" aria-hidden="true"></div> -->

  <!-- Top separator -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,rgba(0,255,247,0.2),rgba(191,0,255,0.15),transparent);" aria-hidden="true"></div>

  <!-- Ambient glow -->
  <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at 15% 50%,rgba(0,255,247,0.04) 0%,transparent 50%),radial-gradient(ellipse at 85% 50%,rgba(191,0,255,0.04) 0%,transparent 50%);" aria-hidden="true"></div>

  <!-- Corner TL -->
  <div class="absolute top-8 left-4 sm:left-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px" style="background:linear-gradient(90deg,#00fff7,transparent);"></div>
    <div class="w-px h-10 sm:h-12" style="background:linear-gradient(180deg,#00fff7,transparent);"></div>
    <div class="absolute top-0 left-0 w-1.5 h-1.5 rounded-full" style="background:#00fff7;box-shadow:0 0 8px #00fff7;"></div>
  </div>
  <!-- Corner BR -->
  <div class="absolute bottom-8 right-4 sm:right-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px ml-auto" style="background:linear-gradient(270deg,#bf00ff,transparent);"></div>
    <div class="w-px h-10 sm:h-12 ml-auto" style="background:linear-gradient(0deg,#bf00ff,transparent);"></div>
    <div class="absolute bottom-0 right-0 w-1.5 h-1.5 rounded-full" style="background:#bf00ff;box-shadow:0 0 8px #bf00ff;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-16">

    <!-- ── HEADER ── -->
    <div class="about-header mb-10 sm:mb-16">
      <p class="text-[9px] sm:text-[10px] font-mono tracking-[0.3em] uppercase mb-2 sm:mb-3" style="color:rgba(0,255,247,0.4);">// about.me</p>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 sm:gap-4">
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-none tracking-tight" style="font-family:'Courier New',monospace;">
          <span style="color:rgba(255,255,255,0.9);">Building</span>
          <span class="block" style="background:linear-gradient(90deg,#00fff7,#bf00ff,#ff006e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Fast & Scalable_</span>
        </h2>
        <div class="flex items-center gap-3 sm:pb-2">
          <div class="h-px w-10 sm:w-16" style="background:linear-gradient(90deg,transparent,rgba(0,255,247,0.4));"></div>
          <span class="text-[9px] sm:text-[10px] font-mono tracking-widest uppercase" style="color:rgba(255,255,255,0.2);">Self-taught · 3+ yrs</span>
        </div>
      </div>
      <div class="mt-6 sm:mt-8 h-px w-full" style="background:linear-gradient(90deg,rgba(0,255,247,0.25),rgba(191,0,255,0.15),transparent);"></div>
    </div>

    <!-- ── MAIN GRID ── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start mb-10 sm:mb-14">

      <!-- LEFT — Bio + Code block -->
      <div class="about-left flex flex-col gap-5 sm:gap-6">

        <!-- Bio text -->
        <div>
          <p class="text-[9px] sm:text-[10px] font-mono tracking-[0.25em] uppercase mb-3 sm:mb-4" style="color:rgba(0,255,247,0.35);">// bio.read()</p>
          <p class="text-sm sm:text-base lg:text-lg leading-relaxed font-mono mb-3" style="color:rgba(255,255,255,0.75);">
            I'm a <span style="color:#00fff7;font-weight:900;">self-taught frontend developer</span> from Indore, India — building high-performance, visually precise web experiences for US, UK, and EU clients.
          </p>
          <p class="text-xs sm:text-sm leading-relaxed font-mono mb-3" style="color:rgba(255,255,255,0.38);border-left:2px solid rgba(0,255,247,0.2);padding-left:0.875rem;">
            With a background in <span style="color:rgba(255,255,255,0.65);">Computer Science (MCA)</span> and 3+ years of hands-on experience, I focus on writing clean, maintainable code and delivering high-performance applications. Currently Top Rated on Upwork with 100% JSS.
          </p>
          <p class="text-xs sm:text-sm leading-relaxed font-mono" style="color:rgba(255,255,255,0.38);border-left:2px solid rgba(191,0,255,0.2);padding-left:0.875rem;">
            I specialize in <span style="color:rgba(255,255,255,0.65);">React, Next.js, Astro</span> — with deep focus on performance, SEO, Stripe integrations, and real-time apps. Currently expanding into Framer motion + GSAP.
          </p>
        </div>

        <!-- Code block -->
        <div class="relative overflow-hidden" style="background:rgba(0,0,0,0.4);border:1px solid rgba(0,255,247,0.12);clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));">
          <!-- Top bar -->
          <div class="flex items-center justify-between px-3 sm:px-4 py-2.5" style="background:rgba(0,255,247,0.04);border-bottom:1px solid rgba(0,255,247,0.08);">
            <div class="flex items-center gap-1.5">
              <div class="w-2 h-2 rounded-full" style="background:#ff006e;opacity:0.7;"></div>
              <div class="w-2 h-2 rounded-full" style="background:#f7df1e;opacity:0.7;"></div>
              <div class="w-2 h-2 rounded-full" style="background:#00fff7;opacity:0.7;"></div>
            </div>
            <span class="text-[8px] sm:text-[9px] font-mono" style="color:rgba(0,255,247,0.35);">developer.ts</span>
            <div class="w-1.5 h-1.5 rounded-full" style="background:#00fff7;box-shadow:0 0 6px #00fff7;"></div>
          </div>
          <!-- Code lines -->
          <div class="px-3 sm:px-5 py-4 sm:py-5 overflow-x-auto">
            <code class="block font-mono text-[10px] sm:text-[11px] lg:text-xs leading-relaxed whitespace-nowrap">
              {codeLines.map((line, i) => (
                <div class="code-line flex gap-3 sm:gap-4" style={`animation:codeFadeIn .4s cubic-bezier(.16,1,.3,1) both;animation-delay:${i*0.07+0.2}s;animation-play-state:paused;`} data-code-line>
                  <span class="select-none flex-shrink-0 w-4 text-right" style="color:rgba(255,255,255,0.15);">{i+1}</span>
                  <span style={`padding-left:${line.indent * 1}rem;color:rgba(255,255,255,0.7);`} set:html={line.content || '&nbsp;'}></span>
                </div>
              ))}
            </code>
          </div>
        </div>

        <!-- CTA -->
        <a href="#contact"
          class="about-cta group inline-flex w-fit items-center gap-2.5 px-5 sm:px-7 py-3 sm:py-3.5 text-xs sm:text-sm font-black tracking-[0.15em] uppercase font-mono transition-all duration-200 hover:-translate-y-0.5"
          style="color:#020204;background:#00fff7;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));">
          Let's Work Together
          <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>

      </div>

      <!-- RIGHT — Feature cards 2x2 -->
      <div class="about-right grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        {features.map((f, i) => (
          <div class="feature-card group relative flex flex-col gap-3 p-4 sm:p-5 transition-all duration-300 hover:-translate-y-1 cursor-default"
            style={`background:rgba(255,255,255,0.02);border:1px solid ${f.color}1a;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));animation:cardReveal .55s cubic-bezier(.16,1,.3,1) both;animation-delay:${i*0.08+0.1}s;animation-play-state:paused;`}
            data-card>

            <!-- Hover top line -->
            <div class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-300" style={`background:linear-gradient(90deg,transparent,${f.color},transparent);`} aria-hidden="true"></div>
            <!-- Hover ambient -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" style={`background:radial-gradient(ellipse at 50% 0%,${f.color}08 0%,transparent 65%);`} aria-hidden="true"></div>
            <!-- Hover border glow -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style={`box-shadow:0 0 24px ${f.color}22,inset 0 0 12px ${f.color}0a;`} aria-hidden="true"></div>

            <!-- Icon -->
            <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center flex-shrink-0 transition-all duration-300 group-hover:scale-110"
              style={`color:${f.color};background:${f.color}12;border:1px solid ${f.color}25;clip-path:polygon(0 0,calc(100% - 5px) 0,100% 5px,100% 100%,5px 100%,0 calc(100% - 5px));`}>
              <div class="w-4 h-4 sm:w-5 sm:h-5" set:html={f.icon}></div>
            </div>

            <div>
              <!-- ID + Title -->
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-[8px] font-mono" style={`color:${f.color};opacity:0.45;`}>{f.id}</span>
                <h3 class="text-xs sm:text-sm font-black font-mono" style={`color:${f.color};`}>{f.title}</h3>
              </div>
              <p class="text-[10px] sm:text-[11px] leading-relaxed font-mono" style="color:rgba(255,255,255,0.33);">{f.desc}</p>
            </div>

            <!-- Bottom index line -->
            <div class="mt-auto pt-2 border-t flex items-center gap-2" style="border-color:rgba(255,255,255,0.05);">
              <div class="h-px flex-1" style={`background:linear-gradient(90deg,${f.color}30,transparent);`}></div>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- ── BOTTOM QUICK STATS ── -->
    <div class="about-stats grid grid-cols-2 sm:grid-cols-4 gap-0 overflow-hidden" style="border:1px solid rgba(0,255,247,0.1);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));" data-card>
      {[
        { val:"MCA", label:"Master's Of Computer Application",    color:"#00fff7" },
        { val:"Top Rated",   label:"Upwork status",       color:"#bf00ff" },
        { val:"US/UK/EU",    label:"Client markets",      color:"#ff006e" },
        { val:"24h",         label:"Avg response time",   color:"#f7df1e" },
      ].map((s, i) => (
        <div class="group flex flex-col items-center justify-center py-5 sm:py-6 relative cursor-default transition-all duration-300 hover:bg-white/[0.02]"
          style={i < 3 ? "border-right:1px solid rgba(0,255,247,0.08);" : ""}>
          <div class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity" style={`background:linear-gradient(90deg,transparent,${s.color}55,transparent);`} aria-hidden="true"></div>
          <span class="text-base sm:text-lg font-black font-mono text-center" style={`color:${s.color};text-shadow:0 0 16px ${s.color}66;`}>{s.val}</span>
          <span class="text-[8px] sm:text-[9px] font-mono tracking-widest uppercase mt-1 text-center" style="color:rgba(255,255,255,0.22);">{s.label}</span>
        </div>
      ))}
    </div>

  </div>

  <!-- Bottom separator -->
  <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,rgba(191,0,255,0.2),rgba(0,255,247,0.15),transparent);" aria-hidden="true"></div>

</section>

<style>
/* ── HEADER REVEAL ── */
.about-header { animation:slideUp .6s cubic-bezier(.16,1,.3,1) both; animation-delay:.05s; }
.about-left   { animation:slideUp .65s cubic-bezier(.16,1,.3,1) both; animation-delay:.15s; }
.about-cta:hover { box-shadow:0 0 28px rgba(0,255,247,.5),0 0 8px rgba(0,255,247,.3); }
@keyframes slideUp    { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
@keyframes cardReveal { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
@keyframes codeFadeIn { from{opacity:0;transform:translateX(-8px)} to{opacity:1;transform:translateX(0)} }

/* ── CODE BLOCK SCROLLBAR ── */
.overflow-x-auto::-webkit-scrollbar { height:2px; }
.overflow-x-auto::-webkit-scrollbar-track { background:transparent; }
.overflow-x-auto::-webkit-scrollbar-thumb { background:rgba(0,255,247,0.2);border-radius:1px; }

/* ── FEATURE CARD TITLE GRADIENT ON HOVER ── */
.feature-card:hover h3 {
  background-image:linear-gradient(90deg,currentColor,color-mix(in srgb,currentColor 50%,#fff));
  -webkit-background-clip:text;
  background-clip:text;
}

/* ── MOBILE 2-col stats fix ── */
@media(max-width:639px) {
  .grid-cols-2.sm\:grid-cols-4 > div:nth-child(2) { border-right:none !important; }
  .grid-cols-2.sm\:grid-cols-4 > div:nth-child(1),
  .grid-cols-2.sm\:grid-cols-4 > div:nth-child(3) { border-right:1px solid rgba(0,255,247,0.08) !important; }
  .grid-cols-2.sm\:grid-cols-4 > div:nth-child(1),
  .grid-cols-2.sm\:grid-cols-4 > div:nth-child(2) { border-bottom:1px solid rgba(0,255,247,0.08) !important; }
}
</style>

<script>
(function(){
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      // feature cards + stats
      el.querySelectorAll<HTMLElement>('[data-card]').forEach(c => { c.style.animationPlayState = 'running'; });
      // code lines
      el.querySelectorAll<HTMLElement>('[data-code-line]').forEach(l => { l.style.animationPlayState = 'running'; });
      obs.unobserve(el);
    });
  }, { threshold: 0.1 });
  const section = document.getElementById('about');
  if (section) obs.observe(section);
})();
</script>