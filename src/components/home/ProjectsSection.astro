---
// ProjectsSection.astro — Selected Work Showcase (Homepage Bento linking to /work/[slug])
import { caseStudies } from "../../data/caseStudies";
---

<section id="projects" class="py-24 sm:py-32 relative scroll-mt-20">
  <!-- Subtle section anchor alias -->
  <div id="work" class="sr-only">Work</div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- SECTION HEADER -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-xs font-mono text-zinc-300 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Selected Case Studies & Engineering Work
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-[-0.03em]">
          Engineered for speed, scale & conversion.
        </h2>
      </div>
      <div class="text-sm sm:text-base text-zinc-400 max-w-md leading-relaxed">
        Production systems built for European and US tech founders. Click any case study for deep-dive technical breakdowns.
      </div>
    </div>

    <!-- 2-COLUMN BENTO PROJECT GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {
        caseStudies.map((project) => (
          <article class="flex flex-col rounded-2xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 overflow-hidden group shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
            
            <!-- BROWSER-FRAME HEADER MOCKUP -->
            <div class="px-5 py-3.5 bg-zinc-950/80 border-b border-white/[0.06] flex items-center justify-between">
              <div class="flex items-center gap-2" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <div class="ml-2 px-3 py-1 rounded-md bg-white/[0.03] border border-white/[0.04] text-[11px] font-mono text-zinc-400 flex items-center gap-1.5 max-w-[200px] sm:max-w-xs truncate">
                  <svg class="w-3 h-3 text-zinc-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="truncate">{project.displayUrl}</span>
                </div>
              </div>

              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] font-mono font-semibold text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                {project.clientStatus.split(" ")[0]}
              </span>
            </div>

            <!-- BROWSER VIEWPORT MOCKUP AREA -->
            <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
              
              <div>
                <!-- CATEGORY & REGION -->
                <div class="flex items-center justify-between text-xs text-zinc-400 font-mono mb-2">
                  <span>{project.category}</span>
                  <span>{project.timeline}</span>
                </div>

                <!-- TITLE & TAGLINE -->
                <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2 group-hover:text-emerald-300 transition-colors">
                  {project.title}
                </h3>
                <p class="text-xs font-medium text-emerald-400/90 mb-4 font-mono">
                  {project.subtitle}
                </p>

                <!-- DESCRIPTION -->
                <p class="text-sm text-zinc-400 leading-relaxed mb-6">
                  {project.tagline}
                </p>
              </div>

              <div>
                <!-- KEY METRICS ROW -->
                <div class="grid grid-cols-3 gap-2.5 p-3 rounded-xl bg-white/[0.02] border border-white/[0.05] mb-6">
                  {project.impactMetrics.slice(0, 3).map((m) => (
                    <div class="text-center">
                      <div class="text-xs sm:text-sm font-bold font-mono text-zinc-200">
                        {m.value}
                      </div>
                      <div class="text-[10px] text-zinc-400 uppercase tracking-wider mt-0.5 font-sans">
                        {m.label}
                      </div>
                    </div>
                  ))}
                </div>

                <!-- TECH PILLS -->
                <div class="flex flex-wrap gap-1.5 mb-6">
                  {project.coreStack.slice(0, 5).map((tag) => (
                    <span class="px-2.5 py-1 rounded-md text-[11px] font-mono bg-white/[0.03] text-zinc-300 border border-white/[0.06]">
                      {tag}
                    </span>
                  ))}
                </div>

                <!-- ACTION BUTTONS: LIVE SITE + READ FULL CASE STUDY -->
                <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-white/[0.06]">
                  <a
                    href={`/work/${project.slug}`}
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors group/link"
                  >
                    <span>Read Full Case Study</span>
                    <span class="group-hover/link:translate-x-1 transition-transform">→</span>
                  </a>

                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 hover:text-white transition-colors"
                    >
                      <span>Live Site</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>

              </div>

            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>
