<style>
  /* ════════════ 1. SCROLL-REVEAL ENTRANCE ANIMATION (GSAP/BLIEX EQUIVALENT) ════════════ */
  [data-scroll-01],
  [data-scroll-02],
  [data-scroll-03] {
    opacity: 0;
    transform: translateY(36px);
    transition:
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  [data-scroll-01].is-revealed,
  [data-scroll-02].is-revealed,
  [data-scroll-03].is-revealed {
    opacity: 1;
    transform: none;
  }

  [data-scroll-02] {
    transition-delay: 0.15s;
  }

  [data-scroll-03] {
    transition-delay: 0.3s;
  }

  /* ════════════ 2. STICKY STACKING CARDS ON DESKTOP (>991px) ════════════ */
