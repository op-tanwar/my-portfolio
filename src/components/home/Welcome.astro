---
// Welcome.astro (HeroSection) — High-Converting European & Global Trust Architecture

interface Props {
  projectsUrl?: string;
  contactUrl?: string;
}

const {
  projectsUrl = "/#projects",
  contactUrl = "/#contact",
} = Astro.props;
---

<section
  id="hero"
  aria-label="Frontend Engineer & Consultant Hero"
  class="relative pt-32 pb-16 sm:pt-40 sm:pb-24 lg:pt-44 lg:pb-32 overflow-hidden"
>
  <!-- SUBTLE AMBIENT RADIAL GLOW (Linear/Raycast style) -->
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] sm:w-[900px] h-[400px] sm:h-[550px] pointer-events-none -z-10"
    style="background: radial-gradient(ellipse at 50% 30%, rgba(59, 130, 246, 0.07) 0%, rgba(16, 185, 129, 0.03) 40%, transparent 70%); filter: blur(60px);"
    aria-hidden="true"
  ></div>

  <!-- ULTRA-SUBTLE GRID PATTERN -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none -z-10"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- ════════════ LEFT COLUMN: VALUE PROPOSITION ════════════ -->
      <div class="lg:col-span-7 flex flex-col items-start">
        
        <!-- TOP STATUS PILL: EUROPEAN & GLOBAL OVERLAP -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/[0.08] border border-emerald-500/20 text-emerald-400 text-xs font-medium mb-6 backdrop-blur-sm shadow-[0_0_15px_rgba(16,185,129,0.08)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
          </span>
          <span class="tracking-tight">Available for New Projects</span>
          <span class="text-emerald-500/40">·</span>
          <span class="text-zinc-300 font-mono text-[11px]">Top Rated on Upwork (100% JSS) · EU / UK / US Overlap</span>
        </div>

        <!-- BOLD OUTCOME-DRIVEN HEADLINE -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-[-0.035em] leading-[1.08] mb-6">
          Senior Frontend & Full-Stack Engineer building ultra-fast <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-100 to-zinc-400">Astro, Next.js & Custom E-Commerce</span> platforms.
        </h1>

        <!-- HIGH-READABILITY SUBHEADLINE -->
        <p class="text-base sm:text-lg text-zinc-400 max-w-xl leading-relaxed mb-8">
          I help European and global founders ship sub-second marketing sites, scalable React/Next.js web apps, and multi-vendor marketplaces — engineered for Core Web Vitals, technical SEO, and clean handoff.
        </p>

        <!-- DUAL CONVERSION CTAS -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-10 w-full sm:w-auto">
          <a
            href={contactUrl}
            class="flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-zinc-950 bg-white hover:bg-zinc-200 active:scale-[0.98] transition-all shadow-[0_0_24px_rgba(255,255,255,0.2)] w-full sm:w-auto"
          >
            Start a Project
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href={projectsUrl}
            class="flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-medium text-zinc-300 bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] hover:border-white/[0.16] active:scale-[0.98] transition-all w-full sm:w-auto"
          >
            Read Case Studies
          </a>
        </div>

        <!-- KEY PROOF METRICS STRIP -->
        <div class="grid grid-cols-3 gap-6 sm:gap-10 pt-6 border-t border-white/[0.08] w-full max-w-lg">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-mono">
              3<span class="text-emerald-400">+</span>
            </div>
            <div class="text-xs text-zinc-400 font-medium mt-0.5">Years Production Exp</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-mono text-emerald-400">
              100<span class="text-emerald-300">%</span>
            </div>
            <div class="text-xs text-zinc-400 font-medium mt-0.5">Upwork JSS (Top Rated)</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-mono">
              &lt;0.8<span class="text-emerald-400">s</span>
            </div>
            <div class="text-xs text-zinc-400 font-medium mt-0.5">Avg LCP Benchmark</div>
          </div>
        </div>

      </div>

      <!-- ════════════ RIGHT COLUMN: LIVE ENGINEERING BENCHMARK CARD ════════════ -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="w-full max-w-md rounded-2xl bg-[#111114]/90 border border-white/[0.08] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.7)] p-5 sm:p-6 backdrop-blur-xl relative overflow-hidden group hover:border-white/[0.16] transition-all duration-300">
          
          <!-- Subtle top glow -->
          <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-48 h-24 bg-emerald-500/10 blur-2xl rounded-full pointer-events-none"></div>

          <!-- CARD HEADER -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.06]">
            <div class="flex items-center gap-2">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
              </div>
              <span class="text-xs font-mono text-zinc-400 ml-2">engineering.benchmark</span>
            </div>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              EU & US Ready
            </span>
          </div>

          <!-- 4 LIGHTHOUSE SCORE PILLS -->
          <div class="mb-5">
            <div class="text-xs font-medium text-zinc-400 mb-2.5 flex items-center justify-between">
              <span>Google Core Web Vitals Benchmark</span>
              <span class="text-[11px] font-mono text-emerald-400">Production Verified</span>
            </div>
            <div class="grid grid-cols-4 gap-2 text-center">
              <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] group-hover:border-emerald-500/20 transition-colors">
                <div class="text-base sm:text-lg font-bold font-mono text-emerald-400">100</div>
                <div class="text-[9px] uppercase tracking-wider text-zinc-400 mt-0.5">Perf</div>
              </div>
              <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] group-hover:border-emerald-500/20 transition-colors">
                <div class="text-base sm:text-lg font-bold font-mono text-emerald-400">100</div>
                <div class="text-[9px] uppercase tracking-wider text-zinc-400 mt-0.5">A11y</div>
              </div>
              <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] group-hover:border-emerald-500/20 transition-colors">
                <div class="text-base sm:text-lg font-bold font-mono text-emerald-400">100</div>
                <div class="text-[9px] uppercase tracking-wider text-zinc-400 mt-0.5">Practices</div>
              </div>
              <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] group-hover:border-emerald-500/20 transition-colors">
                <div class="text-base sm:text-lg font-bold font-mono text-emerald-400">100</div>
                <div class="text-[9px] uppercase tracking-wider text-zinc-400 mt-0.5">SEO</div>
              </div>
            </div>
          </div>

          <!-- ARCHITECTURE METRICS BREAKDOWN -->
          <div class="space-y-2.5 mb-5">
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-950/60 border border-white/[0.04]">
              <span class="text-xs text-zinc-400">Largest Contentful Paint (LCP)</span>
              <span class="text-xs font-mono font-semibold text-emerald-400">&lt; 0.8s</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-950/60 border border-white/[0.04]">
              <span class="text-xs text-zinc-400">Cumulative Layout Shift (CLS)</span>
              <span class="text-xs font-mono font-semibold text-emerald-400">0.00</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-950/60 border border-white/[0.04]">
              <span class="text-xs text-zinc-400">Client Timezone Alignment</span>
              <span class="text-xs font-mono font-semibold text-zinc-200">CET / GMT / EST Overlap</span>
            </div>
            <div class="flex items-center justify-between p-2.5 rounded-lg bg-zinc-950/60 border border-white/[0.04]">
              <span class="text-xs text-zinc-400">Privacy & Compliance</span>
              <span class="text-xs font-mono font-semibold text-emerald-400">GDPR & WCAG 2.1 AA</span>
            </div>
          </div>

          <!-- PRODUCTION STACK CHIPS -->
          <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
            <span class="text-[11px] font-mono text-zinc-400 uppercase tracking-wider">Specialization</span>
            <div class="flex items-center gap-1.5">
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/[0.04] text-zinc-300 border border-white/[0.06]">Astro</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/[0.04] text-zinc-300 border border-white/[0.06]">Next.js</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/[0.04] text-zinc-300 border border-white/[0.06]">TypeScript</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-white/[0.04] text-zinc-300 border border-white/[0.06]">Marketplaces</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- ════════════ BOTTOM IMMEDIATE TRUST STRIP ════════════ -->
    <div class="mt-16 sm:mt-20 pt-8 border-t border-white/[0.06]">
      <div class="flex flex-wrap items-center justify-between gap-4 text-xs sm:text-sm text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 font-bold">5.0 ★</span>
          <span class="text-zinc-300 font-medium">Upwork Client Rating (100% JSS)</span>
        </div>
        <div class="hidden sm:block text-zinc-700">·</div>
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="text-zinc-300 font-medium">Top Rated Freelancer</span>
        </div>
        <div class="hidden sm:block text-zinc-700">·</div>
        <div class="flex items-center gap-2">
          <span class="text-zinc-300 font-medium">Trusted by founders in the UK, Switzerland & US</span>
        </div>
        <div class="hidden sm:block text-zinc-700">·</div>
        <div class="flex items-center gap-2">
          <span class="text-zinc-300 font-medium font-mono text-xs text-emerald-400/90">Daily Staging & Async Linear / Slack</span>
        </div>
      </div>
    </div>

  </div>
</section>
