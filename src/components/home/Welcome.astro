</style>

<script>
  // ═══════════════════════════════════
  // 1. PARTICLES
  // ═══════════════════════════════════
  (function () {
    const canvas = document.getElementById(
      "particle-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d")!;
    let W = 0,
      H = 0;
    type P = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      a: number;
      c: string;
    };
    const ps: P[] = [];
    const COLS = [
      "rgba(0,255,247,",
      "rgba(191,0,255,",
      "rgba(255,0,110,",
      "rgba(255,255,255,",
    ];
    const resize = () => {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    };
    const spawn = () => {
      // Fewer particles on mobile for perf
      const count = window.innerWidth < 768 ? 45 : 90;
      for (let i = 0; i < count; i++)
        ps.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.22,
          vy: (Math.random() - 0.5) * 0.22,
          r: Math.random() * 1.1 + 0.2,
          a: Math.random() * 0.7 + 0.1,
          c: COLS[Math.floor(Math.random() * COLS.length)],
        });
    };
    const connDist = window.innerWidth < 768 ? 70 : 90;
    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      for (const p of ps) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0) p.x = W;
        if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H;
        if (p.y > H) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.c + p.a + ")";
        ctx.fill();
      }
      for (let i = 0; i < ps.length; i++)
        for (let j = i + 1; j < ps.length; j++) {
          const dx = ps[i].x - ps[j].x,
            dy = ps[i].y - ps[j].y,
            d = Math.sqrt(dx * dx + dy * dy);
          if (d < connDist) {
            ctx.beginPath();
            ctx.moveTo(ps[i].x, ps[i].y);
            ctx.lineTo(ps[j].x, ps[j].y);
            ctx.strokeStyle = `rgba(0,255,247,${0.035 * (1 - d / connDist)})`;
            ctx.lineWidth = 0.4;
            ctx.stroke();
          }
        }
      requestAnimationFrame(draw);
    };
    window.addEventListener("resize", resize, { passive: true });
    resize();
    spawn();
    draw();
  })();

  // ═══════════════════════════════════
  // 2. TYPEWRITER
  // ═══════════════════════════════════
  (function () {
    const el = document.getElementById("typewriter") as HTMLElement | null;
    if (!el) return;
    const words = [
      "Frontend Engineer.",
      "Next.js & Astro Expert.",
      "Performance-Focused Dev.",
      "Pixel-Perfect UI Builder.",
      "Scalable Web Apps.",
    ];
    let wi = 0,
      ci = 0,
      del = false;
    const type = () => {
      const w = words[wi];
      if (!del) {
        el.textContent = w.slice(0, ++ci);
        if (ci === w.length) {
          del = true;
          setTimeout(type, 1800);
          return;
        }
      } else {
        el.textContent = w.slice(0, --ci);
        if (ci === 0) {
          del = false;
          wi = (wi + 1) % words.length;
        }
      }
      setTimeout(type, del ? 40 : 85);
    };
    setTimeout(type, 300);
  })();

  // ═══════════════════════════════════
  // 3. STAT COUNTERS
  // ═══════════════════════════════════
  (function () {
    const nums = document.querySelectorAll<HTMLElement>(".stat-number");
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          const end = parseInt(el.dataset.end!);
          const suf = el.dataset.suffix!;
          let cur = 0;
          const step = Math.max(1, Math.round(end / 45));
          const iv = setInterval(() => {
            cur = Math.min(cur + step, end);
            el.textContent = cur + suf;
            if (cur >= end) clearInterval(iv);
          }, 30);
          obs.unobserve(el);
        });
      },
      { threshold: 0.5 },
    );
    nums.forEach((n) => obs.observe(n));
  })();

  // ═══════════════════════════════════
  // 4. 3D TILT (desktop only)
  // ═══════════════════════════════════
  (function () {
    // Skip tilt on touch devices
    if (window.matchMedia("(hover:none)").matches) return;
    const wrapper = document.getElementById(
      "globe-wrapper",
    ) as HTMLElement | null;
    const globe = document.getElementById("globe-3d") as HTMLElement | null;
    if (!wrapper || !globe) return;
    let raf = 0;
    wrapper.addEventListener(
      "mousemove",
      (e: MouseEvent) => {
        const r = wrapper.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
        const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          globe.style.transform = `perspective(1000px) rotateX(${-dy * 16}deg) rotateY(${dx * 16}deg)`;
          globe.style.transition = "transform 0.06s linear";
        });
      },
      { passive: true },
    );
    wrapper.addEventListener("mouseleave", () => {
      cancelAnimationFrame(raf);
      globe.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg)";
      globe.style.transition = "transform 0.7s cubic-bezier(.16,1,.3,1)";
    });
  })();
</script>
