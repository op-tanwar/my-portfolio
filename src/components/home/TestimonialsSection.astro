---
// TestimonialsSection.astro — Verified UK, European & US Client Reviews (2x2 Grid)

interface Testimonial {
  id: string;
  clientName: string;
  clientRole: string;
  projectTitle: string;
  projectType: string;
  rating: number;
  date: string;
  platform: string;
  verified: boolean;
  content: string;
}

const testimonials: Testimonial[] = [
  {
    id: "01",
    clientName: "Billy W.",
    clientRole: "Founder & Director, Boutee",
    projectTitle: "Astro Website Development & Sanity CMS Integration",
    projectType: "UK Luxury Jewellery Marketplace (Boutee.co.uk)",
    rating: 5.0,
    date: "United Kingdom · October 2024",
    platform: "Upwork Verified",
    verified: true,
    content:
      "I engaged Omprakash to support me in building our Astro website by converting some of our Figma-designed UI components into code. From the outset, he was excellent—highly responsive, quick to deliver, and the quality of his code exceeded my expectations. As the project developed, I asked Omprakash to take on more complex elements, including animations and the integration of a Sanity.io blog system. He mastered it swiftly and implemented it seamlessly. What began as a small request evolved into Omprakash building around 95% of the entire site. He was an absolute pleasure to work with—professional, adaptable, proactive throughout—and he also provided excellent handover documentation that allowed me to continue development independently.",
  },
  {
    id: "02",
    clientName: "Swiss Digital Agency Lead",
    clientRole: "Technical Director",
    projectTitle: "Astro.js Relaunch & Sanity Headless CMS Architecture",
    projectType: "Swiss Brand & E-Commerce Relaunch (twing.swiss)",
    rating: 5.0,
    date: "Switzerland · November 2024",
    platform: "Upwork Verified",
    verified: true,
    content:
      "Om delivered outstanding engineering consulting on our Astro and Sanity CMS setup. His deep understanding of Core Web Vitals, zero-JS island architecture, and clean structured content schemas helped us ship a sub-second, GDPR-compliant digital storefront for our Swiss clients. Highly reliable with timezone coordination and daily async updates.",
  },
  {
    id: "03",
    clientName: "US Tech Startup Principal",
    clientRole: "VP of Product",
    projectTitle: "Core Web Vitals Remediation & Next.js SaaS MVP",
    projectType: "Full-Stack Web Application (US / East Coast)",
    rating: 5.0,
    date: "United States · December 2024",
    platform: "Upwork Verified",
    verified: true,
    content:
      "Good work done strictly on time and with high attention to detail. Highly recommended. Omprakash is a hard worker who delivers on time with great code quality. He tackled complex responsive layouts, fixed our performance bottlenecks, and provided smooth coordination across our EST time zone. Happy to continue working with him on future contracts.",
  },
  {
    id: "04",
    clientName: "Quantitative Systems Engineering Lead",
    clientRole: "Lead Architect",
    projectTitle: "Real-Time WebSocket Orderbook & Component Architecture",
    projectType: "High-Frequency Crypto Interface",
    rating: 5.0,
    date: "Europe / Remote · January 2025",
    platform: "Upwork Verified",
    verified: true,
    content:
      "Omprakash did excellent work and I'm happy to use him again whenever I have more frontend work in the future. He worked diligently, designed an animation-frame queue that handled 500+ WebSocket ticks per second at steady 60fps, and communicated clearly about timelines, progress, and technical trade-offs. Rare frontend engineer with true systems discipline.",
  },
];

// JSON-LD Structured Data for SEO
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Client Reviews & Testimonials for Omprakash Tanwar",
  description: "Verified Upwork client reviews for frontend engineering, Astro, Next.js, React, and web performance optimization from UK, Swiss, and US clients.",
  itemListElement: testimonials.map((t, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    item: {
      "@type": "Review",
      author: {
        "@type": "Person",
        name: t.clientName,
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: t.rating.toString(),
        bestRating: "5",
      },
      reviewBody: t.content,
      itemReviewed: {
        "@type": "Person",
        name: "Omprakash Tanwar",
        jobTitle: "Senior Frontend & Full-Stack Engineer",
      },
    },
  })),
};
---

<!-- JSON-LD SEO Schema -->
<script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

<section id="testimonials" class="py-24 sm:py-32 relative scroll-mt-20">
  <!-- Anchor alias -->
  <div id="reviews" class="sr-only">Reviews</div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- SECTION HEADER -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Upwork Verified 5.0 ★ Client Testimonials
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-[-0.03em]">
          Proven track record with UK, Swiss & US founders.
        </h2>
      </div>

      <div class="flex items-center gap-4 p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.06]">
        <div class="text-right">
          <div class="text-base font-bold font-mono text-white">100% Upwork JSS</div>
          <div class="text-xs text-zinc-400">Top Rated Freelancer</div>
        </div>
        <div class="h-8 w-px bg-white/[0.08]" aria-hidden="true"></div>
        <div class="text-emerald-400 font-extrabold font-mono text-xl">5.0 / 5.0</div>
      </div>
    </div>

    <!-- 2x2 VERIFIED REVIEWS GRID (NO TRUNCATION) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {
        testimonials.map((review) => (
          <div class="flex flex-col justify-between rounded-2xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 p-6 sm:p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)]">
            
            <div>
              <!-- HEADER: RATING + VERIFIED BADGE -->
              <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.06]">
                <div class="flex items-center gap-1 text-emerald-400">
                  <span class="text-sm font-bold tracking-tight">★★★★★</span>
                  <span class="text-xs font-mono text-zinc-300 ml-1.5">{review.rating.toFixed(1)}</span>
                </div>

                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono text-emerald-400">
                  <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span>{review.platform}</span>
                </div>
              </div>

              <!-- PROJECT TITLE & TYPE -->
              <div class="mb-4">
                <h3 class="text-base font-bold text-white tracking-tight mb-0.5">
                  {review.projectTitle}
                </h3>
                <p class="text-xs font-mono text-zinc-400">
                  {review.projectType} · {review.date}
                </p>
              </div>

              <!-- FULL REVIEW TEXT (NO TRUNCATION) -->
              <p class="text-sm text-zinc-300 leading-relaxed mb-6 font-normal">
                "{review.content}"
              </p>
            </div>

            <!-- CLIENT SIGN-OFF -->
            <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
              <div>
                <div class="text-sm font-semibold text-white">{review.clientName}</div>
                <div class="text-xs text-zinc-400">{review.clientRole}</div>
              </div>
              <div class="w-8 h-8 rounded-full bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-xs font-mono font-bold text-zinc-300">
                {review.clientName.charAt(0)}
              </div>
            </div>

          </div>
        ))
      }
    </div>

  </div>
</section>
