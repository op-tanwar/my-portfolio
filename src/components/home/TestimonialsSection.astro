---
// TestimonialsSection.astro — 100% Bliex Astro Replica (Infinite Testimonials Carousel Marquee)
// Matches "The AI platform teams actually rely on" section on https://bliex-astro.pages.dev/
// Preserves all verified Upwork client reviews, ratings (5.0 / 5.0, 100% JSS, Top Rated), and JSON-LD SEO schema.

interface Testimonial {
  id: string;
  clientName: string;
  clientRole: string;
  projectTitle: string;
  projectType: string;
  rating: number;
  date: string;
  platform: string;
  verified: boolean;
  content: string;
}

const testimonials: Testimonial[] = [
  {
    id: "01",
    clientName: "Billy W.",
    clientRole: "Founder & Director, Boutee",
    projectTitle: "Astro Website Development & Sanity CMS Integration",
    projectType: "UK Luxury Jewellery Marketplace (Boutee.co.uk)",
    rating: 5.0,
    date: "United Kingdom · October 2024",
    platform: "Upwork Verified",
    verified: true,
    content:
      "I engaged Omprakash to support me in building our Astro website by converting some of our Figma-designed UI components into code. From the outset, he was excellent—highly responsive, quick to deliver, and the quality of his code exceeded my expectations. As the project developed, I asked Omprakash to take on more complex elements, including animations and the integration of a Sanity.io blog system. He mastered it swiftly and implemented it seamlessly. What began as a small request evolved into Omprakash building around 95% of the entire site. He was an absolute pleasure to work with—professional, adaptable, proactive throughout—and he also provided excellent handover documentation that allowed me to continue development independently.",
  },
  {
    id: "02",
    clientName: "Swiss Digital Agency Lead",
    clientRole: "Technical Director",
    projectTitle: "Astro.js Relaunch & Sanity Headless CMS Architecture",
    projectType: "Swiss Brand & E-Commerce Relaunch",
    rating: 5.0,
    date: "Switzerland · November 2024",
    platform: "Upwork Verified",
    verified: true,
    content:
      "Om delivered outstanding engineering consulting on our Astro and Sanity CMS setup. His deep understanding of Core Web Vitals, zero-JS island architecture, and clean structured content schemas helped us ship a sub-second, GDPR-compliant digital storefront for our Swiss clients. Highly reliable with timezone coordination and daily async updates.",
  },
  {
    id: "03",
    clientName: "US Tech Startup Principal",
    clientRole: "VP of Product",
    projectTitle: "Core Web Vitals Remediation & Next.js SaaS MVP",
    projectType: "Full-Stack Web Application (US / East Coast)",
    rating: 5.0,
    date: "United States · December 2024",
    platform: "Upwork Verified",
    verified: true,
    content:
      "Good work done strictly on time and with high attention to detail. Highly recommended. Omprakash is a hard worker who delivers on time with great code quality. He tackled complex responsive layouts, fixed our performance bottlenecks, and provided smooth coordination across our EST time zone. Happy to continue working with him on future contracts.",
  },
  {
    id: "04",
    clientName: "Quantitative Systems Engineering Lead",
    clientRole: "Lead Architect",
    projectTitle: "Real-Time WebSocket Orderbook & Component Architecture",
    projectType: "High-Frequency Crypto Interface",
    rating: 5.0,
    date: "Europe / Remote · January 2025",
    platform: "Upwork Verified",
    verified: true,
    content:
      "Omprakash did excellent work and I'm happy to use him again whenever I have more frontend work in the future. He worked diligently, designed an animation-frame queue that handled 500+ WebSocket ticks per second at steady 60fps, and communicated clearly about timelines, progress, and technical trade-offs. Rare frontend engineer with true systems discipline.",
  },
];

// Duplicate list for seamless infinite marquee loop
const marqueeTestimonials = [...testimonials, ...testimonials];

// JSON-LD Structured Data for SEO
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Client Reviews & Testimonials for Omprakash Tanwar",
  description:
    "Verified Upwork client reviews for frontend engineering, Astro, Next.js, React, and web performance optimization from UK, Swiss, and US clients.",
  itemListElement: testimonials.map((t, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    item: {
      "@type": "Review",
      author: {
        "@type": "Person",
        name: t.clientName,
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: t.rating.toString(),
        bestRating: "5",
      },
      reviewBody: t.content,
      itemReviewed: {
        "@type": "Person",
        name: "Omprakash Tanwar",
        jobTitle: "Senior Frontend & Full-Stack Engineer",
      },
    },
  })),
};
---

<!-- JSON-LD SEO Schema -->
<script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

<section
  id="testimonials"
  class="section py-16 sm:py-20 lg:py-24 relative scroll-mt-20 font-['Urbanist',sans-serif] text-white overflow-hidden"
>
  <!-- Anchor alias -->
  <div id="reviews" class="sr-only">Reviews</div>

  <!-- ════════════ 1. SECTION HEADER (CENTERED BLIEX EDITORIAL STYLE) ════════════ -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10 sm:mb-14 flex flex-col items-center">
      <!-- Eyebrow Pill -->
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400 mb-4 sm:mb-5 shadow-[0_0_20px_rgba(16,185,129,0.12)]"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Upwork Verified 5.0 ★ Client Testimonials</span>
      </div>

      <!-- Main Headline -->
      <h2
        class="text-2xl sm:text-4xl lg:text-5xl xl:text-[56px] font-normal leading-[1.15] text-white tracking-tight max-w-4xl mx-auto mb-4 sm:mb-6"
      >
        Proven track record with UK, Swiss & US founders.
      </h2>

      <!-- Subtitle -->
      <p class="max-w-[540px] mx-auto text-xs sm:text-sm lg:text-base text-white/70 font-normal leading-relaxed mb-6 sm:mb-8">
        Verifiable reviews from enterprise directors, agency leads, and startup founders who hired me for sub-second Astro, Next.js, and e-commerce architectures.
      </p>

      <!-- Trust Metrics Badges (User Requested: 100% Upwork JSS, Top Rated, 5.0 / 5.0, ★★★★★ 5.0) -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-3.5">
        <!-- 100% Upwork JSS + Top Rated -->
        <div
          class="flex items-center gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-white/[0.04] border border-white/[0.1] backdrop-blur-md shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="text-xs sm:text-sm font-bold font-mono text-white">100% Upwork JSS</span>
          <span class="text-white/30">·</span>
          <span class="text-xs sm:text-sm text-zinc-300 font-medium">Top Rated Freelancer</span>
        </div>

        <!-- 5.0 / 5.0 Star Rating with Bliex Orange Squares -->
        <div
          class="flex items-center gap-1.5 sm:gap-2 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full bg-white/[0.04] border border-white/[0.1] backdrop-blur-md shadow-sm"
        >
          <!-- 5 Bliex Orange Star Boxes -->
          <div class="flex items-center gap-0.5 sm:gap-1">
            {
              [...Array(5)].map(() => (
                <div class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-[3.5px] sm:rounded-[4px] bg-[#de3000] flex items-center justify-center shadow-sm shrink-0">
                  <svg
                    class="w-2 h-2 sm:w-2.5 sm:h-2.5 text-white"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                </div>
              ))
            }
          </div>
          <span class="text-xs sm:text-sm font-extrabold font-mono text-emerald-400 ml-0.5 sm:ml-1">
            5.0 / 5.0
          </span>
          <span class="text-[10px] sm:text-[11px] font-mono text-zinc-400 hidden xs:inline">
            (100% 5-Star)
          </span>
        </div>

        <!-- CTAs: Start a Project + Book Call -->
        <a
          href="/#contact"
          class="px-4 py-1.5 sm:px-5 sm:py-2 rounded-full font-semibold text-xs sm:text-sm bg-white text-black hover:bg-zinc-200 transition-all duration-300 hover:scale-105 shadow-sm"
        >
          Work With Me
        </a>
      </div>
    </div>
  </div>

  <!-- ════════════ 2. INFINITE CAROUSEL MARQUEE (.testimonial-slider-wrapper) ════════════ -->
  <div class="testimonial-slider-wrapper relative w-full overflow-hidden py-2 sm:py-4">
    <!-- TRACK 1 -->
    <div class="testimonial-slider flex gap-4 sm:gap-5 shrink-0">
      {
        marqueeTestimonials.map((review, idx) => (
          <div
            class="testimonial-card w-[290px] xs:w-[320px] sm:w-[380px] md:w-[420px] lg:w-[460px] min-h-[360px] sm:min-h-[400px] lg:min-h-[420px] p-5 sm:p-7 lg:p-8 rounded-[24px] sm:rounded-[32px] lg:rounded-[36px] bg-[#111114] border border-white/[0.08] hover:border-white/[0.2] transition-all duration-300 shadow-[0_16px_50px_rgba(0,0,0,0.85)] flex flex-col justify-between shrink-0 group"
          >
            <!-- TOP BAR: DATE & BLIEX 5-STAR SQUARES -->
            <div>
              <div class="flex items-center justify-between pb-3 sm:pb-4 mb-3 sm:mb-4 border-b border-white/[0.06] gap-2">
                <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                  <!-- 5 Orange Star Rects (Bliex Style) -->
                  <div class="flex items-center gap-0.5 sm:gap-1">
                    {
                      [...Array(5)].map(() => (
                        <div class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-[3.5px] sm:rounded-[4px] bg-[#de3000] flex items-center justify-center shrink-0">
                          <svg
                            class="w-2 h-2 sm:w-2.5 sm:h-2.5 text-white"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                          >
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                          </svg>
                        </div>
                      ))
                    }
                  </div>
                  <span class="text-xs font-mono font-bold text-white ml-0.5 sm:ml-1">
                    {review.rating.toFixed(1)}
                  </span>
                </div>

                <!-- Verified Platform Badge -->
                <div class="inline-flex items-center gap-1 sm:gap-1.5 px-2 py-0.5 sm:px-2.5 sm:py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] sm:text-[11px] font-mono text-emerald-400 shrink-0">
                  <svg
                    class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-emerald-400 shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{review.platform}</span>
                </div>
              </div>

              <!-- PROJECT TITLE & TYPE -->
              <div class="mb-3">
                <h3 class="text-xs sm:text-sm lg:text-base font-semibold text-white tracking-tight mb-0.5 leading-snug">
                  {review.projectTitle}
                </h3>
                <p class="text-[11px] sm:text-xs font-mono text-zinc-400">
                  {review.projectType}
                </p>
              </div>

              <!-- VERBATIM REVIEW TEXT (PRESERVED 100% UNCHANGED) -->
              <p class="text-[11px] sm:text-xs lg:text-sm text-zinc-300 leading-relaxed font-normal line-clamp-5 sm:line-clamp-6 group-hover:line-clamp-none transition-all duration-300">
                "{review.content}"
              </p>
            </div>

            <!-- CLIENT SIGN-OFF -->
            <div class="pt-3.5 sm:pt-4 mt-4 sm:mt-5 border-t border-white/[0.06] flex items-center justify-between gap-2">
              <div class="min-w-0">
                <div class="text-xs sm:text-sm font-semibold text-white truncate">
                  {review.clientName}
                </div>
                <div class="text-[11px] sm:text-xs text-zinc-400 truncate">
                  {review.clientRole} · {review.date}
                </div>
              </div>
              <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/[0.06] border border-white/[0.1] flex items-center justify-center text-xs font-mono font-bold text-white shadow-sm shrink-0">
                {review.clientName.charAt(0)}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- TRACK 2 (DUPLICATE FOR SEAMLESS 100% INFINITE LOOP) -->
    <div class="testimonial-slider flex gap-4 sm:gap-5 shrink-0" aria-hidden="true">
      {
        marqueeTestimonials.map((review, idx) => (
          <div
            class="testimonial-card w-[290px] xs:w-[320px] sm:w-[380px] md:w-[420px] lg:w-[460px] min-h-[360px] sm:min-h-[400px] lg:min-h-[420px] p-5 sm:p-7 lg:p-8 rounded-[24px] sm:rounded-[32px] lg:rounded-[36px] bg-[#111114] border border-white/[0.08] hover:border-white/[0.2] transition-all duration-300 shadow-[0_16px_50px_rgba(0,0,0,0.85)] flex flex-col justify-between shrink-0 group"
          >
            <!-- TOP BAR: DATE & BLIEX 5-STAR SQUARES -->
            <div>
              <div class="flex items-center justify-between pb-3 sm:pb-4 mb-3 sm:mb-4 border-b border-white/[0.06] gap-2">
                <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
                  <!-- 5 Orange Star Rects (Bliex Style) -->
                  <div class="flex items-center gap-0.5 sm:gap-1">
                    {
                      [...Array(5)].map(() => (
                        <div class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-[3.5px] sm:rounded-[4px] bg-[#de3000] flex items-center justify-center shrink-0">
                          <svg
                            class="w-2 h-2 sm:w-2.5 sm:h-2.5 text-white"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                          >
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                          </svg>
                        </div>
                      ))
                    }
                  </div>
                  <span class="text-xs font-mono font-bold text-white ml-0.5 sm:ml-1">
                    {review.rating.toFixed(1)}
                  </span>
                </div>

                <!-- Verified Platform Badge -->
                <div class="inline-flex items-center gap-1 sm:gap-1.5 px-2 py-0.5 sm:px-2.5 sm:py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] sm:text-[11px] font-mono text-emerald-400 shrink-0">
                  <svg
                    class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-emerald-400 shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{review.platform}</span>
                </div>
              </div>

              <!-- PROJECT TITLE & TYPE -->
              <div class="mb-3">
                <h3 class="text-xs sm:text-sm lg:text-base font-semibold text-white tracking-tight mb-0.5 leading-snug">
                  {review.projectTitle}
                </h3>
                <p class="text-[11px] sm:text-xs font-mono text-zinc-400">
                  {review.projectType}
                </p>
              </div>

              <!-- VERBATIM REVIEW TEXT (PRESERVED 100% UNCHANGED) -->
              <p class="text-[11px] sm:text-xs lg:text-sm text-zinc-300 leading-relaxed font-normal line-clamp-5 sm:line-clamp-6 group-hover:line-clamp-none transition-all duration-300">
                "{review.content}"
              </p>
            </div>

            <!-- CLIENT SIGN-OFF -->
            <div class="pt-3.5 sm:pt-4 mt-4 sm:mt-5 border-t border-white/[0.06] flex items-center justify-between gap-2">
              <div class="min-w-0">
                <div class="text-xs sm:text-sm font-semibold text-white truncate">
                  {review.clientName}
                </div>
                <div class="text-[11px] sm:text-xs text-zinc-400 truncate">
                  {review.clientRole} · {review.date}
                </div>
              </div>
              <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white/[0.06] border border-white/[0.1] flex items-center justify-center text-xs font-mono font-bold text-white shadow-sm shrink-0">
                {review.clientName.charAt(0)}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ════════════ BLIEX INFINITE TESTIMONIAL MARQUEE ANIMATION ════════════ */
  .testimonial-slider-wrapper {
    display: flex;
    gap: 1rem;
    width: 100%;
    overflow: hidden;
    user-select: none;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 4%,
      black 96%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 4%,
      black 96%,
      transparent 100%
    );
  }

  @media (min-width: 768px) {
    .testimonial-slider-wrapper {
      gap: 1.25rem;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 8%,
        black 92%,
        transparent 100%
      );
    }
  }

  .testimonial-slider {
    display: flex;
    gap: 1rem;
    animation: testimonial-marquee 50s linear infinite;
    will-change: transform;
  }

  @media (min-width: 768px) {
    .testimonial-slider {
      gap: 1.25rem;
    }
  }

  @keyframes testimonial-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-100% - 1rem));
    }
  }

  @media (min-width: 768px) {
    @keyframes testimonial-marquee {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-100% - 1.25rem));
      }
    }
  }

  /* Smooth pause on hover and active touch */
  .testimonial-slider-wrapper:hover .testimonial-slider,
  .testimonial-slider-wrapper:active .testimonial-slider {
    animation-play-state: paused;
  }

  /* Accessibility: Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .testimonial-slider {
      animation: none !important;
      overflow-x: auto;
    }
  }
</style>

