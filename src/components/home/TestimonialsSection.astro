---
// TestimonialsSection.astro — CYBERPUNK v3 · RESPONSIVE CAROUSEL WITH SEO & PREMIUM REVIEW MODAL
// Placed on Homepage after WhyMeSection and before ContactSection

interface Testimonial {
  id: string;
  client?: string;
  text: string[];
  project?: string;
  date?: string;
  rating: number;
  featured?: boolean;
  accent: string;
}

const testimonials: Testimonial[] = [
  {
    id: "01",
    // client: "Eric Mangold",
    featured: true,
    rating: 5.0,
    project: "Astro Website Development • Sanity CMS • Animations",
    accent: "#00fff7",
    text: [
      "I am in the process of launching a new business and building our web app. Initially, I engaged Omprakash to support me in building our Astro website by converting some of our Figma-designed UI components into code.",
      "From the outset, he was excellent—highly responsive, quick to deliver, and the quality of his code exceeded my expectations.",
      "As the project developed, I asked Omprakash to take on more complex elements, including animations and the integration of a Sanity.io blog system. He was refreshingly honest in explaining that he had not worked on animations before, but he was eager to learn.",
      "I was slightly hesitant about paying for someone to pick up new skills during a project, but it proved to be an excellent investment—he learned quickly, built everything from scratch, and the results were outstanding.",
      "The same applied to the Sanity integration: he had never used it before, but mastered it swiftly and implemented it seamlessly.",
      "What began as a small request to support the development of a few components ultimately evolved into Omprakash building around 95% of the entire site.",
      "He was an absolute pleasure to work with—professional, adaptable, proactive throughout—and he also provided excellent handover documentation that allowed me to continue development independently.",
      "I would not hesitate to recommend Omprakash to anyone looking for a reliable frontend developer. I will certainly work with him again."
    ]
  },
  {
    id: "02",
    rating: 5.0,
    project: "Responsive Frontend Development",
    accent: "#bf00ff",
    text: [
      "Om is detail oriented. Though the Figma design was not standardized for various screen sizes, Om did a great job converting everything into a fully responsive website. He is proactive and communicates very well."
    ]
  },
  {
    id: "03",
    rating: 5.0,
    date: "December 10, 2025",
    accent: "#ff006e",
    text: [
      "Good work done on time and with high attention to detail. Highly recommended.",
      "Omprakash is a hard worker and delivers on time with great quality. I highly recommend him and am happy to continue working with him."
    ]
  },
  {
    id: "04",
    rating: 5.0,
    date: "December 19, 2024",
    accent: "#f7df1e",
    text: [
      "Omprakash did excellent work and I'm happy to use him again if I have more work in the future. He worked hard and communicated clearly about timelines, progress, and any questions regarding requirements."
    ]
  }
];

const trustBadges = [
  { icon: "⭐", label: "100% Job Success", color: "#00fff7" },
  { icon: "🏆", label: "Top Rated Freelancer", color: "#14a800" },
  { icon: "★", label: "5-Star Reviews", color: "#f7df1e" },
  { icon: "🌎", label: "International Clients", color: "#bf00ff" },
  { icon: "⚡", label: "Frontend Specialist", color: "#ff006e" }
];

// JSON-LD Structured Data for SEO
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Client Reviews & Testimonials for Omprakash Tanwar",
  "description": "Real feedback from clients I've worked with on production websites, frontend development, Astro, React, Next.js, Tailwind CSS, Sanity CMS, animations, and performance optimization.",
  "itemListElement": testimonials.map((t, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": t.client || "Upwork Client"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": t.rating.toString(),
        "bestRating": "5"
      },
      "reviewBody": t.text.join(" "),
      "itemReviewed": {
        "@type": "Person",
        "name": "Omprakash Tanwar",
        "jobTitle": "Frontend Developer"
      }
    }
  }))
};
---

<!-- JSON-LD SEO Schema -->
<script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />

<section id="testimonials" class="testimonials-section relative py-20 sm:py-28 overflow-hidden" style="background:#020204;" aria-labelledby="testimonials-heading">

  <!-- Scanlines -->
  <div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,255,247,0.005) 3px,rgba(0,255,247,0.005) 4px);" aria-hidden="true"></div>

  <!-- Top separator + glow -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,rgba(0,255,247,0.25),rgba(191,0,255,0.2),transparent);" aria-hidden="true"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[400px] sm:w-[600px] h-40 pointer-events-none" style="background:radial-gradient(ellipse,rgba(0,255,247,0.06) 0%,transparent 70%);filter:blur(24px);" aria-hidden="true"></div>

  <!-- Corner TL -->
  <div class="absolute top-8 left-4 sm:left-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px" style="background:linear-gradient(90deg,#00fff7,transparent);"></div>
    <div class="w-px h-10 sm:h-12" style="background:linear-gradient(180deg,#00fff7,transparent);"></div>
    <div class="absolute top-0 left-0 w-1.5 h-1.5 rounded-full" style="background:#00fff7;box-shadow:0 0 8px #00fff7;"></div>
  </div>
  <!-- Corner BR -->
  <div class="absolute bottom-8 right-4 sm:right-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px ml-auto" style="background:linear-gradient(270deg,#bf00ff,transparent);"></div>
    <div class="w-px h-10 sm:h-12 ml-auto" style="background:linear-gradient(0deg,#bf00ff,transparent);"></div>
    <div class="absolute bottom-0 right-0 w-1.5 h-1.5 rounded-full" style="background:#bf00ff;box-shadow:0 0 8px #bf00ff;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-16">

    <!-- ── HEADER & CAROUSEL CONTROLS ── -->
    <div class="testimonials-header mb-8 sm:mb-12">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 sm:mb-4 text-[10px] sm:text-xs font-mono font-bold tracking-wider uppercase"
        style="color:#00fff7;background:rgba(0,255,247,0.06);border:1px solid rgba(0,255,247,0.2);clip-path:polygon(0 0,calc(100% - 6px) 0,100% 6px,100% 100%,6px 100%,0 calc(100% - 6px));">
        <span>⭐</span>
        <span>Client Reviews</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <!-- Heading -->
          <h2 id="testimonials-heading" class="text-3xl sm:text-5xl lg:text-6xl font-black leading-none tracking-tight" style="font-family:'Courier New',monospace;">
            <span style="color:rgba(255,255,255,0.9);">Trusted by</span>
            <span class="block" style="background:linear-gradient(90deg,#00fff7,#bf00ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Clients Worldwide_</span>
          </h2>
          <!-- Description -->
          <p class="mt-3 text-xs sm:text-sm font-mono max-w-2xl leading-relaxed" style="color:rgba(255,255,255,0.45);">
            Real feedback from clients I've worked with on production websites, frontend development, Astro, React, Next.js, Tailwind CSS, Sanity CMS, animations, and performance optimization.
          </p>
        </div>

        <!-- Carousel Navigation Controls -->
        <div class="flex items-center gap-3 self-start md:self-end">
          <!-- Prev Button -->
          <button
            id="testimonial-prev"
            type="button"
            aria-label="Previous testimonial slide"
            class="w-10 h-10 flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="color:#00fff7;background:rgba(0,255,247,0.04);border:1px solid rgba(0,255,247,0.25);clip-path:polygon(0 0,calc(100% - 5px) 0,100% 5px,100% 100%,5px 100%,0 calc(100% - 5px));"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <!-- Pagination Indicator Dots -->
          <div id="testimonial-dots" class="flex items-center gap-2 px-1" role="tablist" aria-label="Testimonial slides">
            {testimonials.map((_, idx) => (
              <button
                type="button"
                role="tab"
                data-dot-index={idx}
                aria-label={`Go to testimonial slide ${idx + 1}`}
                class="dot-btn h-2 transition-all duration-300 rounded-full cursor-pointer"
                style={idx === 0 ? "width:1.5rem;background:#00fff7;box-shadow:0 0 8px #00fff7;" : "width:0.5rem;background:rgba(255,255,255,0.2);"}
              ></button>
            ))}
          </div>

          <!-- Next Button -->
          <button
            id="testimonial-next"
            type="button"
            aria-label="Next testimonial slide"
            class="w-10 h-10 flex items-center justify-center transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
            style="color:#00fff7;background:rgba(0,255,247,0.04);border:1px solid rgba(0,255,247,0.25);clip-path:polygon(0 0,calc(100% - 5px) 0,100% 5px,100% 100%,5px 100%,0 calc(100% - 5px));"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="mt-6 sm:mt-8 h-px w-full" style="background:linear-gradient(90deg,rgba(0,255,247,0.25),rgba(191,0,255,0.15),transparent);"></div>
    </div>

    <!-- ── TESTIMONIAL CAROUSEL TRACK ── -->
    <div
      id="testimonials-track"
      class="flex gap-5 sm:gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar py-2 mb-10 sm:mb-12"
      style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
    >
      {testimonials.map((item, i) => {
        const isLong = item.text.length > 2 || item.text.join(" ").length > 250;
        return (
          <article
            class="testimonial-card flex-shrink-0 w-full md:w-[calc(50%-0.75rem)] snap-start group relative flex flex-col justify-between p-6 sm:p-8 transition-all duration-300 hover:-translate-y-1.5 cursor-default"
            style={`background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));animation:cardReveal .55s cubic-bezier(.16,1,.3,1) both;animation-delay:${i*0.09+0.05}s;animation-play-state:paused;`}
            data-testimonial-card
            data-index={i}
            itemscope
            itemtype="https://schema.org/Review"
          >
            <!-- Hidden Microdata schema for SEO -->
            <meta itemprop="itemReviewed" content="Omprakash Tanwar - Frontend Developer" />
            <div itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating" class="hidden">
              <meta itemprop="ratingValue" content="5" />
              <meta itemprop="bestRating" content="5" />
            </div>

            <!-- Hover highlight line & glow -->
            <div class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
              style={`background:linear-gradient(90deg,transparent,${item.accent},transparent);`} aria-hidden="true"></div>
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style={`background:radial-gradient(ellipse at 50% 0%,${item.accent}08 0%,transparent 70%);`} aria-hidden="true"></div>
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
              style={`box-shadow:inset 0 0 0 1px ${item.accent}28;clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));`} aria-hidden="true"></div>

            <div>
              <!-- Top bar: Quote Icon, Badges & Stars -->
              <div class="flex items-start justify-between gap-3 mb-5">
                <div class="flex items-center gap-3">
                  <!-- Quote Icon -->
                  <div class="w-9 h-9 sm:w-10 sm:h-10 flex-shrink-0 flex items-center justify-center transition-transform duration-300 group-hover:scale-110"
                    style={`color:${item.accent};background:${item.accent}10;border:1px solid ${item.accent}25;clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));`}>
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                    </svg>
                  </div>

                  {item.featured && (
                    <span class="inline-flex items-center gap-1 text-[8px] sm:text-[9px] font-mono font-black tracking-widest uppercase px-2.5 py-1"
                      style="color:#00fff7;background:rgba(0,255,247,0.1);border:1px solid rgba(0,255,247,0.3);clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));">
                      ⭐ FEATURED REVIEW
                    </span>
                  )}
                </div>

                <!-- Upwork Badge & Stars -->
                <div class="flex flex-col items-end gap-1.5">
                  <!-- Verified Upwork Client Badge with Upwork logo -->
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[9px] sm:text-[10px] font-mono font-medium"
                    style="color:#14a800;background:rgba(20,168,0,0.08);border:1px solid rgba(20,168,0,0.22);clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));">
                    <svg class="w-3 h-3 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.366-1.22-1.834-2.148-4.036-2.687-5.892H7.828v7.112c-.002 1.406-1.141 2.546-2.547 2.546-1.405 0-2.543-1.14-2.543-2.546V3.492H0v7.112c0 2.914 2.37 5.303 5.281 5.303 2.913 0 5.283-2.389 5.283-5.303v-1.19c.529 1.107 1.182 2.229 1.974 3.221l-1.673 7.873h2.797l1.213-5.71c1.063.679 2.285 1.109 3.686 1.109 3 0 5.439-2.452 5.439-5.45 0-3.001-2.439-5.452-5.439-5.452z"/>
                    </svg>
                    <span>Verified Upwork Client</span>
                  </div>

                  <!-- 5 Gold Stars + Rating -->
                  <div class="flex items-center gap-1.5" aria-label="5 out of 5 stars rating">
                    <div class="flex items-center gap-0.5">
                      {Array.from({ length: 5 }).map((_) => (
                        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#F7DF1E]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-[10px] font-mono font-bold" style="color:rgba(255,255,255,0.7);">5.0</span>
                  </div>
                </div>
              </div>

              <!-- Review Text (Truncated if long) -->
              <blockquote itemprop="reviewBody" class="space-y-3.5 text-xs sm:text-sm font-sans leading-relaxed text-gray-300 mb-6 not-italic">
                {isLong ? (
                  <>
                    <p style="color:rgba(255,255,255,0.85);">
                      {item.text[0]}...
                    </p>
                    <button
                      type="button"
                      data-read-more={i}
                      aria-haspopup="dialog"
                      aria-label={`Read full review by ${item.client || 'client'}`}
                      class="inline-flex items-center gap-1.5 text-xs font-mono font-bold uppercase tracking-wider transition-all duration-200 hover:translate-x-1 cursor-pointer pt-1"
                      style="color:#00fff7;"
                    >
                      <span>Read more</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                      </svg>
                    </button>
                  </>
                ) : (
                  item.text.map((p) => (
                    <p style="color:rgba(255,255,255,0.85);">{p}</p>
                  ))
                )}
              </blockquote>
            </div>

            <!-- Bottom Footer Info -->
            <div class="pt-4 border-t flex flex-wrap items-center justify-between gap-2 text-[10px] sm:text-xs font-mono"
              style="border-color:rgba(255,255,255,0.08);">
              
              <!-- Client Name or Verified Client -->
              <cite class="flex items-center gap-2 not-italic" itemprop="author" itemscope itemtype="https://schema.org/Person">
                <div class="w-2 h-2 rounded-full" style={`background:${item.accent};box-shadow:0 0 6px ${item.accent};`}></div>
                <span class="font-bold text-white tracking-wide" itemprop="name">
                  {item.client ? item.client : "Client"}
                </span>
              </cite>

              <!-- Project / Date -->
              <div class="flex items-center gap-2" style="color:rgba(255,255,255,0.4);">
                {item.project && (
                  <span class="px-2 py-0.5" style={`color:${item.accent};background:${item.accent}0d;border:1px solid ${item.accent}20;`}>
                    {item.project}
                  </span>
                )}
                {item.date && (
                  <span class="tracking-wide">
                    {item.date}
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- ── TRUST SECTION (SMALL TRUST ROW) ── -->
    <div class="trust-row flex flex-wrap items-center justify-center gap-3 sm:gap-4 pt-4">
      {trustBadges.map((badge) => (
        <div class="flex items-center gap-2 px-3.5 py-2 transition-all duration-300 hover:scale-105"
          style={`background:rgba(255,255,255,0.02);border:1px solid ${badge.color}25;clip-path:polygon(0 0,calc(100% - 6px) 0,100% 6px,100% 100%,6px 100%,0 calc(100% - 6px));`}>
          <span class="text-xs sm:text-sm">{badge.icon}</span>
          <span class="text-[10px] sm:text-xs font-mono font-bold tracking-wide" style={`color:${badge.color};`}>
            {badge.label}
          </span>
        </div>
      ))}
    </div>

  </div>

  <!-- Bottom Separator -->
  <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,rgba(191,0,255,0.2),rgba(0,255,247,0.15),transparent);" aria-hidden="true"></div>
</section>

<!-- ── FULL REVIEW MODAL POPUP (PREMIUM HIGH-CONTRAST) ── -->
<div
  id="testimonial-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 hidden transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-client-name"
  aria-describedby="modal-text-content"
>
  <!-- Backdrop Blur overlay -->
  <div id="modal-backdrop" class="fixed inset-0 bg-black/85 backdrop-blur-xl cursor-pointer" aria-hidden="true"></div>

  <!-- Modal Content Box -->
  <div
    id="modal-card"
    class="relative z-10 w-full max-w-2xl max-h-[85vh] sm:max-h-[90vh] flex flex-col overflow-hidden p-6 sm:p-8 transform transition-all duration-300 scale-95 opacity-0"
    style="background:rgba(10,10,18,0.96);border:1px solid rgba(0,255,247,0.3);clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px));box-shadow:0 0 50px rgba(0,255,247,0.18), inset 0 1px 0 rgba(255,255,255,0.1);"
  >
    <!-- Top accent glow line -->
    <div class="absolute top-0 left-0 right-0 h-px" style="background:linear-gradient(90deg,transparent,#00fff7,#bf00ff,transparent);" aria-hidden="true"></div>

    <!-- Header Row -->
    <div class="flex items-start justify-between gap-4 mb-5 pb-4 border-b border-white/10 flex-shrink-0">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="inline-flex items-center gap-1 text-[8px] sm:text-[9px] font-mono font-black tracking-widest uppercase px-2.5 py-0.5"
            style="color:#00fff7;background:rgba(0,255,247,0.1);border:1px solid rgba(0,255,247,0.3);clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));">
            ⭐ FEATURED REVIEW
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 text-[9px] font-mono" style="color:#14a800;background:rgba(20,168,0,0.08);border:1px solid rgba(20,168,0,0.22);clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));">
            Verified Upwork Client
          </span>
        </div>
        <h3 id="modal-client-name" class="text-xl sm:text-2xl font-black font-mono text-white"></h3>
        <p id="modal-project-date" class="text-xs font-mono mt-1" style="color:#00fff7;"></p>
      </div>

      <!-- Close Button -->
      <button
        id="modal-close-btn"
        type="button"
        aria-label="Close review modal"
        class="w-9 h-9 flex-shrink-0 flex items-center justify-center transition-all duration-200 hover:scale-105 text-cyan-400 hover:text-white cursor-pointer"
        style="background:rgba(0,255,247,0.06);border:1px solid rgba(0,255,247,0.25);clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Rating Stars -->
    <div class="flex items-center gap-2 mb-5 flex-shrink-0">
      <div class="flex items-center gap-1 text-[#F7DF1E]">
        {Array.from({ length: 5 }).map((_) => (
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <span class="text-xs font-mono font-bold text-white/90">5.0 / 5.0 Rating</span>
    </div>

    <!-- Scrollable Body with full review text -->
    <div id="modal-text-content" class="overflow-y-auto space-y-4 pr-3 text-xs sm:text-sm font-sans leading-relaxed text-gray-200 custom-scrollbar">
    </div>
  </div>
</div>

<style>
/* Hide scrollbar for Chrome, Safari and Opera */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
/* Hide scrollbar for IE, Edge and Firefox */
.no-scrollbar {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}

/* Custom scrollbar for Modal content */
.custom-scrollbar::-webkit-scrollbar {
  width: 5px;
}
.custom-scrollbar::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.04);
}
.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(0, 255, 247, 0.35);
  border-radius: 3px;
}

.testimonials-header {
  animation: slideUp .6s cubic-bezier(.16,1,.3,1) both;
  animation-delay: .05s;
}
@keyframes slideUp {
  from { opacity: 0; transform: translateY(28px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes cardReveal {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

<script is:inline define:vars={{ testimonials }}>
(function(){
  const track = document.getElementById('testimonials-track');
  const prevBtn = document.getElementById('testimonial-prev');
  const nextBtn = document.getElementById('testimonial-next');
  const dotsContainer = document.getElementById('testimonial-dots');
  const cards = track ? Array.from(track.querySelectorAll('[data-testimonial-card]')) : [];

  if (!track || !cards.length) return;

  // IntersectionObserver to trigger animation when scrolled into view
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      cards.forEach(card => {
        card.style.animationPlayState = 'running';
      });
      obs.unobserve(e.target);
    });
  }, { threshold: 0.08 });
  obs.observe(track);

  // Update button states and active pagination dots
  function updateCarouselState() {
    if (!track) return;
    const scrollLeft = track.scrollLeft;
    const maxScroll = track.scrollWidth - track.clientWidth;
    const cardWidth = cards[0].offsetWidth + 24; // width + gap
    const activeIndex = Math.min(Math.round(scrollLeft / cardWidth), cards.length - 1);

    // Prev / Next button state
    if (prevBtn) prevBtn.disabled = scrollLeft <= 5;
    if (nextBtn) nextBtn.disabled = scrollLeft >= maxScroll - 5;

    // Dots state
    if (dotsContainer) {
      const dots = Array.from(dotsContainer.querySelectorAll('.dot-btn'));
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.style.width = '1.5rem';
          dot.style.background = '#00fff7';
          dot.style.boxShadow = '0 0 8px #00fff7';
          dot.setAttribute('aria-selected', 'true');
        } else {
          dot.style.width = '0.5rem';
          dot.style.background = 'rgba(255,255,255,0.2)';
          dot.style.boxShadow = 'none';
          dot.setAttribute('aria-selected', 'false');
        }
      });
    }
  }

  function getScrollStep() {
    const cardWidth = cards[0].offsetWidth;
    const gap = 24;
    return cardWidth + gap;
  }

  prevBtn?.addEventListener('click', () => {
    track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
  });

  if (dotsContainer) {
    dotsContainer.querySelectorAll('.dot-btn').forEach(dot => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        const targetCard = cards[index];
        if (targetCard) {
          const targetLeft = targetCard.offsetLeft - track.offsetLeft;
          track.scrollTo({ left: targetLeft, behavior: 'smooth' });
        }
      });
    });
  }

  track.addEventListener('scroll', updateCarouselState, { passive: true });
  window.addEventListener('resize', updateCarouselState, { passive: true });
  updateCarouselState();

  // ── MODAL LOGIC ──
  const modal = document.getElementById('testimonial-modal');
  const modalContainer = document.getElementById('modal-card');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('modal-close-btn');
  const modalClientName = document.getElementById('modal-client-name');
  const modalProjectDate = document.getElementById('modal-project-date');
  const modalTextContent = document.getElementById('modal-text-content');

  let activeTrigger = null;

  function openModal(index, triggerEl) {
    const data = testimonials[index];
    if (!data || !modal || !modalClientName || !modalProjectDate || !modalTextContent) return;

    activeTrigger = triggerEl || null;

    modalClientName.textContent = data.client || 'Client';
    modalProjectDate.textContent = data.project || data.date || '';

    // Render paragraphs
    modalTextContent.innerHTML = data.text.map(p => `<p style="color:rgba(255,255,255,0.9);">${p}</p>`).join('');

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    // Animate entrance
    requestAnimationFrame(() => {
      if (modalContainer) {
        modalContainer.classList.remove('scale-95', 'opacity-0');
        modalContainer.classList.add('scale-100', 'opacity-100');
      }
      closeBtn?.focus();
    });
  }

  function closeModal() {
    if (!modal) return;
    if (modalContainer) {
      modalContainer.classList.remove('scale-100', 'opacity-100');
      modalContainer.classList.add('scale-95', 'opacity-0');
    }
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      if (activeTrigger) {
        activeTrigger.focus();
        activeTrigger = null;
      }
    }, 200);
  }

  document.querySelectorAll('[data-read-more]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const index = parseInt(btn.getAttribute('data-read-more') || '0', 10);
      openModal(index, btn);
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
})();
</script>
