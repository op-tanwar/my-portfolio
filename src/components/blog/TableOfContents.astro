---
import type { TocHeading } from "../../lib/blog";

interface Props {
  headings: TocHeading[];
  accent?: string;
}

const { headings } = Astro.props;
const hasHeadings = headings.length > 0;
---

{hasHeadings && (
  <nav class="toc-nav text-xs" aria-label="Table of contents">
    <div class="flex items-center gap-2 mb-4 pb-2 border-b border-white/[0.06]">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-300">
        Table of Contents
      </span>
    </div>

    <ul class="flex flex-col gap-1 max-h-[calc(100vh-22rem)] overflow-y-auto pr-2 scrollbar-thin">
      {headings.map((heading) => (
        <li class:list={[heading.level === 3 ? "pl-3.5" : "pl-0"]}>
          <a
            href={`#${heading.id}`}
            class="toc-link block py-1.5 px-2.5 rounded-lg text-xs leading-snug text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all no-underline border-l border-transparent"
            data-toc-link={heading.id}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function setupTocHighlight() {
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    if (!links.length) return;

    const headings = Array.from(links)
      .map((link) => {
        const id = link.getAttribute("data-toc-link");
        return {
          id,
          el: id ? document.getElementById(id) : null,
          link,
        };
      })
      .filter((h) => h.el !== null);

    if (!headings.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((l) => {
              l.classList.remove(
                "text-emerald-400",
                "bg-emerald-500/10",
                "border-emerald-400",
                "font-semibold"
              );
              l.classList.add("text-zinc-400", "border-transparent");
            });

            const match = headings.find((h) => h.el === entry.target);
            if (match) {
              match.link.classList.remove("text-zinc-400", "border-transparent");
              match.link.classList.add(
                "text-emerald-400",
                "bg-emerald-500/10",
                "border-emerald-400",
                "font-semibold"
              );
            }
          }
        });
      },
      { rootMargin: "-80px 0px -65% 0px", threshold: 0 }
    );

    headings.forEach((h) => h.el && observer.observe(h.el));
  }

  setupTocHighlight();
  document.addEventListener("astro:page-load", setupTocHighlight);
</script>
