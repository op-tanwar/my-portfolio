---
import { slugify } from "../../lib/blog";

interface Props {
  categories: string[];
  tags: string[];
  activeCategory?: string;
  activeTag?: string;
}

const { categories, tags, activeCategory, activeTag } = Astro.props;

// Top priority categories for high-intent visitors
const priorityCategories = [
  "Astro",
  "Next.js",
  "React",
  "E-Commerce",
  "Performance",
  "Architecture",
  "SEO",
];

// Combine unique categories, keeping priority ones first
const sortedCategories = [
  ...priorityCategories.filter((c) => categories.some((cat) => cat.toLowerCase() === c.toLowerCase())),
  ...categories.filter((c) => !priorityCategories.some((p) => p.toLowerCase() === c.toLowerCase())),
];
---

<div class="mb-10 sm:mb-12">
  <!-- Categories Filter Row -->
  <div class="flex items-center gap-2 overflow-x-auto pb-3 scrollbar-none" role="navigation" aria-label="Blog categories">
    <a
      href="/blog"
      class:list={[
        "px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all duration-200 border",
        !activeCategory && !activeTag
          ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-400 font-semibold shadow-[0_0_15px_rgba(16,185,129,0.15)]"
          : "bg-[#111114]/80 border-white/[0.08] text-zinc-400 hover:text-white hover:border-white/[0.16]",
      ]}
    >
      All Articles
    </a>

    {
      sortedCategories.map((category) => {
        const catSlug = slugify(category);
        const isActive = activeCategory === catSlug;
        return (
          <a
            href={`/blog/category/${catSlug}`}
            class:list={[
              "px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all duration-200 border",
              isActive
                ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-400 font-semibold shadow-[0_0_15px_rgba(16,185,129,0.15)]"
                : "bg-[#111114]/80 border-white/[0.08] text-zinc-400 hover:text-white hover:border-white/[0.16]",
            ]}
            aria-current={isActive ? "page" : undefined}
          >
            {category}
          </a>
        );
      })
    }
  </div>

  <!-- Active Filter Indicator if Tag or Category selected -->
  {(activeCategory || activeTag) && (
    <div class="flex items-center gap-2 mt-3 pt-3 border-t border-white/[0.06] text-xs font-mono text-zinc-400">
      <span>Filtered by:</span>
      <span class="px-2.5 py-0.5 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-medium">
        {activeCategory ? `Category: ${activeCategory}` : `Tag: #${activeTag}`}
      </span>
      <a href="/blog" class="text-zinc-500 hover:text-zinc-300 ml-2 underline text-[11px]">
        Reset filter
      </a>
    </div>
  )}
</div>
