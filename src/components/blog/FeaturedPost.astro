---
import { formatDate, getPostReadingTime, type BlogPost } from "../../lib/blog";

interface Props {
  post: BlogPost;
  accent: string;
}
import { Image } from "astro:assets";
const { post, accent } = Astro.props;
const readTime = getPostReadingTime(post);
---

<a
  href={`/blog/${post.id}`}
  class="featured-post group relative grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10 p-6 sm:p-8 transition-all duration-300 hover:-translate-y-1 no-underline"
  style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 16px) 0,100% 16px,100% 100%,16px 100%,0 calc(100% - 16px));"
  aria-label={`Featured article: ${post.data.title}`}
>
  <div
    class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style={`background:linear-gradient(90deg,transparent,${accent},transparent);`}
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style={`background:radial-gradient(ellipse at 30% 0%,${accent}08 0%,transparent 65%);`}
    aria-hidden="true"
  >
  </div>

  {
    post.data.image && (
      <div
        class="relative overflow-hidden h-48 sm:h-56 lg:h-full min-h-[200px]"
        style="clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));"
      >
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          width={800}
          height={450}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 pointer-events-none"
          style="background:linear-gradient(180deg,transparent 40%,rgba(2,2,4,0.5) 100%);"
          aria-hidden="true"
        />
      </div>
    )
  }

  <div class="flex flex-col justify-center gap-4">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class="text-[8px] font-mono font-bold tracking-[0.25em] uppercase px-2 py-1"
        style={`color:${accent};background:${accent}12;border:1px solid ${accent}33;clip-path:polygon(0 0,calc(100% - 4px) 0,100% 4px,100% 100%,4px 100%,0 calc(100% - 4px));`}
      >
        Featured
      </span>
      <span
        class="text-[8px] font-mono font-bold tracking-widest uppercase px-2 py-0.5"
        style={`color:${accent}88;border:1px solid ${accent}1a;background:${accent}08;`}
      >
        {post.data.category}
      </span>
      <span class="text-[8px] font-mono" style="color:rgba(255,255,255,0.2);">
        {readTime}
      </span>
    </div>

    <h2
      class="text-xl sm:text-2xl lg:text-3xl font-black font-mono leading-tight"
      style="color:rgba(255,255,255,0.92);"
    >
      {post.data.title}
    </h2>

    <p
      class="text-xs sm:text-sm font-mono leading-relaxed"
      style="color:rgba(255,255,255,0.38);"
    >
      {post.data.description}
    </p>

    <div class="flex flex-wrap gap-1.5">
      {
        post.data.tags.map((tag) => (
          <span
            class="text-[7px] sm:text-[8px] font-mono font-bold tracking-widest uppercase px-1.5 py-0.5"
            style={`color:${accent}88;border:1px solid ${accent}1a;background:${accent}08;`}
          >
            {tag}
          </span>
        ))
      }
    </div>

    <div
      class="flex items-center justify-between pt-3 border-t"
      style="border-color:rgba(255,255,255,0.06);"
    >
      <time
        datetime={post.data.publishDate.toISOString()}
        class="text-[9px] font-mono"
        style="color:rgba(255,255,255,0.25);"
      >
        {formatDate(post.data.publishDate)}
      </time>
      <span
        class="text-[10px] font-mono font-bold flex items-center gap-1.5 transition-all duration-200 group-hover:gap-2"
        style={`color:${accent};`}
      >
        Read article
        <svg
          class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .featured-post:hover {
    background: rgba(255, 255, 255, 0.035) !important;
    box-shadow: 0 0 40px rgba(0, 255, 247, 0.06);
  }
</style>
