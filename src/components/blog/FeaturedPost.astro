---
import { formatDate, getPostReadingTime, type BlogPost } from "../../lib/blog";
import { Image } from "astro:assets";

interface Props {
  post: BlogPost;
  accent?: string;
}

const { post, accent = "#10B981" } = Astro.props;
const readTime = getPostReadingTime(post);
---

<a
  href={`/blog/${post.id}`}
  class="group relative grid grid-cols-1 lg:grid-cols-12 gap-8 p-6 sm:p-8 lg:p-10 rounded-3xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.6)] no-underline overflow-hidden items-center"
  aria-label={`Featured article: ${post.data.title}`}
>
  <!-- Ambient Glow -->
  <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Left Column: Visual / Diagram / Cover Image (5 cols) -->
  <div class="lg:col-span-5 relative rounded-2xl overflow-hidden aspect-[16/10] bg-zinc-950/80 border border-white/[0.06] group-hover:border-white/[0.12] transition-colors">
    {
      post.data.image ? (
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          width={800}
          height={500}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center p-8 bg-gradient-to-br from-zinc-900 to-zinc-950 text-center">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <span class="text-xs font-mono text-zinc-400">Architecture Guide</span>
        </div>
      )
    }
    <div
      class="absolute inset-0 pointer-events-none bg-gradient-to-t from-[#111114]/80 via-transparent to-transparent opacity-60"
      aria-hidden="true"
    />
  </div>

  <!-- Right Column: Content & Metadata (7 cols) -->
  <div class="lg:col-span-7 flex flex-col justify-between">
    <div>
      <!-- Badges row -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Featured Architecture Guide
        </span>
        <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-zinc-300">
          {post.data.category}
        </span>
        <span class="text-xs font-mono text-zinc-500">
          {readTime}
        </span>
      </div>

      <!-- Title -->
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-[-0.03em] leading-tight mb-4 group-hover:text-emerald-300 transition-colors">
        {post.data.title}
      </h2>

      <!-- Description -->
      <p class="text-sm sm:text-base text-zinc-400 leading-relaxed mb-6">
        {post.data.description}
      </p>
    </div>

    <!-- Bottom Action Row -->
    <div class="pt-6 border-t border-white/[0.06] flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-3 text-xs text-zinc-400 font-mono">
        <time datetime={post.data.publishDate.toISOString()}>
          {formatDate(post.data.publishDate)}
        </time>
        <span>·</span>
        <span>By Omprakash Tanwar</span>
      </div>

      <div class="inline-flex items-center gap-2 text-xs font-semibold text-zinc-950 bg-white group-hover:bg-zinc-200 px-5 py-2.5 rounded-xl transition-all shadow-[0_0_20px_rgba(255,255,255,0.12)]">
        <span>Read Flagship Guide</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </div>
    </div>
  </div>
</a>
