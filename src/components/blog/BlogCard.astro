---
import { formatDate, getPostReadingTime, type BlogPost } from "../../lib/blog";

interface Props {
  post: BlogPost;
  index: number;
  accent: string;
  observe?: boolean;
}
import { Image } from "astro:assets";
const { post, index, accent, observe = true } = Astro.props;
const readTime = getPostReadingTime(post);
const postId = String(index + 1).padStart(2, "0");
// animation-play-state:running
---

<a
  href={`/blog/${post.id}`}
  class="blog-card group relative flex flex-col gap-4 p-5 sm:p-6 transition-all duration-300 hover:-translate-y-1.5 cursor-pointer no-underline"
  style={`background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.07);clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));animation:cardReveal .55s cubic-bezier(.16,1,.3,1) both;animation-delay:${index * 0.1 + 0.05}s;animation-play-state:running;`}
  data-blog-card={observe ? "" : undefined}
  aria-label={`Read article: ${post.data.title}`}
>
  <div
    class="absolute top-0 left-0 right-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style={`background:linear-gradient(90deg,transparent,${accent},transparent);`}
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
    style={`background:radial-gradient(ellipse at 50% 0%,${accent}08 0%,transparent 65%);`}
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
    style={`box-shadow:inset 0 0 0 1px ${accent}25;clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));`}
    aria-hidden="true"
  >
  </div>

  {
    post.data.image && (
      <div
        class="relative -mx-1 -mt-1 mb-1 overflow-hidden"
        style="clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));"
      >
        <Image
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          width={640}
          height={360}
          loading="lazy"
          decoding="async"
          class="w-full h-36 sm:h-40 object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 pointer-events-none"
          style="background:linear-gradient(180deg,transparent 50%,rgba(2,2,4,0.6) 100%);"
          aria-hidden="true"
        />
      </div>
    )
  }

  <div class="flex items-center justify-between">
    <span class="text-[9px] font-mono" style={`color:${accent};opacity:0.4;`}>
      {postId}
    </span>
    <span
      class="text-[8px] sm:text-[9px] font-mono px-2 py-0.5"
      style={`color:${accent};background:${accent}0f;border:1px solid ${accent}22;clip-path:polygon(0 0,calc(100% - 3px) 0,100% 3px,100% 100%,3px 100%,0 calc(100% - 3px));`}
    >
      {readTime}
    </span>
  </div>

  <span
    class="text-[8px] font-mono font-bold tracking-widest uppercase w-fit px-2 py-0.5"
    style={`color:${accent}88;border:1px solid ${accent}1a;background:${accent}08;`}
  >
    {post.data.category}
  </span>

  <h2
    class="text-sm sm:text-base font-black font-mono leading-snug"
    style="color:rgba(255,255,255,0.88);"
  >
    {post.data.title}
  </h2>

  <p
    class="text-[10px] sm:text-[11px] font-mono leading-relaxed flex-1"
    style="color:rgba(255,255,255,0.35);"
  >
    {post.data.description}
  </p>

  <div
    class="flex flex-col gap-2 pt-2 border-t"
    style="border-color:rgba(255,255,255,0.06);"
  >
    <div class="flex flex-wrap gap-1.5">
      {
        post.data.tags.slice(0, 3).map((tag) => (
          <span
            class="text-[7px] sm:text-[8px] font-mono font-bold tracking-widest uppercase px-1.5 py-0.5"
            style={`color:${accent}88;border:1px solid ${accent}1a;background:${accent}08;`}
          >
            {tag}
          </span>
        ))
      }
    </div>
    <div class="flex items-center justify-between">
      <time
        datetime={post.data.publishDate.toISOString()}
        class="text-[8px] sm:text-[9px] font-mono"
        style="color:rgba(255,255,255,0.2);"
      >
        {formatDate(post.data.publishDate)}
      </time>
      <span
        class="text-[9px] font-mono font-bold opacity-0 group-hover:opacity-100 transition-all duration-200 flex items-center gap-1"
        style={`color:${accent};`}
      >
        Read
        <svg
          class="w-3 h-3 group-hover:translate-x-0.5 transition-transform duration-200"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  .blog-card:hover {
    background: rgba(255, 255, 255, 0.035) !important;
  }
  @keyframes cardReveal {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
