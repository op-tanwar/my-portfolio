---
import { formatDate, getPostReadingTime, type BlogPost } from "../../lib/blog";
import { Image } from "astro:assets";

interface Props {
  post: BlogPost;
  index: number;
  accent?: string;
  observe?: boolean;
}

const { post, index, accent = "#10B981", observe = true } = Astro.props;
const readTime = getPostReadingTime(post);
---

<a
  href={`/blog/${post.id}`}
  class="group relative flex flex-col justify-between p-6 rounded-2xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all duration-300 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)] no-underline overflow-hidden"
  data-blog-card={observe ? "" : undefined}
  aria-label={`Read article: ${post.data.title}`}
>
  <div>
    <!-- Optional Post Thumbnail -->
    {
      post.data.image && (
        <div class="relative -mx-2 -mt-2 mb-5 rounded-xl overflow-hidden aspect-[16/9] bg-zinc-950/60 border border-white/[0.06]">
          <Image
            src={post.data.image}
            alt={post.data.imageAlt || post.data.title}
            width={640}
            height={360}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div
            class="absolute inset-0 pointer-events-none bg-gradient-to-t from-[#111114] via-transparent to-transparent opacity-60"
            aria-hidden="true"
          />
        </div>
      )
    }

    <!-- Meta row: Category + Reading Time -->
    <div class="flex items-center justify-between gap-2 mb-3.5">
      <span class="text-[11px] font-mono font-medium px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
        {post.data.category}
      </span>
      <span class="text-xs font-mono text-zinc-500">
        {readTime}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-lg font-bold text-white tracking-tight leading-snug mb-2.5 group-hover:text-emerald-300 transition-colors">
      {post.data.title}
    </h3>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed line-clamp-3 mb-6">
      {post.data.description}
    </p>
  </div>

  <div>
    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4 pt-4 border-t border-white/[0.06]">
        {post.data.tags.slice(0, 3).map((tag) => (
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.03] text-zinc-400 border border-white/[0.06]">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Footer: Date + Read Link -->
    <div class="flex items-center justify-between pt-3 border-t border-white/[0.04] text-xs">
      <time datetime={post.data.publishDate.toISOString()} class="font-mono text-zinc-500 text-[11px]">
        {formatDate(post.data.publishDate)}
      </time>
      <span class="font-medium text-zinc-300 group-hover:text-emerald-400 transition-colors flex items-center gap-1.5">
        <span>Read Article</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </div>
  </div>
</a>
