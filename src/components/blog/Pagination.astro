---
interface Props {
  basePath: string;
  currentPage: number;
  totalPages: number;
  hasPrev: boolean;
  hasNext: boolean;
  prevPage: number | null;
  nextPage: number | null;
}

const { basePath, currentPage, totalPages, hasPrev, hasNext, prevPage, nextPage } = Astro.props;

function pageHref(page: number) {
  if (page === 1) return basePath;
  return `${basePath}/page/${page}`;
}
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-2 mt-16 sm:mt-20" aria-label="Blog pagination">
    {hasPrev && prevPage ? (
      <a
        href={pageHref(prevPage)}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-mono font-medium text-zinc-300 bg-[#111114] border border-white/[0.08] hover:border-white/[0.18] hover:text-white transition-all"
        aria-label="Previous page"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>Prev</span>
      </a>
    ) : (
      <span
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-mono text-zinc-600 bg-white/[0.02] border border-white/[0.04] cursor-not-allowed"
        aria-hidden="true"
      >
        <span>Prev</span>
      </span>
    )}

    <div class="flex items-center gap-1.5 mx-2" role="list">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <a
          href={pageHref(page)}
          class:list={[
            "w-9 h-9 rounded-xl flex items-center justify-center text-xs font-mono font-medium transition-all no-underline",
            page === currentPage
              ? "bg-white text-zinc-950 font-bold shadow-[0_0_15px_rgba(255,255,255,0.2)]"
              : "text-zinc-400 bg-[#111114] border border-white/[0.08] hover:border-white/[0.18] hover:text-white",
          ]}
          aria-label={`Page ${page}`}
          aria-current={page === currentPage ? "page" : undefined}
          role="listitem"
        >
          {page}
        </a>
      ))}
    </div>

    {hasNext && nextPage ? (
      <a
        href={pageHref(nextPage)}
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-mono font-medium text-zinc-300 bg-[#111114] border border-white/[0.08] hover:border-white/[0.18] hover:text-white transition-all"
        aria-label="Next page"
      >
        <span>Next</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    ) : (
      <span
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-mono text-zinc-600 bg-white/[0.02] border border-white/[0.04] cursor-not-allowed"
        aria-hidden="true"
      >
        <span>Next</span>
      </span>
    )}
  </nav>
)}
