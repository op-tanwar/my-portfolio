---
interface Props {
  id?: string;
  class?: string;
  paddingTop?: boolean;
}

const { id, class: className = "", paddingTop = false } = Astro.props;
---

<section
  id={id}
  class:list={["cyber-section relative py-20 sm:py-28 overflow-hidden", paddingTop && "pt-32 sm:pt-36", className]}
  style="background:#020204;"
>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,255,247,0.005) 3px,rgba(0,255,247,0.005) 4px);"
    aria-hidden="true"
  ></div>

  <div
    class="absolute top-0 left-0 right-0 h-px"
    style="background:linear-gradient(90deg,transparent,rgba(0,255,247,0.2),rgba(191,0,255,0.15),transparent);"
    aria-hidden="true"
  ></div>

  <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse at 15% 30%,rgba(0,255,247,0.03) 0%,transparent 50%),radial-gradient(ellipse at 85% 70%,rgba(191,0,255,0.03) 0%,transparent 50%);" aria-hidden="true"></div>

  <div class="absolute top-8 left-4 sm:left-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px" style="background:linear-gradient(90deg,#00fff7,transparent);"></div>
    <div class="w-px h-10 sm:h-12" style="background:linear-gradient(180deg,#00fff7,transparent);"></div>
    <div class="absolute top-0 left-0 w-1.5 h-1.5 rounded-full" style="background:#00fff7;box-shadow:0 0 8px #00fff7;"></div>
  </div>

  <div class="absolute bottom-8 right-4 sm:right-6 pointer-events-none" aria-hidden="true">
    <div class="w-10 sm:w-12 h-px ml-auto" style="background:linear-gradient(270deg,#bf00ff,transparent);"></div>
    <div class="w-px h-10 sm:h-12 ml-auto" style="background:linear-gradient(0deg,#bf00ff,transparent);"></div>
    <div class="absolute bottom-0 right-0 w-1.5 h-1.5 rounded-full" style="background:#bf00ff;box-shadow:0 0 8px #bf00ff;"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-16">
    <slot />
  </div>

  <div
    class="absolute bottom-0 left-0 right-0 h-px"
    style="background:linear-gradient(90deg,transparent,rgba(191,0,255,0.2),rgba(0,255,247,0.15),transparent);"
    aria-hidden="true"
  ></div>
</section>
