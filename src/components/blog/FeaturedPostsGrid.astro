---
import FeaturedPost from "./FeaturedPost.astro";
import { type BlogPost } from "../../lib/blog";

interface Props {
  posts: BlogPost[];
  allPosts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="mb-12 sm:mb-16">
  {
    posts.slice(0, 1).map((post) => (
      <FeaturedPost post={post} />
    ))
  }
</div>
