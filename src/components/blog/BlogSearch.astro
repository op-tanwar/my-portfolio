---
import type { BlogPost } from "../../lib/blog";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

const searchIndex = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags.join(" "),
}));
---

<div class="blog-search relative w-full">
  <label for="blog-search-input" class="sr-only">Search technical articles</label>
  <div class="relative">
    <svg
      class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input
      type="search"
      id="blog-search-input"
      placeholder="Search articles on Astro, Next.js, CWV, commerce..."
      autocomplete="off"
      class="w-full pl-11 pr-4 py-3 text-sm text-white placeholder-zinc-500 bg-[#111114]/90 border border-white/[0.08] focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 rounded-xl outline-none transition-all"
    />
  </div>

  <div
    id="blog-search-results"
    class="hidden absolute top-full left-0 right-0 mt-2 z-50 max-h-80 overflow-y-auto rounded-2xl bg-[#111114]/95 border border-white/[0.12] backdrop-blur-xl shadow-2xl divide-y divide-white/[0.06]"
    role="listbox"
    aria-label="Search results"
  ></div>
</div>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById("blog-search-input");
  const results = document.getElementById("blog-search-results");

  function renderResults(matches) {
    if (!results) return;
    if (!matches.length) {
      results.innerHTML = `<p class="p-4 text-xs font-mono text-zinc-500 text-center">No articles found matching query.</p>`;
      results.classList.remove("hidden");
      return;
    }

    results.innerHTML = matches
      .slice(0, 8)
      .map(
        (item) => `
        <a href="/blog/${item.slug}" class="block p-4 transition-colors hover:bg-white/[0.04] no-underline" role="option">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">${item.category}</span>
          </div>
          <p class="text-sm font-bold text-white mb-0.5">${item.title}</p>
          <p class="text-xs text-zinc-400 line-clamp-1">${item.description}</p>
        </a>
      `,
      )
      .join("");
    results.classList.remove("hidden");
  }

  input?.addEventListener("input", (e) => {
    const query = e.target.value.trim().toLowerCase();
    if (!query) {
      results?.classList.add("hidden");
      return;
    }

    const matches = searchIndex.filter(
      (item) =>
        item.title.toLowerCase().includes(query) ||
        item.description.toLowerCase().includes(query) ||
        item.category.toLowerCase().includes(query) ||
        item.tags.toLowerCase().includes(query),
    );

    renderResults(matches);
  });

  document.addEventListener("click", (e) => {
    if (!e.target.closest(".blog-search")) {
      results?.classList.add("hidden");
    }
  });
</script>
