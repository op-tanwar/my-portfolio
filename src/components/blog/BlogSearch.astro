---
import type { BlogPost } from "../../lib/blog";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

const searchIndex = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  description: post.data.description,
  category: post.data.category,
  tags: post.data.tags.join(" "),
}));
---

<div class="blog-search relative">
  <label for="blog-search-input" class="sr-only">Search articles</label>
  <div class="relative">
    <svg
      class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none"
      style="color:rgba(0,255,247,0.4);"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <input
      type="search"
      id="blog-search-input"
      placeholder="Search articles..."
      autocomplete="off"
      class="w-full pl-11 pr-4 py-3 text-xs font-mono tracking-wide outline-none transition-all duration-200"
      style="color:rgba(255,255,255,0.75);background:rgba(255,255,255,0.02);border:1px solid rgba(0,255,247,0.15);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));"
    />
  </div>

  <div
    id="blog-search-results"
    class="hidden absolute top-full left-0 right-0 mt-2 z-50 max-h-80 overflow-y-auto"
    style="background:rgba(2,2,4,0.97);border:1px solid rgba(0,255,247,0.15);backdrop-filter:blur(14px);clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px));"
    role="listbox"
    aria-label="Search results"
  ></div>
</div>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById("blog-search-input");
  const results = document.getElementById("blog-search-results");

  function renderResults(matches) {
    if (!results) return;
    if (!matches.length) {
      results.innerHTML = `<p class="p-4 text-[10px] font-mono" style="color:rgba(255,255,255,0.3);">No articles found.</p>`;
      results.classList.remove("hidden");
      return;
    }

    results.innerHTML = matches
      .slice(0, 8)
      .map(
        (item) => `
        <a href="/blog/${item.slug}" class="block px-4 py-3 transition-colors duration-200 hover:bg-white/[0.03] no-underline border-b" style="border-color:rgba(255,255,255,0.05);" role="option">
          <p class="text-xs font-mono font-bold mb-1" style="color:rgba(255,255,255,0.85);">${item.title}</p>
          <p class="text-[9px] font-mono line-clamp-1" style="color:rgba(255,255,255,0.3);">${item.description}</p>
        </a>
      `,
      )
      .join("");
    results.classList.remove("hidden");
  }

  input?.addEventListener("input", (e) => {
    const query = e.target.value.trim().toLowerCase();
    if (!query) {
      results?.classList.add("hidden");
      return;
    }

    const matches = searchIndex.filter((item) => {
      const haystack = `${item.title} ${item.description} ${item.category} ${item.tags}`.toLowerCase();
      return haystack.includes(query);
    });

    renderResults(matches);
  });

  document.addEventListener("click", (e) => {
    if (!e.target.closest(".blog-search")) {
      results?.classList.add("hidden");
    }
  });

  input?.addEventListener("focus", () => {
    if (input.value.trim()) {
      input.dispatchEvent(new Event("input"));
    }
  });
</script>

<style>
  #blog-search-input:focus {
    border-color: rgba(0, 255, 247, 0.35) !important;
    box-shadow: 0 0 20px rgba(0, 255, 247, 0.08);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
