---
import { type BlogPost } from "../../lib/blog";

interface Props {
  prev: BlogPost | null;
  next: BlogPost | null;
  accent?: string;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav
    class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-12 sm:mt-16 pt-8 border-t border-white/[0.08]"
    aria-label="Article navigation"
  >
    {prev ? (
      <a
        href={`/blog/${prev.id}`}
        class="group p-5 rounded-2xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all no-underline flex flex-col justify-between"
        rel="prev"
      >
        <div class="flex items-center gap-1.5 text-xs font-mono text-zinc-500 mb-2">
          <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Previous Article</span>
        </div>
        <p class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors line-clamp-2 leading-snug">
          {prev.data.title}
        </p>
      </a>
    ) : (
      <div aria-hidden="true"></div>
    )}

    {next ? (
      <a
        href={`/blog/${next.id}`}
        class="group p-5 rounded-2xl bg-[#111114]/90 border border-white/[0.08] hover:border-white/[0.18] transition-all no-underline flex flex-col justify-between text-right sm:col-start-2"
        rel="next"
      >
        <div class="flex items-center justify-end gap-1.5 text-xs font-mono text-zinc-500 mb-2">
          <span>Next Article</span>
          <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
        <p class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors line-clamp-2 leading-snug">
          {next.data.title}
        </p>
      </a>
    ) : (
      <div aria-hidden="true"></div>
    )}
  </nav>
)}
