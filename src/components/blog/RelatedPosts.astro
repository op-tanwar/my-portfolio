---
import BlogCard from "./BlogCard.astro";
import { type BlogPost } from "../../lib/blog";

interface Props {
  posts: BlogPost[];
  allPosts: BlogPost[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <div class="related-posts mt-20 pt-16 border-t border-white/[0.08]">
    <div class="flex items-center gap-2 mb-3">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      <span class="text-xs font-mono uppercase tracking-wider text-emerald-400">
        Related Architecture Guides
      </span>
    </div>

    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-[-0.03em] mb-8">
      Continue reading
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post, i) => (
        <BlogCard post={post} index={i} observe={false} />
      ))}
    </div>
  </div>
)}
