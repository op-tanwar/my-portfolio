<div
  id="reading-progress"
  class="reading-progress fixed top-0 left-0 right-0 z-[60] h-[2px] origin-left scale-x-0"
  style="background:linear-gradient(90deg,#00fff7,#bf00ff,#ff006e);"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Reading progress"
></div>

<script>
  const bar = document.getElementById("reading-progress");
  const article = document.querySelector("[data-article-content]");

  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = rect.height;
      const scrolled = window.scrollY - articleTop;
      const progress = Math.min(100, Math.max(0, (scrolled / (articleHeight - window.innerHeight)) * 100));

      bar.style.transform = `scaleX(${progress / 100})`;
      bar.setAttribute("aria-valuenow", String(Math.round(progress)));
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>

<style>
  .reading-progress {
    transition: transform 0.1s linear;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress {
      display: none;
    }
  }
</style>
