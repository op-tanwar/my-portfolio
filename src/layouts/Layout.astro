---
// Layout.astro - CYBERPUNK PORTFOLIO LAYOUT

import "../styles/global.css";

import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
import CustomCursor from "../components/common/CustomCursor.astro";

import { getSiteUrl, TWITTER_HANDLE } from "../lib/site";
import {
  AUTHOR_NAME,
  DEFAULT_OG_IMAGE,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  SITE_NAME,
  absoluteImageUrl,
  buildOrganizationSchema,
  buildPersonSchema,
  buildWebSiteSchema,
} from "../lib/seo";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** When true (default), merge Person/Organization/WebSite base schemas with page jsonLd */
  includeBaseSchemas?: boolean;
  prevUrl?: string;
  nextUrl?: string;
}

const siteUrl = getSiteUrl(Astro.site);

const {
  title = "Frontend Developer | Hire React, Next.js & Astro Expert | Omprakash Tanwar",
  description = "Hire Omprakash Tanwar — Frontend Developer specializing in React, Next.js, Astro, TypeScript, and Tailwind CSS. High-performance, SEO-optimized websites for US, UK, EU, Canada & Australia clients.",
  canonical,
  ogType = "website",
  ogImage = absoluteImageUrl(DEFAULT_OG_IMAGE, siteUrl),
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  jsonLd,
  includeBaseSchemas = true,
  prevUrl,
  nextUrl,
} = Astro.props;

const canonicalUrl = canonical || `${siteUrl}/`;
const robotsContent = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const resolvedOgImage = absoluteImageUrl(ogImage, siteUrl);
const ogImageType = resolvedOgImage.includes(".svg")
  ? "image/svg+xml"
  : resolvedOgImage.includes(".webp")
    ? "image/webp"
    : resolvedOgImage.includes(".jpg") || resolvedOgImage.includes(".jpeg")
      ? "image/jpeg"
      : "image/png";

const baseSchemas = includeBaseSchemas
  ? [
      buildPersonSchema(siteUrl),
      buildOrganizationSchema(siteUrl),
      buildWebSiteSchema(siteUrl),
    ]
  : [];

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const structuredData =
  pageSchemas.length > 0
    ? includeBaseSchemas
      ? [...baseSchemas, ...pageSchemas]
      : pageSchemas
    : baseSchemas.length > 0
      ? baseSchemas
      : [buildPersonSchema(siteUrl)];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="google-site-verification"
      content="BvhspkTjlLomtVx352jX7jaNc33hgCYSlca74BcNCKA"
    />
    <!-- Google Search Favicon Guidelines Optimization -->
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="author" content={AUTHOR_NAME} />
    <meta name="creator" content={AUTHOR_NAME} />
    <link rel="author" href={`${siteUrl}/#person`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020204" />

    {tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}

    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:locale:alternate" content="en_CA" />
    <meta property="og:locale:alternate" content="en_AU" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />

    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}

    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      ogType === "article" && (
        <meta property="article:author" content={AUTHOR_NAME} />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${AUTHOR_NAME} Blog`}
      href={`${siteUrl}/rss.xml`}
    />

    {
      structuredData.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>

  <body>
    <CustomCursor />

    <Navbar />

    <main id="site-main">
      <slot />
    </main>

    <Footer />

    <Analytics />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }

  ::selection {
    background: rgba(0, 255, 247, 0.2);
    color: #00fff7;
  }

  ::-webkit-scrollbar {
    width: 4px;
  }

  ::-webkit-scrollbar-track {
    background: #020204;
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #00fff7, #bf00ff);
    border-radius: 2px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #00fff7;
  }

  :focus-visible {
    outline: 1.5px solid rgba(0, 255, 247, 0.6);
    outline-offset: 3px;
  }

  main {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
